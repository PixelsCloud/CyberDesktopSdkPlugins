@PACKAGE_INIT@
if(MSVC AND CMAKE_CL_SHOWINCLUDES_PREFIX MATCHES "娉ㄦ剰")
  set(CMAKE_CL_SHOWINCLUDES_PREFIX "注意: 包含文件:  ")
endif()
if(NOT TARGET CyberCanvas::Yoga)
  add_library(CyberCanvas::Yoga STATIC IMPORTED)
  set_target_properties(CyberCanvas::Yoga PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cybercanvas-yoga.lib"
    IMPORTED_LINK_INTERFACE_LANGUAGES "CXX")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CyberCanvasTargets.cmake")
if(@CYBERCANVAS_BUILD_FLUID@ AND NOT TARGET CyberCanvas::FluidBackend)
  add_library(CyberCanvas::FluidBackend STATIC IMPORTED)
  set_target_properties(CyberCanvas::FluidBackend PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cybercanvas-fluid-backend.lib"
    IMPORTED_LINK_INTERFACE_LANGUAGES "C")
endif()
if(@CYBERCANVAS_BUILD_VECTOR@ AND NOT TARGET CyberCanvas::ThorVG)
  add_library(CyberCanvas::ThorVG STATIC IMPORTED)
  set_target_properties(CyberCanvas::ThorVG PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cybercanvas-thorvg.lib"
    IMPORTED_LINK_INTERFACE_LANGUAGES "CXX")
endif()
if(@CYBERCANVAS_BUILD_PHYSICS@ AND NOT TARGET CyberCanvas::Box2D)
  add_library(CyberCanvas::Box2D STATIC IMPORTED)
  set_target_properties(CyberCanvas::Box2D PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cybercanvas-box2d.lib"
    IMPORTED_LINK_INTERFACE_LANGUAGES "C")
endif()
foreach(component IN LISTS CyberCanvas_FIND_COMPONENTS)
  if(TARGET CyberCanvas::${component})
    set(CyberCanvas_${component}_FOUND TRUE)
  else()
    set(CyberCanvas_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(CyberCanvas)
