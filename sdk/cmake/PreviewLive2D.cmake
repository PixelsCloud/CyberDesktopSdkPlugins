option(CD_SDK_PREVIEW_LIVE2D "Build the public Live2D preview adapter and isolated worker" OFF)
if(NOT CD_SDK_PREVIEW_LIVE2D)
    return()
endif()
find_package(Qt6 6.8 REQUIRED COMPONENTS Core Gui Network)
if(NOT TARGET cd_live2d_session)
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../runtime/live2d" "${CMAKE_CURRENT_BINARY_DIR}/live2d")
    set(CD_SDK_OWNS_PREVIEW_WORKER TRUE)
endif()
if(NOT TARGET CyberDesktop::CharacterResources)
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../libraries/character-resources" "${CMAKE_CURRENT_BINARY_DIR}/character-resources")
endif()
include("${CMAKE_CURRENT_SOURCE_DIR}/../libraries/character-protocol/Configuration.cmake")
add_executable(cd_sdk_image_worker tools/PreviewAssetWorker.cpp)
set_target_properties(cd_sdk_image_worker PROPERTIES OUTPUT_NAME cd-sdk-image-worker)
target_link_libraries(cd_sdk_image_worker PRIVATE CyberDesktop::CharacterProtocol CyberDesktop::CharacterResources cd_character_chat_configuration Qt6::Gui)
target_compile_options(cd_sdk_image_worker PRIVATE /utf-8 /W4)
install(TARGETS cd_sdk_image_worker RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
target_sources(cd_sdk_tool_support PRIVATE tools/PreviewLive2D.cpp tools/PreviewEvents.cpp tools/PreviewAssets.cpp tools/PreviewChat.cpp)
target_include_directories(cd_sdk_tool_support PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/..")
target_compile_definitions(cd_sdk_tool_support PRIVATE CD_SDK_PREVIEW_LIVE2D)
target_link_libraries(cd_sdk_tool_support PRIVATE cd_live2d_session CyberDesktop::CharacterProtocol)
add_executable(cd_sdk_live2d_preview_tests EXCLUDE_FROM_ALL tests/Live2DPreviewTest.cpp)
target_link_libraries(cd_sdk_live2d_preview_tests PRIVATE cd_sdk_tool_support)
target_compile_options(cd_sdk_live2d_preview_tests PRIVATE /utf-8 /W4)
add_dependencies(cd_sdk_live2d_preview_tests cyber_live2d_host)
add_executable(cd_sdk_character_preview_tests EXCLUDE_FROM_ALL tests/CharacterPreviewTest.cpp)
target_link_libraries(cd_sdk_character_preview_tests PRIVATE cd_sdk_tool_support CyberDesktop::CharacterProtocol)
target_compile_options(cd_sdk_character_preview_tests PRIVATE /utf-8 /W4)
add_dependencies(cd_sdk_character_preview_tests cd_sdk_image_worker)
foreach(target cd_sdk_cli cd_sdk_preview cd_sdk_image_worker cd_sdk_character_preview_tests cd_sdk_live2d_preview_tests)
    if(TARGET ${target})
        set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
    endif()
endforeach()
if(CD_SDK_OWNS_PREVIEW_WORKER)
    add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/live2d/shaders.ready"
        COMMAND ${CMAKE_COMMAND} -E env --modify "PATH=path_list_prepend:$<TARGET_FILE_DIR:Qt6::Core>"
            "$<TARGET_FILE:cyber_live2d_host>" --prepare-shaders
        COMMAND ${CMAKE_COMMAND} -E touch "${CMAKE_BINARY_DIR}/live2d/shaders.ready"
        DEPENDS cyber_live2d_host VERBATIM)
    add_custom_target(cd_sdk_live2d_resources ALL DEPENDS "${CMAKE_BINARY_DIR}/live2d/shaders.ready")
    add_dependencies(cd_sdk_preview cd_sdk_live2d_resources)
    add_dependencies(cd_sdk_live2d_preview_tests cd_sdk_live2d_resources)
    install(TARGETS cyber_live2d_host RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
    install(DIRECTORY "${CD_CUBISM_ROOT}/Framework/src/Rendering/D3D11/Shaders/"
        DESTINATION "${CMAKE_INSTALL_BINDIR}/live2d/FrameworkShaders")
    install(DIRECTORY "${CMAKE_BINARY_DIR}/live2d/shader-cache/"
        DESTINATION "${CMAKE_INSTALL_BINDIR}/live2d/shader-cache")
    foreach(component Core Gui Network)
        install(FILES "$<TARGET_FILE:Qt6::${component}>" DESTINATION ${CMAKE_INSTALL_BINDIR})
    endforeach()
    get_filename_component(qt_notices_default "${Qt6_DIR}/../../../../../Licenses" ABSOLUTE)
    set(CD_SDK_QT_NOTICES_DIR "${qt_notices_default}" CACHE PATH "Original notices from the selected Qt installation")
    if(NOT IS_DIRECTORY "${CD_SDK_QT_NOTICES_DIR}")
        message(FATAL_ERROR "Full preview binary installation needs CD_SDK_QT_NOTICES_DIR from the selected Qt distribution")
    endif()
    install(DIRECTORY "${CD_SDK_QT_NOTICES_DIR}/"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/qt")
    install(FILES "${CD_CUBISM_ROOT}/LICENSE.md" "${CD_CUBISM_ROOT}/NOTICE.md"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/cubism")
    install(FILES "${CD_CUBISM_ROOT}/Core/LICENSE.md"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/cubism/core")
    install(FILES "${CD_CUBISM_ROOT}/Framework/LICENSE.md" "${CD_CUBISM_ROOT}/Framework/NOTICE.md"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/cubism/framework")
    install(FILES "${tomlplusplus_DIR}/copyright"
        DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/tomlplusplus" RENAME LICENSE)
endif()
