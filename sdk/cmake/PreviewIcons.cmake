find_path(THORVG_INCLUDE_DIR thorvg.h PATH_SUFFIXES thorvg-1 REQUIRED)
find_library(THORVG_LIBRARY NAMES thorvg-1 thorvg REQUIRED)
set(CD_SDK_LUCIDE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../libraries/cyberglass/resources/lucide"
    CACHE PATH "Original Lucide SVG resource directory for public SDK previews")
file(GLOB icons CONFIGURE_DEPENDS "${CD_SDK_LUCIDE_ROOT}/*.svg")
if(NOT icons OR NOT EXISTS "${CD_SDK_LUCIDE_ROOT}/LICENSE.txt")
    message(FATAL_ERROR "SDK preview requires the public Lucide resources and their license")
endif()
list(SORT icons)
list(LENGTH icons count)
set(content "#include <algorithm>\n#include <array>\n#include <utility>\n#include \"tools/BundledIcons.h\"\nnamespace cdsdk {\n")
string(APPEND content "static constexpr std::array<std::pair<std::string_view, std::string_view>, ${count}> icons{{\n")
foreach(icon IN LISTS icons)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${icon}")
    get_filename_component(name "${icon}" NAME_WLE)
    file(READ "${icon}" svg)
    string(APPEND content "{\"${name}\", R\"CDICON(${svg})CDICON\"},\n")
endforeach()
string(APPEND content "}};\nstd::string_view bundledIcon(std::string_view name) {\n")
string(APPEND content "auto found = std::lower_bound(icons.begin(), icons.end(), name, [](const auto& item, auto key) { return item.first < key; });\n")
string(APPEND content "return found != icons.end() && found->first == name ? found->second : std::string_view{};\n}\n}\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/BundledIcons.cpp" CONTENT "${content}")
target_sources(cd_sdk_tool_support PRIVATE tools/PreviewIcons.cpp "${CMAKE_CURRENT_BINARY_DIR}/BundledIcons.cpp")
target_compile_definitions(cd_sdk_tool_support PRIVATE TVG_STATIC)
target_include_directories(cd_sdk_tool_support PRIVATE "${THORVG_INCLUDE_DIR}")
target_link_libraries(cd_sdk_tool_support PRIVATE "${THORVG_LIBRARY}")
install(FILES "${CD_SDK_LUCIDE_ROOT}/LICENSE.txt"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/lucide" RENAME LICENSE)
get_filename_component(thorvg_prefix "${THORVG_INCLUDE_DIR}/../.." ABSOLUTE)
install(FILES "${thorvg_prefix}/share/thorvg/copyright"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/cyberdesktop-sdk/third_party/thorvg" RENAME LICENSE)
