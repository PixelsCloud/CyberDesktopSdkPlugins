@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/NativeCompilerDependencies.cmake")
include(CMakeFindDependencyMacro)
set(_cd_sdk_needs_canvas FALSE)
if(NOT CyberDesktopSDK_FIND_COMPONENTS)
    set(_cd_sdk_needs_canvas TRUE)
endif()
foreach(component IN LISTS CyberDesktopSDK_FIND_COMPONENTS)
    if(component MATCHES "^(SDK|Rendering|Images|Layout)$")
        set(_cd_sdk_needs_canvas TRUE)
    elseif(NOT component MATCHES "^(ABI|Core|PackageRuntime)$")
        set(CyberDesktopSDK_${component}_FOUND FALSE)
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/CyberDesktopSDKTargets.cmake")
if(_cd_sdk_needs_canvas)
    find_dependency(CyberCanvas 1.2 CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/CyberDesktopSDKRenderingTargets.cmake")
endif()
foreach(component ABI Core PackageRuntime SDK Rendering Images Layout)
    if(TARGET CyberDesktopSDK::${component})
        set(CyberDesktopSDK_${component}_FOUND TRUE)
    else()
        set(CyberDesktopSDK_${component}_FOUND FALSE)
    endif()
endforeach()
unset(_cd_sdk_needs_canvas)
# Keep tool lookup tied to this installation, even after the kit is relocated.
get_filename_component(CyberDesktopSDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
foreach(tool Tool Preview)
    if(tool STREQUAL "Tool")
        set(_cd_sdk_tool_name cd-sdk)
    else()
        set(_cd_sdk_tool_name cd-sdk-preview)
    endif()
    set(_cd_sdk_tool_path "${CyberDesktopSDK_ROOT}/@CMAKE_INSTALL_BINDIR@/${_cd_sdk_tool_name}.exe")
    if(EXISTS "${_cd_sdk_tool_path}" AND NOT TARGET CyberDesktopSDK::${tool})
        add_executable(CyberDesktopSDK::${tool} IMPORTED)
        set_target_properties(CyberDesktopSDK::${tool} PROPERTIES IMPORTED_LOCATION "${_cd_sdk_tool_path}")
    endif()
endforeach()
unset(_cd_sdk_tool_name)
unset(_cd_sdk_tool_path)
include("${CMAKE_CURRENT_LIST_DIR}/CyberDesktopPlugin.cmake")
check_required_components(CyberDesktopSDK)

include("${CMAKE_CURRENT_LIST_DIR}/IncrementalAssets.cmake")
