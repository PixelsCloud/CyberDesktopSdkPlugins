cmake_minimum_required(VERSION 3.21)
foreach(required ROOT INVENTORY PREVIOUS)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing asset inventory argument: ${required}")
  endif()
endforeach()
file(STRINGS "${INVENTORY}" current)
if(EXISTS "${PREVIOUS}")
  file(STRINGS "${PREVIOUS}" previous)
  foreach(path IN LISTS previous)
    if(NOT path IN_LIST current)
      cmake_path(ABSOLUTE_PATH path NORMALIZE OUTPUT_VARIABLE absolute)
      cmake_path(IS_PREFIX ROOT "${absolute}" NORMALIZE inside)
      if(NOT inside OR absolute STREQUAL ROOT OR IS_DIRECTORY "${absolute}")
        message(FATAL_ERROR "Refusing to remove an asset outside the generated file inventory: ${path}")
      endif()
      file(REMOVE "${absolute}")
    endif()
  endforeach()
endif()
