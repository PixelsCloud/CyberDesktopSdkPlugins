include_guard(GLOBAL)
if(CMAKE_VERSION VERSION_LESS 3.26)
  message(FATAL_ERROR "Incremental asset staging requires CMake 3.26 or newer")
endif()

# These recipes use CMake's argument lists, not shell command parsing. Record
# the inputs/outputs of the existing copy and SDK descriptor/pack operations so
# Ninja can skip unchanged work and repair a missing generated file.
function(cd_asset_path output value)
  while(value MATCHES "\\$<TARGET_FILE(_DIR)?:([^>]+)>")
    set(expression "${CMAKE_MATCH_0}")
    set(directory_only "${CMAKE_MATCH_1}")
    set(target "${CMAKE_MATCH_2}")
    get_target_property(directory ${target} RUNTIME_OUTPUT_DIRECTORY)
    if(NOT directory)
      get_target_property(directory ${target} BINARY_DIR)
    endif()
    if(directory_only)
      set(replacement "${directory}")
    else()
      get_target_property(name ${target} OUTPUT_NAME)
      if(NOT name)
        set(name "${target}")
      endif()
      get_target_property(type ${target} TYPE)
      if(type STREQUAL "EXECUTABLE")
        set(replacement "${directory}/${name}${CMAKE_EXECUTABLE_SUFFIX}")
      else()
        set(replacement "${directory}/${name}${CMAKE_SHARED_LIBRARY_SUFFIX}")
      endif()
    endif()
    string(REPLACE "${expression}" "${replacement}" value "${value}")
  endwhile()
  cmake_path(NORMAL_PATH value)
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(cd_asset_command)
  set(command ${ARGN})
  list(LENGTH command count)
  if(count LESS 2)
    return()
  endif()
  list(GET command 1 operation)
  if(operation STREQUAL "-E")
    list(GET command 2 operation)
    list(SUBLIST command 3 -1 paths)
    if(operation STREQUAL "make_directory")
      foreach(path IN LISTS paths)
        cd_asset_path(path "${path}")
        list(APPEND directories "${path}")
        # make_directory also creates the parents; record them on a clean
        # build instead of inferring destination types from old disk state.
        get_filename_component(parent "${path}" DIRECTORY)
        while(parent)
          list(APPEND directories "${parent}")
          get_filename_component(next "${parent}" DIRECTORY)
          if(next STREQUAL parent)
            break()
          endif()
          set(parent "${next}")
        endwhile()
      endforeach()
    elseif(operation MATCHES "^copy(_if_different|_directory|_directory_if_different)?$")
      list(POP_BACK paths destination)
      cd_asset_path(destination "${destination}")
      foreach(source IN LISTS paths)
        if(source MATCHES "^\\$<TARGET_FILE:")
          cd_asset_path(binary "${source}")
          list(APPEND binaries "${binary}")
          list(APPEND inputs "${source}")
        endif()
        cd_asset_path(source "${source}")
        if(operation MATCHES "directory")
          set(files)
          # Generated staging trees are described by prior recipe outputs.
          # Never glob build output: stale files must not become dependencies.
          cmake_path(IS_PREFIX CMAKE_BINARY_DIR "${source}" NORMALIZE generated)
          if(generated)
            string(SHA256 source_key "${source}")
            get_property(known GLOBAL PROPERTY "CD_ASSET_TREE_${source_key}")
            foreach(file IN LISTS products known)
              cmake_path(IS_PREFIX source "${file}" NORMALIZE within)
              if(within)
                list(APPEND files "${file}")
              endif()
            endforeach()
          else()
            file(GLOB_RECURSE files CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${source}/*")
          endif()
          foreach(file IN LISTS files)
            file(RELATIVE_PATH relative "${source}" "${file}")
            list(APPEND inputs "${file}")
            list(APPEND products "${destination}/${relative}")
          endforeach()
          list(APPEND directories "${destination}")
        else()
          list(APPEND inputs "${source}")
          if(destination IN_LIST directories OR IS_DIRECTORY "${destination}" OR paths MATCHES ";")
            get_filename_component(filename "${source}" NAME)
            list(APPEND products "${destination}/${filename}")
          else()
            list(APPEND products "${destination}")
          endif()
        endif()
      endforeach()
    elseif(operation STREQUAL "rm" OR operation STREQUAL "remove_directory")
      # Removed legacy files cannot also be declared generated outputs.
      foreach(path IN LISTS paths)
        cd_asset_path(path "${path}")
        list(REMOVE_ITEM products "${path}")
        if(operation STREQUAL "remove_directory")
          foreach(product IN LISTS products)
            cmake_path(IS_PREFIX path "${product}" NORMALIZE removed)
            if(removed)
              list(REMOVE_ITEM products "${product}")
            endif()
          endforeach()
        endif()
      endforeach()
    else()
      message(FATAL_ERROR "Unsupported asset operation: ${operation}")
    endif()
  elseif(operation STREQUAL "descriptor" OR operation STREQUAL "pack")
    list(GET command 2 source)
    list(GET command 3 destination)
    cd_asset_path(destination "${destination}")
    list(APPEND products "${destination}")
    if(operation STREQUAL "descriptor")
      list(APPEND inputs "${source}")
    endif()
  elseif(command MATCHES "sync-live2d-assets.py")
    list(GET command 1 script)
    list(GET command 2 kind)
    list(GET command 3 destination)
    list(APPEND inputs "${script}")
    cd_asset_command("${CMAKE_COMMAND}" -E copy_directory
      "${CMAKE_CURRENT_SOURCE_DIR}/${kind}" "${destination}")
  elseif(command MATCHES "StagePhysicsAssets.cmake")
    foreach(argument IN LISTS command)
      if(argument MATCHES "^-D([A-Z_]+)=(.*)$")
        set(${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
      endif()
    endforeach()
    cd_asset_path(ASSET_DIRECTORY "${ASSET_DIRECTORY}")
    set(materials "chassis-${LAYOUT}.png" steel-marble.png NOTICE.txt)
    if(KIND STREQUAL "clock")
      list(APPEND materials precision-gear.png clock-window.png)
    elseif(KIND STREQUAL "beat")
      list(APPEND materials piston-base.png piston-cap.png paddle.png bumper.png launcher.png)
    else()
      message(FATAL_ERROR "Unknown physics asset kind: ${KIND}")
    endif()
    foreach(material IN LISTS materials)
      list(APPEND inputs "${SOURCE_DIRECTORY}/${material}")
      list(APPEND products "${ASSET_DIRECTORY}/${material}")
    endforeach()
    list(APPEND inputs "${SOURCE_DIRECTORY}/provenance-${LAYOUT}.json")
    list(GET command -1 script)
    list(APPEND inputs "${script}")
    list(APPEND products "${ASSET_DIRECTORY}/provenance.json")
  else()
    message(FATAL_ERROR "Asset recipe needs explicit file rules for command: ${command}")
  endif()
  foreach(list_name inputs products directories binaries)
    set(${list_name} "${${list_name}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(cd_asset_target name)
  set(recipe ${ARGN})
  set(inputs "${CMAKE_CURRENT_LIST_FILE}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  set(products)
  set(directories)
  set(binaries)
  set(command)
  set(in_command FALSE)
  set(in_depends FALSE)
  foreach(token IN LISTS recipe)
    if(token MATCHES "^(COMMAND|DEPENDS|COMMENT|WORKING_DIRECTORY|VERBATIM|USES_TERMINAL|BYPRODUCTS)$")
      if(in_command)
        cd_asset_command(${command})
      endif()
      set(command)
      set(in_command FALSE)
      set(in_depends FALSE)
      if(token STREQUAL "COMMAND")
        set(in_command TRUE)
      elseif(token STREQUAL "DEPENDS")
        set(in_depends TRUE)
      endif()
    elseif(in_command)
      list(APPEND command "${token}")
    elseif(in_depends AND TARGET "${token}")
      get_target_property(dependency_stamp "${token}" CD_ASSET_STAMP)
      if(dependency_stamp)
        list(APPEND inputs "${dependency_stamp}")
      endif()
    endif()
  endforeach()
  if(in_command)
    cd_asset_command(${command})
  endif()
  set(default_build)
  if(ALL IN_LIST recipe AND NOT name MATCHES "package")
    set(default_build ALL)
  endif()
  list(REMOVE_ITEM recipe ALL)
  # A package may copy its staging tree back next to the source module.
  # Rewriting a byte-identical DLL there changes a dependency while this rule
  # runs, keeping the recipe perpetually dirty in Ninja's recorded mtime.
  list(TRANSFORM recipe REPLACE "^copy_directory$" "copy_directory_if_different")
  list(REMOVE_DUPLICATES products)
  list(REMOVE_DUPLICATES inputs)
  list(REMOVE_ITEM products ${binaries})
  list(REMOVE_ITEM inputs ${products})
  # A runtime staging rule may already own files also copied by a package.
  # Keep one producer in Ninja and order the package after that producer.
  foreach(product IN LISTS products)
    string(SHA256 key "${product}")
    get_property(owner GLOBAL PROPERTY "CD_ASSET_OWNER_${key}")
    if(owner)
      list(REMOVE_ITEM products "${product}")
      list(APPEND inputs "${owner}")
    endif()
  endforeach()
  set(stamp "${CMAKE_CURRENT_BINARY_DIR}/asset-stamps/${name}.stamp")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/asset-stamps")
  set(prune "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/PruneGeneratedAssets.cmake")
  string(JOIN "\n" inventory ${products})
  file(GENERATE OUTPUT "${stamp}.outputs" CONTENT "${inventory}\n")
  # File-set changes (including removals) are real inputs, even if the copy
  # command text itself is unchanged after CMake's glob verification.
  string(JOIN "\n" dependencies ${inputs})
  file(GENERATE OUTPUT "${stamp}.inputs" CONTENT "${dependencies}\n")
  add_custom_command(OUTPUT "${stamp}"
    COMMAND "${CMAKE_COMMAND}" "-DROOT=${CMAKE_BINARY_DIR}" "-DINVENTORY=${stamp}.outputs"
      "-DPREVIOUS=${stamp}.previous" -P "${prune}"
    ${recipe}
    DEPENDS ${inputs} "${stamp}.outputs" "${stamp}.inputs" "${prune}"
    BYPRODUCTS ${products} "${stamp}.previous"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${stamp}.outputs" "${stamp}.previous"
    COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}" VERBATIM)
  add_custom_target(${name} ${default_build} DEPENDS "${stamp}")
  foreach(product IN LISTS products)
    string(SHA256 key "${product}")
    set_property(GLOBAL PROPERTY "CD_ASSET_OWNER_${key}" "${stamp}")
    get_filename_component(parent "${product}" DIRECTORY)
    while(NOT parent STREQUAL CMAKE_BINARY_DIR)
      cmake_path(IS_PREFIX CMAKE_BINARY_DIR "${parent}" NORMALIZE in_build)
      if(NOT in_build)
        break()
      endif()
      string(SHA256 tree_key "${parent}")
      set_property(GLOBAL APPEND PROPERTY "CD_ASSET_TREE_${tree_key}" "${product}")
      get_filename_component(parent "${parent}" DIRECTORY)
    endwhile()
  endforeach()
  set_property(TARGET ${name} PROPERTY CD_ASSET_STAMP "${stamp}")
  set_property(TARGET ${name} PROPERTY CD_ASSET_PRODUCTS "${products}")
  if(name MATCHES "package")
    set_property(GLOBAL APPEND PROPERTY CD_PACKAGE_TARGETS ${name})
  endif()
endfunction()
