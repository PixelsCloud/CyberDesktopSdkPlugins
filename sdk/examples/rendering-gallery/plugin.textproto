id: "org.cyberdesktop.sdk.rendering-gallery"
name: "Canvas Lab"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
capabilities: SYSTEM_INFO
description: "Native animation, particles, rich text and live CPU charts."
footprint_rules { topology: RECT min_cells: 16 max_cells: 36 max_columns: 6 max_rows: 6 }
layouts {
    id: "rect-4x4"
    name: "4 × 4"
    topology: RECT
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 0 b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 0 b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    allowed_rotations: 0
    is_default: true
}
settings_page {
    title: "Canvas Lab"
    fields { id: "animate" label: "Animate illustration" type: TOGGLE bool_default: true }
    fields { id: "speed" label: "Animation speed" type: NUMBER minimum: 0 maximum: 2 step: 0.05 number_default: 1 }
    fields {
        id: "chart"
        label: "Chart style"
        type: CHOICE
        text_default: "bars"
        choices { value: "bars" label: "Bars" }
        choices { value: "donut" label: "Donut" }
        choices { value: "heatmap" label: "Heatmap" }
    }
}
