id: "org.cyberdesktop.sdk.data-dashboard"
name: "SDK data-dashboard"
version: "1.1.0"
author: "CyberDesktop SDK"
abi_version: 1
entry: "plugin.dll"
content_padding: 4
description: "Public host data service example. Source is MIT."
capabilities: INPUT_STATS
capabilities: SYSTEM_INFO
capabilities: WEATHER
capabilities: AIR_QUALITY
required_services { id: "input.stats" version: 1 }
required_services { id: "system.telemetry" version: 1 }
required_services { id: "weather.forecast" version: 1 }
required_services { id: "air.quality" version: 1 }
footprint_rules { topology: RECT min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
layouts {
    id: "default"
    name: "Default"
    topology: RECT
    is_default: true
    allowed_rotations: 0
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
}
settings_page {
    title: "数据服务示例设置"
    description: "每个实例独立保存外观。数据由本体共享采集。"
    localized {
        key: "en"
        value { title: "Data service example" description: "Appearance is per instance. Producers belong to the host." }
    }
    fields {
        id: "background"
        label: "显示背景"
        section: "外观"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        section: "外观"
        type: INTEGER
        integer_default: 5
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Background radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        section: "外观"
        type: FONT
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        section: "外观"
        type: CHOICE
        text_default: "zh-CN"
        choices { value: "zh-CN" label: "简体中文" }
        choices { value: "en" label: "English" }
        localized {
            key: "en"
            value { label: "Language" section: "Appearance" }
        }
    }
}
preview: "preview.png"
