id: "com.cyberdesktop.airquality.1x2"
name: "空气质量 2×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x2"
    name: "2×1（宽×高）"
    cells {}
    cells { a: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 2 max_cells: 2 max_columns: 2 max_rows: 1 }
capabilities: AIR_QUALITY
description: "WAQI 附近监测站实时 US AQI；六种状态色、污染物分项指数与 PM2.5 指数预报。"
icon: "assets/icons/leaf.png"
settings_page {
    title: "空气质量设置"
    description: "显示附近监测站 US AQI，不代表全城平均；分项和预报均为指数，不是浓度。数据来自 WAQI 和原监测机构。默认 IP 自动定位；代理 / VPN 可能影响位置。凭据不随桌面控件包分发。AQICN 对公开和付费应用有额外授权要求。"
    fields {
        id: "location_mode"
        label: "位置来源"
        type: CHOICE
        section: "位置"
        choices {
            value: "auto"
            label: "跟随本体默认位置（附近监测站）"
            localized_labels { key: "en" value: "Follow host default location (nearby station)" }
            localized_labels { key: "zh-TW" value: "跟隨本體預設位置（附近監測站）" }
        }
        choices {
            value: "city"
            label: "搜索城市 / 监测站"
            localized_labels { key: "en" value: "Search city / station" }
            localized_labels { key: "zh-TW" value: "搜尋城市 / 監測站" }
        }
        choices {
            value: "coordinates"
            label: "指定经纬度"
            localized_labels { key: "en" value: "Coordinates" }
            localized_labels { key: "zh-TW" value: "指定經緯度" }
        }
        choices {
            value: "station"
            label: "指定站点 ID"
            localized_labels { key: "en" value: "Station ID" }
            localized_labels { key: "zh-TW" value: "指定站點 ID" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Location source" section: "Location" }
        }
        localized {
            key: "zh-TW"
            value { label: "位置來源" section: "位置" }
        }
    }
    fields {
        id: "city"
        label: "城市 / 监测站名称"
        type: TEXT
        description: "搜索模式使用此名称匹配站点；经纬度模式可作显示名称。自动模式忽略此项，不回退默认城市。"
        section: "位置"
        max_length: 128
        localized {
            key: "en"
            value {
                label: "City / station name"
                description: "Search mode matches the first station. In coordinate mode this is an optional display name. Ignored in automatic mode."
                section: "Location"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "城市 / 監測站名稱"
                description: "搜尋模式使用此名稱匹配站點；經緯度模式可作顯示名稱。自動模式忽略此項，不回退預設城市。"
                section: "位置"
            }
        }
    }
    fields {
        id: "station"
        label: "站点 ID"
        type: TEXT
        description: "只填数字，仅“指定站点 ID”模式使用。"
        section: "位置"
        max_length: 16
        localized {
            key: "en"
            value { label: "Station ID" description: "Digits only, used in Station ID mode." section: "Location" }
        }
        localized {
            key: "zh-TW"
            value { label: "站點 ID" description: "只填數字，僅“指定站點 ID”模式使用。" section: "位置" }
        }
    }
    fields {
        id: "latitude"
        label: "纬度"
        type: NUMBER
        section: "位置"
        minimum: -90.0
        maximum: 90.0
        step: 0.0001
        localized {
            key: "en"
            value { label: "Latitude" section: "Location" }
        }
        localized {
            key: "zh-TW"
            value { label: "緯度" section: "位置" }
        }
    }
    fields {
        id: "longitude"
        label: "经度"
        type: NUMBER
        section: "位置"
        minimum: -180.0
        maximum: 180.0
        step: 0.0001
        localized {
            key: "en"
            value { label: "Longitude" section: "Location" }
        }
        localized {
            key: "zh-TW"
            value { label: "經度" section: "位置" }
        }
    }
    fields {
        id: "credentials_file"
        label: "宿主凭据配置 ID"
        type: TEXT
        description: "在设置→数据服务中添加私有凭据，填写其配置 ID；留空使用 default。旧文件路径由宿主导入为不透明 ID。不要填写 Token。"
        section: "连接"
        max_length: 1024
        localized {
            key: "en"
            value {
                label: "Host credential profile ID"
                description: "Add credentials in Settings > Data services and enter the profile ID; empty uses default. Previous file paths are privately imported by the host. Never enter a token."
                section: "Connection"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "宿主憑據配置 ID"
                description: "在設定→資料服務中新增私有憑據，填寫其配置 ID；留空使用 default。舊檔案路徑由宿主匯入為不透明 ID。不要填寫 Token。"
                section: "連線"
            }
        }
    }
    fields {
        id: "refresh_minutes"
        label: "刷新间隔（分钟）"
        type: INTEGER
        description: "后台请求，同地点实例共用内存缓存。双击刷新；原始观测可能为小时更新。"
        section: "显示"
        minimum: 5.0
        maximum: 180.0
        step: 5.0
        integer_default: 15
        localized {
            key: "en"
            value {
                label: "Refresh interval (minutes)"
                description: "Background requests share a volatile cache. Double-click refreshes. Station observations may update hourly."
                section: "Display"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "重新整理間隔（分鐘）"
                description: "後臺請求，同地點例項共用記憶體快取。雙擊重新整理；原始觀測可能為小時更新。"
                section: "顯示"
            }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "显示"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Display" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "顯示" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4009093119
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4009093119
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "空气质量读数颜色"
        type: COLOR
        description: "AQI 主读数与主要标题，等级提示保留等级配色。"
        section: "外观"
        color_default: 1199263487
        localized {
            key: "en"
            value {
                label: "Air-quality readout color"
                description: "AQI readout and primary headings; severity indicators retain their level colors."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "污染物与说明颜色"
        type: COLOR
        description: "污染物名称、单位与辅助说明。"
        section: "外观"
        color_default: 2073326335
        localized {
            key: "en"
            value {
                label: "Pollutant caption color"
                description: "Pollutant labels, units and supporting captions."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "污染物含量条颜色"
        type: COLOR
        description: "污染物浓度条中的有效部分。"
        section: "外观"
        color_default: 3684715263
        localized {
            key: "en"
            value {
                label: "Pollutant level bar color"
                description: "Filled portion of pollutant concentration bars."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Air quality settings"
            description: "Nearby station US AQI, not a city average. Pollutant values and forecasts are indices, not concentrations. Data by WAQI and the originating EPA. Automatic IP location may be affected by proxies / VPNs. Credentials are not bundled. Public / paid usage is subject to AQICN\'s terms."
        }
    }
    localized {
        key: "zh-TW"
        value {
            title: "空氣質量設定"
            description: "顯示附近監測站 US AQI，不代表全城平均；分項和預報均為指數，不是濃度。資料來自 WAQI 和原監測機構。預設 IP 自動定位；代理 / VPN 可能影響位置。憑據不隨桌面小工具包分發。AQICN 對公開和付費應用有額外授權要求。"
        }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "air.quality" version: 1 }
tags: "简约"
tags: "环境"
