id: "com.cyberdesktop.systeminfo.1x4"
name: "系统监控 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 6
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
capabilities: SYSTEM_INFO
description: "分段仪表；4×1 格（宽×高），适配正方格和长方格。CPU 温度无数据时显示 0°C。"
settings_page {
    title: "系统监控设置"
    description: "只修改当前实例。CPU 温度缺少可靠数据时显示 0°C 占位，其他指标暂无数据时显示 —。"
    fields {
        id: "interval"
        label: "刷新间隔（ms）"
        type: INTEGER
        section: "采样"
        minimum: 500.0
        maximum: 5000.0
        step: 100.0
        integer_default: 1000
        localized {
            key: "en"
            value { label: "Refresh interval (ms)" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "重新整理間隔（ms）" section: "取樣" }
        }
    }

    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "外觀" }
        }
    }
    localized {
        key: "en"
        value {
            title: "System monitor settings"
            description: "Settings are saved separately for each instance. Select a font and language below."
        }
    }
    localized {
        key: "zh-TW"
        value {
            title: "系統監控設定"
            description: "只修改當前例項。CPU 溫度缺少可靠資料時顯示 0°C 佔位，其他指標暫無資料時顯示 —。"
        }
    }

    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "外观"
        color_default: 3941924863
        localized {
            key: "en"
            value { label: "Background color" section: "Appearance" }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        section: "外观"
        text_default: "solid"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        localized {
            key: "en"
            value { label: "Background fill" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        section: "外观"
        color_default: 3941924863
        localized {
            key: "en"
            value { label: "Gradient end color" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        section: "外观"
        integer_default: 90
        minimum: 0
        maximum: 360
        step: 1
        localized {
            key: "en"
            value { label: "Gradient angle (°)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "外观"
        color_default: 542869759
        localized {
            key: "en"
            value { label: "Text color" section: "Appearance" }
        }
    }
    fields {
        id: "secondary"
        label: "次要文字颜色"
        type: COLOR
        section: "外观"
        color_default: 1652529663
        localized {
            key: "en"
            value { label: "Secondary text color" section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "强调颜色"
        type: COLOR
        section: "外观"
        color_default: 3868870143
        localized {
            key: "en"
            value { label: "Accent color" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        integer_default: 12
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
}
preview: "preview.png"
tags: "科技"
tags: "系统"
tags: "仪表"
