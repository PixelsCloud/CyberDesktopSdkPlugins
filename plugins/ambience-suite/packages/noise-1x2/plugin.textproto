id: "com.cyberdesktop.ambient.noise.1x2"
name: "白噪音 2×1"
version: "1.0.11"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "1x2"
    name: "2×1（宽×高）"
    cells {}
    cells { a: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 2 max_cells: 2 max_columns: 2 max_rows: 1 }
capabilities: MEDIA_CONTROL
description: "六种自然声、四路混音、定时渐弱关闭；默认停止。"
settings_page {
    title: "白噪音设置"
    fields {
        id: "lighting"
        label: "昼夜模式"
        type: CHOICE
        section: "声音"
        choices {
            value: "theme"
            label: "跟随桌面主题"
            localized_labels { key: "zh-TW" value: "跟隨桌面主題" }
        }
        choices {
            value: "day"
            label: "白天"
            localized_labels { key: "zh-TW" value: "白天" }
        }
        choices {
            value: "night"
            label: "黑夜"
            localized_labels { key: "zh-TW" value: "黑夜" }
        }
        text_default: "theme"
        localized {
            key: "en"
            value { label: "Day/Night Mode" section: "Sound" }
        }
        localized {
            key: "zh-TW"
            value { label: "晝夜模式" section: "聲音" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "声音"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show Background" section: "Sound" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示背景" section: "聲音" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "声音"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value { label: "Background Corner Radius" section: "Sound" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角" section: "聲音" }
        }
    }
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "声音"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Set Language" section: "Sound" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "聲音" }
        }
    }
    fields {
        id: "animation"
        label: "启用动画"
        type: TOGGLE
        section: "外观与行为"
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable animation" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "啟用動畫" section: "外觀與行為" }
        }
    }
    fields {
        id: "speed"
        label: "动效速度"
        type: NUMBER
        description: "默认 0.75 倍；调整速度保持动作连续。"
        section: "外观与行为"
        minimum: 0.25
        maximum: 2.0
        step: 0.25
        number_default: 0.75
        localized {
            key: "en"
            value {
                label: "Animation Speed"
                description: "Default 0.75×; adjusting speed keeps actions continuous."
                section: "Appearance and Behavior"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "動效速度" description: "預設 0.75 倍；調整速度保持動作連續。" section: "外觀與行為" }
        }
    }
    fields {
        id: "frame_rate"
        label: "动画帧率"
        type: CHOICE
        section: "外观与行为"
        choices {
            value: "15"
            label: "15 FPS"
            localized_labels { key: "zh-TW" value: "15 FPS" }
        }
        choices {
            value: "20"
            label: "20 FPS"
            localized_labels { key: "zh-TW" value: "20 FPS" }
        }
        choices {
            value: "30"
            label: "30 FPS"
            localized_labels { key: "zh-TW" value: "30 FPS" }
        }
        text_default: "20"
        localized {
            key: "en"
            value { label: "Animation frame rate" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "動畫幀率" section: "外觀與行為" }
        }
    }
    fields {
        id: "primary"
        label: "简洁卡片声音"
        type: INTEGER
        description: "0 雨声、1 海浪、2 溪流、3 森林、4 壁炉、5 风声。"
        section: "声音"
        maximum: 5.0
        step: 1.0
        localized {
            key: "en"
            value {
                label: "Simple Card Sound"
                description: "0 Rain, 1 Ocean Waves, 2 Stream, 3 Forest, 4 Fireplace, 5 Wind."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "簡潔卡片聲音"
                description: "0 雨聲、1 海浪、2 溪流、3 森林、4 壁爐、5 風聲。"
                section: "聲音"
            }
        }
    }
    fields {
        id: "preset"
        label: "声音配方"
        type: CHOICE
        section: "声音"
        choices {
            value: "rain"
            label: "雨夜"
            localized_labels { key: "zh-TW" value: "雨夜" }
        }
        choices {
            value: "sea"
            label: "海边"
            localized_labels { key: "zh-TW" value: "海邊" }
        }
        choices {
            value: "campfire"
            label: "炉边"
            localized_labels { key: "zh-TW" value: "爐邊" }
        }
        choices {
            value: "custom"
            label: "自定义混音"
            localized_labels { key: "zh-TW" value: "自定義混音" }
        }
        text_default: "rain"
        localized {
            key: "en"
            value { label: "Sound Recipe" section: "Sound" }
        }
        localized {
            key: "zh-TW"
            value { label: "聲音配方" section: "聲音" }
        }
    }
    fields {
        id: "link"
        label: "共享声音组"
        type: CHOICE
        description: "多个白噪音卡片可加入同一组，共用音量与播放状态；最后一个实例移除后停止声音。"
        section: "声音"
        choices {
            value: "independent"
            label: "独立播放"
            localized_labels { key: "zh-TW" value: "獨立播放" }
        }
        choices {
            value: "rain"
            label: "雨声组"
            localized_labels { key: "zh-TW" value: "雨聲組" }
        }
        choices {
            value: "fire"
            label: "壁炉组"
            localized_labels { key: "zh-TW" value: "壁爐組" }
        }
        choices {
            value: "stars"
            label: "风声组"
            localized_labels { key: "zh-TW" value: "風聲組" }
        }
        text_default: "independent"
        localized {
            key: "en"
            value {
                label: "Shared Sound Groups"
                description: "Multiple white noise cards can be added to the same group, sharing volume and playback status; sound stops when the last instance is removed."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "共享聲音組"
                description: "多個白噪音卡片可加入同一組，共用音量與播放狀態；最後一個例項移除後停止聲音。"
                section: "聲音"
            }
        }
    }
    fields {
        id: "master"
        label: "主音量"
        type: INTEGER
        section: "声音"
        maximum: 100.0
        step: 1.0
        integer_default: 25
        localized {
            key: "en"
            value { label: "Main Volume" section: "Sound" }
        }
        localized {
            key: "zh-TW"
            value { label: "主音量" section: "聲音" }
        }
    }
    fields {
        id: "timer_minutes"
        label: "定时关闭（分钟）"
        type: INTEGER
        description: "0 为不限时，最后十秒渐弱；隐藏后仍计时。"
        section: "声音"
        maximum: 240.0
        step: 5.0
        integer_default: 30
        localized {
            key: "en"
            value {
                label: "Timer Off (minutes)"
                description: "0 means no time limit, fade out in the last ten seconds; timing continues when hidden."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "定時關閉（分鐘）" description: "0 為不限時，最後十秒漸弱；隱藏後仍計時。" section: "聲音" }
        }
    }
    fields {
        id: "rain"
        label: "雨声音量"
        type: INTEGER
        description: "最多同时启用四种声音；0 表示关闭。"
        section: "声音"
        maximum: 100.0
        step: 1.0
        integer_default: 60
        localized {
            key: "en"
            value {
                label: "Rain Volume"
                description: "Up to four sounds can be enabled simultaneously; 0 means off."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "雨聲音量" description: "最多同時啟用四種聲音；0 表示關閉。" section: "聲音" }
        }
    }
    fields {
        id: "ocean"
        label: "海浪音量"
        type: INTEGER
        description: "最多同时启用四种声音；0 表示关闭。"
        section: "声音"
        maximum: 100.0
        step: 1.0
        localized {
            key: "en"
            value {
                label: "Ocean Wave Volume"
                description: "Up to four sounds can be enabled simultaneously; 0 means off."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "海浪音量" description: "最多同時啟用四種聲音；0 表示關閉。" section: "聲音" }
        }
    }
    fields {
        id: "stream"
        label: "溪流音量"
        type: INTEGER
        description: "最多同时启用四种声音；0 表示关闭。"
        section: "声音"
        maximum: 100.0
        step: 1.0
        localized {
            key: "en"
            value {
                label: "Stream Volume"
                description: "Up to four sounds can be enabled simultaneously; 0 means off."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "溪流音量" description: "最多同時啟用四種聲音；0 表示關閉。" section: "聲音" }
        }
    }
    fields {
        id: "forest"
        label: "森林鸟鸣音量"
        type: INTEGER
        description: "最多同时启用四种声音；0 表示关闭。"
        section: "声音"
        maximum: 100.0
        step: 1.0
        localized {
            key: "en"
            value {
                label: "Forest Birdsong Volume"
                description: "Up to four sounds can be enabled simultaneously; 0 means off."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "森林鳥鳴音量" description: "最多同時啟用四種聲音；0 表示關閉。" section: "聲音" }
        }
    }
    fields {
        id: "fire"
        label: "壁炉音量"
        type: INTEGER
        description: "最多同时启用四种声音；0 表示关闭。"
        section: "声音"
        maximum: 100.0
        step: 1.0
        localized {
            key: "en"
            value {
                label: "Fireplace Volume"
                description: "Up to four sounds can be enabled simultaneously; 0 means off."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "壁爐音量" description: "最多同時啟用四種聲音；0 表示關閉。" section: "聲音" }
        }
    }
    fields {
        id: "wind"
        label: "风声音量"
        type: INTEGER
        description: "最多同时启用四种声音；0 表示关闭。"
        section: "声音"
        maximum: 100.0
        step: 1.0
        localized {
            key: "en"
            value {
                label: "Wind Volume"
                description: "Up to four sounds can be enabled simultaneously; 0 means off."
                section: "Sound"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "風聲音量" description: "最多同時啟用四種聲音；0 表示關閉。" section: "聲音" }
        }
    }
    localized {
        key: "en"
        value { title: "White Noise Settings" }
    }
    localized {
        key: "zh-TW"
        value { title: "白噪音設定" }
    }
}
preview: "preview.png"
required_services { id: "audio.ambient" version: 1 }
tags: "自然"
tags: "音乐"
