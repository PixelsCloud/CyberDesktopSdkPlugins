id: "com.cyberdesktop.mechanicaldesk.countdown.4x1"
name: "机械倒数日 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "精密机械独立组件；拉丝钢与黄铜结构，设置仅影响当前实例。"
icon: "preview.png"
settings_page {
    title: "倒数日设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "title"
        label: "事件名称"
        type: TEXT
        section: "内容"
        max_length: 128
        text_default: "下个假期"
        localized {
            key: "en"
            value { label: "Event title" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "事件名稱" section: "內容" }
        }
    }
    fields {
        id: "date"
        label: "目标日期（YYYY-MM-DD）"
        type: TEXT
        section: "内容"
        max_length: 10
        text_default: "2027-01-01"
        localized {
            key: "en"
            value { label: "Target date (YYYY-MM-DD)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "目標日期（YYYY-MM-DD）" section: "內容" }
        }
    }
    fields {
        id: "annual"
        label: "每年重复"
        type: TOGGLE
        section: "内容"
        localized {
            key: "en"
            value { label: "Repeat annually" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "每年重複" section: "內容" }
        }
    }

    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "内容"
        max_length: 128
        text_default: "Bahnschrift"
        localized {
            key: "en"
            value { label: "Font" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "內容" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Countdown settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "倒數日設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }
}
preview: "preview.png"
tags: "机械"
tags: "精密机械"
