id: "com.cyberdesktop.mechanicaldesk.brick.4x1"
name: "机械砖刻时钟 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
description: "精密机械独立组件；拉丝钢与黄铜结构，设置仅影响当前实例。"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
settings_page {
    title: "砖刻时钟"
    description: "24 小时时分秒。数字变化时局部凿刻，砖屑落到下沿后淡出。隐藏时暂停，恢复时直接校准当前时间。"

    fields {
        id: "animate"
        label: "雕刻与碎屑动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Carving and debris animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "debris_count"
        label: "每个数字的碎屑数量"
        type: INTEGER
        minimum: 8
        maximum: 20
        step: 1
        integer_default: 12
        localized {
            key: "en"
            value { label: "Chips per changed digit" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Brick-carved Clock"
            description: "A 24-hour carved brick clock. Only changed digits are carved. Box2D chips fall and settle on the ledge. Double-click to replay."
        }
    }
}
content_padding: 0
preview: "preview.png"
tags: "机械"
tags: "精密机械"
