id: "com.cyberdesktop.timer.1x2"
name: "番茄钟 2×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x2"
    name: "2×1（宽×高）"
    cells {}
    cells { a: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 2 max_cells: 2 max_columns: 2 max_rows: 1 }
description: "Focus timer; independent settings and partial content updates."
icon: "assets/icons/timer.png"
settings_page {
    title: "番茄钟设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "mode"
        label: "计时模式"
        type: CHOICE
        section: "内容"
        choices {
            value: "focus"
            label: "番茄钟"
            localized_labels { key: "en" value: "Pomodoro" }
            localized_labels { key: "zh-TW" value: "番茄鍾" }
        }
        choices {
            value: "countdown"
            label: "倒计时"
            localized_labels { key: "en" value: "Countdown" }
            localized_labels { key: "zh-TW" value: "倒計時" }
        }
        text_default: "focus"
        localized {
            key: "en"
            value { label: "Timer mode" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "計時模式" section: "內容" }
        }
    }
    fields {
        id: "focus_minutes"
        label: "专注时长（分钟）"
        type: INTEGER
        section: "内容"
        minimum: 1.0
        maximum: 180.0
        step: 1.0
        integer_default: 25
        localized {
            key: "en"
            value { label: "Focus minutes" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "專注時長（分鐘）" section: "內容" }
        }
    }
    fields {
        id: "break_minutes"
        label: "休息时长（分钟）"
        type: INTEGER
        section: "内容"
        minimum: 1.0
        maximum: 60.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value { label: "Break minutes" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "休息時長（分鐘）" section: "內容" }
        }
    }
    fields {
        id: "auto_break"
        label: "自动开始休息"
        type: TOGGLE
        section: "内容"
        localized {
            key: "en"
            value { label: "Automatically start break" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "自動開始休息" section: "內容" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4293978623
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4293978623
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "倒计时数字颜色"
        type: COLOR
        description: "仅控制此处标明的内容；不改变背景。"
        section: "外观"
        color_default: 3025487359
        localized {
            key: "en"
            value {
                label: "Timer digit color"
                description: "Applies to the named content only; background is unchanged."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "状态与次数颜色"
        type: COLOR
        description: "仅控制此处标明的内容；不改变背景。"
        section: "外观"
        color_default: 2860216575
        localized {
            key: "en"
            value {
                label: "Status and count color"
                description: "Applies to the named content only; background is unchanged."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "计时进度颜色"
        type: COLOR
        description: "仅控制此处标明的内容；不改变背景。"
        section: "外观"
        color_default: 849254143
        localized {
            key: "en"
            value {
                label: "Timer progress color"
                description: "Applies to the named content only; background is unchanged."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Focus timer settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "番茄鍾設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }
}
content_padding: 6.0
preview: "preview.png"
tags: "简约"
tags: "效率"
