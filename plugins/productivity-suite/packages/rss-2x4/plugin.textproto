id: "com.cyberdesktop.rss.2x4"
name: "RSS 资讯 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x4"
    name: "4×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
description: "RSS reader; independent settings and partial content updates."
icon: "assets/icons/rss.png"
settings_page {
    title: "RSS 资讯设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "url"
        label: "订阅源 URL（RSS / Atom）"
        type: TEXT
        section: "内容"
        max_length: 2048
        text_default: "https://www.qt.io/blog/rss.xml"
        localized {
            key: "en"
            value { label: "Feed URL (RSS / Atom)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "訂閱源 URL（RSS / Atom）" section: "內容" }
        }
    }
    fields {
        id: "refresh_minutes"
        label: "刷新间隔（分钟）"
        type: INTEGER
        section: "内容"
        minimum: 5.0
        maximum: 180.0
        step: 5.0
        integer_default: 15
        localized {
            key: "en"
            value { label: "Refresh interval (minutes)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "重新整理間隔（分鐘）" section: "內容" }
        }
    }
    fields {
        id: "rotation_seconds"
        label: "标题轮播间隔（秒）"
        type: INTEGER
        section: "内容"
        minimum: 5.0
        maximum: 60.0
        step: 1.0
        integer_default: 10
        localized {
            key: "en"
            value { label: "Headline rotation (seconds)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "標題輪播間隔（秒）" section: "內容" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "内容"
        max_length: 128
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "內容" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    localized {
        key: "en"
        value {
            title: "RSS reader settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "RSS 資訊設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }
}
preview: "preview.png"
tags: "简约"
tags: "资讯"

capabilities: CONTENT
required_services { id: "content.feeds" version: 1 }
