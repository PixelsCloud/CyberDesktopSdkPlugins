id: "com.cyberdesktop.rss.1x4"
name: "RSS 资讯 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
capabilities: CONTENT
description: "RSS reader; independent settings and partial content updates."
icon: "assets/icons/rss.png"
settings_page {
    title: "RSS 资讯设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "url"
        label: "订阅源 URL（RSS / Atom）"
        type: TEXT
        section: "内容"
        max_length: 2048
        text_default: "https://www.qt.io/blog/rss.xml"
        localized {
            key: "en"
            value { label: "Feed URL (RSS / Atom)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "訂閱源 URL（RSS / Atom）" section: "內容" }
        }
    }
    fields {
        id: "refresh_minutes"
        label: "刷新间隔（分钟）"
        type: INTEGER
        section: "内容"
        minimum: 5.0
        maximum: 180.0
        step: 5.0
        integer_default: 15
        localized {
            key: "en"
            value { label: "Refresh interval (minutes)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "重新整理間隔（分鐘）" section: "內容" }
        }
    }
    fields {
        id: "rotation_seconds"
        label: "标题轮播间隔（秒）"
        type: INTEGER
        section: "内容"
        minimum: 5.0
        maximum: 60.0
        step: 1.0
        integer_default: 10
        localized {
            key: "en"
            value { label: "Headline rotation (seconds)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "標題輪播間隔（秒）" section: "內容" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 3891720703
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 3891720703
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "新闻标题颜色"
        type: COLOR
        description: "仅控制此处标明的内容；不改变背景。"
        section: "外观"
        color_default: 376334591
        localized {
            key: "en"
            value {
                label: "News headline color"
                description: "Applies to the named content only; background is unchanged."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "来源、日期与翻页颜色"
        type: COLOR
        description: "仅控制此处标明的内容；不改变背景。"
        section: "外观"
        color_default: 1552515583
        localized {
            key: "en"
            value {
                label: "Source, date and navigation color"
                description: "Applies to the named content only; background is unchanged."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "RSS reader settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "RSS 資訊設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "content.feeds" version: 1 }
tags: "简约"
tags: "资讯"
