id: "com.cyberdesktop.rss.1x4"
name: "RSS 资讯 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 6
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "RSS reader; independent settings and partial content updates."
icon: "assets/icons/rss.png"
settings_page {
    title: "RSS 资讯设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "url"
        label: "订阅源 URL（RSS / Atom）"
        type: TEXT
        section: "内容"
        max_length: 2048
        text_default: "https://www.qt.io/blog/rss.xml"
        localized {
            key: "en"
            value { label: "Feed URL (RSS / Atom)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "訂閱源 URL（RSS / Atom）" section: "內容" }
        }
    }
    fields {
        id: "refresh_minutes"
        label: "刷新间隔（分钟）"
        type: INTEGER
        section: "内容"
        minimum: 5.0
        maximum: 180.0
        step: 5.0
        integer_default: 15
        localized {
            key: "en"
            value { label: "Refresh interval (minutes)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "重新整理間隔（分鐘）" section: "內容" }
        }
    }
    fields {
        id: "rotation_seconds"
        label: "标题轮播间隔（秒）"
        type: INTEGER
        section: "内容"
        minimum: 5.0
        maximum: 60.0
        step: 1.0
        integer_default: 10
        localized {
            key: "en"
            value { label: "Headline rotation (seconds)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "標題輪播間隔（秒）" section: "內容" }
        }
    }

    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    localized {
        key: "en"
        value {
            title: "RSS reader settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "RSS 資訊設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }

    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "外观"
        color_default: 3891720703
        localized {
            key: "en"
            value { label: "Background color" section: "Appearance" }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        section: "外观"
        text_default: "solid"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        localized {
            key: "en"
            value { label: "Background fill" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        section: "外观"
        color_default: 3891720703
        localized {
            key: "en"
            value { label: "Gradient end color" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        section: "外观"
        integer_default: 90
        minimum: 0
        maximum: 360
        step: 1
        localized {
            key: "en"
            value { label: "Gradient angle (°)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "外观"
        color_default: 376334591
        localized {
            key: "en"
            value { label: "Text color" section: "Appearance" }
        }
    }
    fields {
        id: "secondary"
        label: "次要文字颜色"
        type: COLOR
        section: "外观"
        color_default: 1552515583
        localized {
            key: "en"
            value { label: "Secondary text color" section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "强调颜色"
        type: COLOR
        section: "外观"
        color_default: 3817954047
        localized {
            key: "en"
            value { label: "Accent color" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        integer_default: 12
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
}
preview: "preview.png"
tags: "简约"
tags: "资讯"

capabilities: CONTENT
required_services { id: "content.feeds" version: 1 }
