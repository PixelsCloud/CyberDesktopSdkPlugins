id: "com.cyberdesktop.todo.1x4"
name: "待办清单 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "Tasks; independent settings and partial content updates."
icon: "assets/icons/todo.png"
settings_page {
    title: "待办清单设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "tasks"
        label: "任务（每行一项，最多 20 项）"
        type: TEXT
        section: "内容"
        max_length: 2048
        text_default: "整理桌面\n完成今天的计划\n阅读十分钟"
        localized {
            key: "en"
            value { label: "Tasks (one per line, up to 20)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "任務（每行一項，最多 20 項）" section: "內容" }
        }
        text_editor: MULTILINE
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "内容"
        max_length: 128
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "內容" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Tasks settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "待辦清單設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }
}
preview: "preview.png"
tags: "简约"
tags: "效率"
