id: "com.cyberdesktop.redline.beat.machine.4x2"
name: "RedLine · 双锤击鼓器 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "4x2"
    name: "4×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
capabilities: AUDIO_FFT
description: "RedLine · 双锤击鼓器 4×2，真实接触与回弹，独立运动机构。"
icon: "preview.png"
settings_page {
    title: "RedLine · 双锤击鼓器 4×2"
    fields { id: "running" label: "启用动态" type: TOGGLE bool_default: true }
    fields { id: "reduced_motion" label: "减少动态" type: TOGGLE }
    fields { id: "gain" label: "响应强度" type: NUMBER minimum: 0.25 maximum: 5.0 step: 0.05 number_default: 3.5 }
}
required_services { id: "audio.spectrum" version: 1 }
tags: "RedLine"
