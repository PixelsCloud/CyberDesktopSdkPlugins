id: "com.cyberdesktop.redline.skeleton.clock.2x2"
name: "RedLine · 镂空精密机械钟 2×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
description: "RedLine 镂空机芯造型、冷银刻度与实时指针，按系统时间走时。"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    is_default: true
    allowed_rotations: 0
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
content_padding: 0
preview: "preview.png"
settings_page {
    title: "镂空精密机械钟"
    description: "只调整当前实例。日期、时区和走时跟随系统；隐藏后停止刷新，恢复时直接校准。"
    fields {
        id: "motion"
        label: "走秒方式"
        type: CHOICE
        text_default: "beat"
        choices {
            value: "sweep"
            label: "流畅扫秒"
            localized_labels { key: "en" value: "Smooth sweep" }
        }
        choices {
            value: "beat"
            label: "机械微步（每秒八步）"
            localized_labels { key: "en" value: "Eight beats per second" }
        }
        choices {
            value: "tick"
            label: "每秒跳动"
            localized_labels { key: "en" value: "One tick per second" }
        }
        localized {
            key: "en"
            value { label: "Seconds motion" }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒针"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds hand" }
        }
    }
    fields {
        id: "detail"
        label: "齿轮动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show movement" }
        }
    }
    fields {
        id: "animation"
        label: "启用动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态效果"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Skeleton Precision Clock"
            description: "Settings affect this instance only. Follows system time and time zone; hidden clocks stop callbacks."
        }
    }
}

tags: "RedLine"
