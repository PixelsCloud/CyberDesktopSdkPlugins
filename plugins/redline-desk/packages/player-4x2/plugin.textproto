id: "com.cyberdesktop.redline.player.4x2"
name: "RedLine · 机械音乐控制 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x4"
    name: "4×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
capabilities: MEDIA_CONTROL
description: "独立的机械音乐控制 4×2插件；固定机械样式，无法切换为其他外观。尺寸按宽×高计算。"
settings_page {
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
    }
    title: "音乐控制设置"
    description: "选择正在运行的播放器；未开放的操作会自动禁用。每个实例独立保存。"
    fields {
        id: "player"
        label: "播放器"
        type: CHOICE
        section: "设置"
        choices {
            value: "auto"
            label: "自动选择"
            localized_labels { key: "en" value: "Automatic" }
            localized_labels { key: "zh-TW" value: "自動選擇" }
        }
        choices { value: "cyber_player" label: "CyberPlayer" }
        choices {
            value: "qqmusic"
            label: "QQ 音乐"
            localized_labels { key: "zh-TW" value: "QQ 音樂" }
        }
        choices {
            value: "cloudmusic"
            label: "网易云音乐"
            localized_labels { key: "en" value: "NetEase Music" }
            localized_labels { key: "zh-TW" value: "網易雲音樂" }
        }
        choices {
            value: "kugou"
            label: "酷狗音乐"
            localized_labels { key: "en" value: "Kugou Music" }
            localized_labels { key: "zh-TW" value: "酷狗音樂" }
        }
        choices {
            value: "spotify"
            label: "Spotify"
            localized_labels { key: "zh-TW" value: "Spotify" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Player" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "播放器" section: "設定" }
        }
    }
    fields {
        id: "show_progress"
        label: "显示播放进度"
        type: TOGGLE
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show progress" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示播放進度" section: "設定" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "設定" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Music controls"
            description: "Select a running player. Unavailable controls are disabled. Settings are per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "音樂控制設定" description: "選擇正在執行的播放器；未開放的操作會自動禁用。每個例項獨立儲存。" }
    }
}
preview: "preview.png"

tags: "RedLine"
