id: "com.cyberdesktop.redline.lunar.2x2"
name: "RedLine · 机械农历 2×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
description: "独立机械农历；离线双历、节气与传统节日，保留透明留白。"
settings_page {
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "減少動態" section: "外觀" }
        }
    }
    title: "机械农历设置"
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Settings language" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "外觀" }
        }
    }
}
preview: "preview.png"

tags: "RedLine"
