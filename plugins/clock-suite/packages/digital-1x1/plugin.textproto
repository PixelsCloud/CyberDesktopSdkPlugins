id: "com.cyberdesktop.clock.digital.1x1"
name: "数字时钟 1×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "1x1"
    name: "1×1（宽×高）"
    cells {}
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 1 max_cells: 1 max_columns: 1 max_rows: 1 }
description: "正式 Clock 桌面控件；1×1 格（宽×高），支持正方及竖向长方形格子。"
settings_page {
    title: "时钟设置"
    description: "只调整当前时钟实例。尺寸由桌面网格决定，内容自动适配实际宽高。"
    fields {
        id: "format"
        label: "时间制"
        type: CHOICE
        section: "时间"
        choices {
            value: "24"
            label: "24 小时"
            localized_labels { key: "en" value: "24-hour" }
            localized_labels { key: "zh-TW" value: "24 小時" }
        }
        choices {
            value: "12"
            label: "12 小时"
            localized_labels { key: "en" value: "12-hour" }
            localized_labels { key: "zh-TW" value: "12 小時" }
        }
        text_default: "24"
        localized {
            key: "en"
            value { label: "Time format" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "時間制" section: "時間" }
        }
    }
    fields {
        id: "timezone"
        label: "时区"
        type: CHOICE
        section: "时间"
        choices {
            value: "local"
            label: "跟随系统时区"
            localized_labels { key: "en" value: "System time zone" }
            localized_labels { key: "zh-TW" value: "跟隨系統時區" }
        }
        choices {
            value: "utc"
            label: "UTC"
            localized_labels { key: "en" value: "UTC" }
            localized_labels { key: "zh-TW" value: "UTC" }
        }
        choices {
            value: "offset"
            label: "自定义 UTC 偏移"
            localized_labels { key: "en" value: "Custom UTC offset" }
            localized_labels { key: "zh-TW" value: "自定義 UTC 偏移" }
        }
        text_default: "local"
        localized {
            key: "en"
            value { label: "Time zone" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "時區" section: "時間" }
        }
    }
    fields {
        id: "utc_offset"
        label: "UTC 偏移（分钟）"
        type: INTEGER
        description: "选择自定义 UTC 偏移时生效。例如 UTC+8 为 480，支持半小时和四十五分钟时区。"
        section: "时间"
        minimum: -720.0
        maximum: 840.0
        step: 15.0
        integer_default: 480
        localized {
            key: "en"
            value { label: "UTC offset (minutes)" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value {
                label: "UTC 偏移（分鐘）"
                description: "選擇自定義 UTC 偏移時生效。例如 UTC+8 為 480，支援半小時和四十五分鐘時區。"
                section: "時間"
            }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒数"
        type: TOGGLE
        section: "时间"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds / second hand" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示秒數" section: "時間" }
        }
    }
    fields {
        id: "seconds_visibility"
        label: "秒数排布"
        type: CHOICE
        description: "自动模式下，正方形 1×1 保持简洁，竖向排布时显示秒数。始终显示可在两种形状都显示秒数。"
        section: "布局"
        choices {
            value: "auto"
            label: "随空间自动显示"
            localized_labels { key: "en" value: "Automatic" }
            localized_labels { key: "zh-TW" value: "隨空間自動顯示" }
        }
        choices {
            value: "always"
            label: "始终显示"
            localized_labels { key: "en" value: "Always show" }
            localized_labels { key: "zh-TW" value: "始終顯示" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Seconds layout" description: "Affects only this instance." section: "Layout" }
        }
        localized {
            key: "zh-TW"
            value {
                label: "秒數排布"
                description: "自動模式下，正方形 1×1 保持簡潔，豎向排布時顯示秒數。始終顯示可在兩種形狀都顯示秒數。"
                section: "佈局"
            }
        }
    }
    fields {
        id: "time_layout"
        label: "数字排布"
        type: CHOICE
        description: "模拟时钟保持圆形表盘；数字时钟按可用空间横排或纵排。四格横向时钟固定横排。"
        section: "布局"
        choices {
            value: "auto"
            label: "自动适应宽高"
            localized_labels { key: "en" value: "Automatic" }
            localized_labels { key: "zh-TW" value: "自動適應寬高" }
        }
        choices {
            value: "horizontal"
            label: "横向时分"
            localized_labels { key: "en" value: "Horizontal" }
            localized_labels { key: "zh-TW" value: "橫向時分" }
        }
        choices {
            value: "stacked"
            label: "纵向时分"
            localized_labels { key: "en" value: "Stacked" }
            localized_labels { key: "zh-TW" value: "縱向時分" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Time layout" description: "Affects only this instance." section: "Layout" }
        }
        localized {
            key: "zh-TW"
            value {
                label: "數字排布"
                description: "模擬時鐘保持圓形錶盤；數字時鐘按可用空間橫排或縱排。四格橫向時鐘固定橫排。"
                section: "佈局"
            }
        }
    }
    fields {
        id: "theme_colors"
        label: "文字跟随桌面主题"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Use desktop theme colors" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "文字跟隨桌面主題" section: "外觀" }
        }
    }
    fields {
        id: "text_color"
        label: "自定义文字 / 指针"
        type: COLOR
        description: "关闭跟随桌面主题后生效。"
        section: "外观"
        color_default: 724116735
        localized {
            key: "en"
            value { label: "Text and hands" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "自定義文字 / 指標" description: "關閉跟隨桌面主題後生效。" section: "外觀" }
        }
    }
    fields {
        id: "seconds_color"
        label: "秒数 / 秒针颜色"
        type: COLOR
        section: "外观"
        color_default: 3379443711
        localized {
            key: "en"
            value { label: "Seconds and second hand" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "秒數 / 秒針顏色" section: "外觀" }
        }
    }
    fields {
        id: "content_scale"
        label: "内容大小（%）"
        type: NUMBER
        section: "布局"
        minimum: 70.0
        maximum: 100.0
        step: 1.0
        number_default: 100.0
        localized {
            key: "en"
            value { label: "Content size (%)" description: "Affects only this instance." section: "Layout" }
        }
        localized {
            key: "zh-TW"
            value { label: "內容大小（%）" section: "佈局" }
        }
    }
    fields {
        id: "relief_strength"
        label: "立体阴影强度（%）"
        type: NUMBER
        description: "调节文字、刻度、指针的投影和细微高光；0 为平面绘制。"
        section: "外观"
        maximum: 100.0
        step: 5.0
        number_default: 65.0
        localized {
            key: "en"
            value {
                label: "Relief and shadow strength (%)"
                description: "0 disables raised details."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "立體陰影強度（%）"
                description: "調節文字、刻度、指標的投影和細微高光；0 為平面繪製。"
                section: "外觀"
            }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        max_length: 128
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "外觀" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "外觀" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Clock settings"
            description: "Settings are saved separately for each instance. Select a font and language below."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "時鐘設定" description: "只調整當前時鐘例項。尺寸由桌面網格決定，內容自動適配實際寬高。" }
    }
}
preview: "preview.png"
tags: "简约"
tags: "时钟"
tags: "透明"
