id: "com.cyberdesktop.clock.pixel.1x4"
name: "像素时钟 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "绿色方形 LED 点阵，可调辉光；4×1 格（宽×高），支持正方及竖向长方形格子。"
settings_page {
    title: "时钟设置"
    description: "只调整当前时钟实例。尺寸由桌面网格决定，内容自动适配实际宽高。"
    fields {
        id: "format"
        label: "时间制"
        type: CHOICE
        section: "时间"
        choices {
            value: "24"
            label: "24 小时"
            localized_labels { key: "en" value: "24-hour" }
            localized_labels { key: "zh-TW" value: "24 小時" }
        }
        choices {
            value: "12"
            label: "12 小时"
            localized_labels { key: "en" value: "12-hour" }
            localized_labels { key: "zh-TW" value: "12 小時" }
        }
        text_default: "24"
        localized {
            key: "en"
            value { label: "Time format" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "時間制" section: "時間" }
        }
    }
    fields {
        id: "timezone"
        label: "时区"
        type: CHOICE
        section: "时间"
        choices {
            value: "local"
            label: "跟随系统时区"
            localized_labels { key: "en" value: "System time zone" }
            localized_labels { key: "zh-TW" value: "跟隨系統時區" }
        }
        choices {
            value: "utc"
            label: "UTC"
            localized_labels { key: "en" value: "UTC" }
            localized_labels { key: "zh-TW" value: "UTC" }
        }
        choices {
            value: "offset"
            label: "自定义 UTC 偏移"
            localized_labels { key: "en" value: "Custom UTC offset" }
            localized_labels { key: "zh-TW" value: "自定義 UTC 偏移" }
        }
        text_default: "local"
        localized {
            key: "en"
            value { label: "Time zone" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "時區" section: "時間" }
        }
    }
    fields {
        id: "utc_offset"
        label: "UTC 偏移（分钟）"
        type: INTEGER
        description: "选择自定义 UTC 偏移时生效。例如 UTC+8 为 480，支持半小时和四十五分钟时区。"
        section: "时间"
        minimum: -720.0
        maximum: 840.0
        step: 15.0
        integer_default: 480
        localized {
            key: "en"
            value { label: "UTC offset (minutes)" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value {
                label: "UTC 偏移（分鐘）"
                description: "選擇自定義 UTC 偏移時生效。例如 UTC+8 為 480，支援半小時和四十五分鐘時區。"
                section: "時間"
            }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒数 / 秒针"
        type: TOGGLE
        section: "时间"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds / second hand" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示秒數 / 秒針" section: "時間" }
        }
    }
    fields {
        id: "date"
        label: "显示日期"
        type: TOGGLE
        section: "信息"
        localized {
            key: "en"
            value { label: "Show date" description: "Affects only this instance." section: "Information" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示日期" section: "資訊" }
        }
    }
    fields {
        id: "weekday"
        label: "显示星期"
        type: TOGGLE
        section: "信息"
        localized {
            key: "en"
            value { label: "Show weekday" description: "Affects only this instance." section: "Information" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示星期" section: "資訊" }
        }
    }
    fields {
        id: "content_scale"
        label: "内容大小（%）"
        type: NUMBER
        section: "布局"
        minimum: 70.0
        maximum: 100.0
        step: 1.0
        number_default: 100.0
        localized {
            key: "en"
            value { label: "Content size (%)" description: "Affects only this instance." section: "Layout" }
        }
        localized {
            key: "zh-TW"
            value { label: "內容大小（%）" section: "佈局" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "外觀" }
        }
    }
    fields {
        id: "glow_strength"
        label: "辉光强度（%）"
        type: NUMBER
        section: "外观"
        maximum: 100.0
        step: 5.0
        number_default: 70.0
        localized {
            key: "en"
            value { label: "Glow strength (%)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "輝光強度（%）" section: "外觀" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 3891720703
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 3891720703
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "时间数字颜色"
        type: COLOR
        description: "时、分数字及相关点阵，不改变表面背景。"
        section: "外观"
        color_default: 376334591
        localized {
            key: "en"
            value {
                label: "Time digit color"
                description: "Hour/minute digits and their pixel forms; background color is separate."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "日期与星期颜色"
        type: COLOR
        description: "日期、星期和辅助分隔线。"
        section: "外观"
        color_default: 1552515583
        localized {
            key: "en"
            value {
                label: "Date and weekday color"
                description: "Date, weekday and supporting divider lines."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "秒数颜色"
        type: COLOR
        description: "开启秒显示时的秒数或小秒卡。"
        section: "外观"
        color_default: 3817954047
        localized {
            key: "en"
            value {
                label: "Seconds color"
                description: "Seconds readout or small seconds flap when seconds are shown."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Clock settings"
            description: "Settings are saved separately for each instance. Select a font and language below."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "時鐘設定" description: "只調整當前時鐘例項。尺寸由桌面網格決定，內容自動適配實際寬高。" }
    }
}
content_padding: 6.0
preview: "preview.png"
tags: "复古"
tags: "时钟"
