id: "com.cyberdesktop.music.player.2x2"
name: "音乐控制 2×2"
version: "1.0.1"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 6
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
capabilities: MEDIA_CONTROL
description: "控制本机音乐播放器，显示旋转唱片封面和歌曲信息；每个实例独立设置，局部刷新。"
settings_page {
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
    }
    title: "音乐控制设置"
    description: "选择正在运行的播放器；未开放的操作会自动禁用。每个实例独立保存。"
    fields {
        id: "player"
        label: "播放器"
        type: CHOICE
        section: "设置"
        choices {
            value: "auto"
            label: "自动选择"
            localized_labels { key: "en" value: "Automatic" }
            localized_labels { key: "zh-TW" value: "自動選擇" }
        }
        choices { value: "cyber_player" label: "CyberPlayer" }
        choices {
            value: "qqmusic"
            label: "QQ 音乐"
            localized_labels { key: "zh-TW" value: "QQ 音樂" }
        }
        choices {
            value: "cloudmusic"
            label: "网易云音乐"
            localized_labels { key: "en" value: "NetEase Music" }
            localized_labels { key: "zh-TW" value: "網易雲音樂" }
        }
        choices {
            value: "kugou"
            label: "酷狗音乐"
            localized_labels { key: "en" value: "Kugou Music" }
            localized_labels { key: "zh-TW" value: "酷狗音樂" }
        }
        choices {
            value: "spotify"
            label: "Spotify"
            localized_labels { key: "zh-TW" value: "Spotify" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Player" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "播放器" section: "設定" }
        }
    }
    fields {
        id: "show_progress"
        label: "显示播放进度"
        type: TOGGLE
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show progress" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示播放進度" section: "設定" }
        }
    }

    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "設定" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Music controls"
            description: "Select a running player. Unavailable controls are disabled. Settings are per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "音樂控制設定" description: "選擇正在執行的播放器；未開放的操作會自動禁用。每個例項獨立儲存。" }
    }

    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "外观"
        color_default: 4109039615
        localized {
            key: "en"
            value { label: "Background color" section: "Appearance" }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        section: "外观"
        text_default: "solid"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        localized {
            key: "en"
            value { label: "Background fill" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        section: "外观"
        color_default: 4109039615
        localized {
            key: "en"
            value { label: "Gradient end color" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        section: "外观"
        integer_default: 90
        minimum: 0
        maximum: 360
        step: 1
        localized {
            key: "en"
            value { label: "Gradient angle (°)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2186122751
        localized {
            key: "en"
            value { label: "Text color" section: "Appearance" }
        }
    }
    fields {
        id: "secondary"
        label: "次要文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2642454783
        localized {
            key: "en"
            value { label: "Secondary text color" section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "强调颜色"
        type: COLOR
        section: "外观"
        color_default: 3650770175
        localized {
            key: "en"
            value { label: "Accent color" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        integer_default: 12
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
}
preview: "preview.png"
tags: "简约"
tags: "音乐"
