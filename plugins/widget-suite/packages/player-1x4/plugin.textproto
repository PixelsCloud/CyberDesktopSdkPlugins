id: "com.cyberdesktop.music.player.1x4"
name: "音乐控制 4×1"
version: "1.0.1"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
capabilities: MEDIA_CONTROL
description: "控制本机音乐播放器，显示旋转唱片封面和歌曲信息；每个实例独立设置，局部刷新。"
settings_page {
    title: "音乐控制设置"
    description: "选择正在运行的播放器；未开放的操作会自动禁用。每个实例独立保存。"
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
    }
    fields {
        id: "player"
        label: "播放器"
        type: CHOICE
        section: "设置"
        choices {
            value: "auto"
            label: "自动选择"
            localized_labels { key: "en" value: "Automatic" }
            localized_labels { key: "zh-TW" value: "自動選擇" }
        }
        choices { value: "cyber_player" label: "CyberPlayer" }
        choices {
            value: "qqmusic"
            label: "QQ 音乐"
            localized_labels { key: "zh-TW" value: "QQ 音樂" }
        }
        choices {
            value: "cloudmusic"
            label: "网易云音乐"
            localized_labels { key: "en" value: "NetEase Music" }
            localized_labels { key: "zh-TW" value: "網易雲音樂" }
        }
        choices {
            value: "kugou"
            label: "酷狗音乐"
            localized_labels { key: "en" value: "Kugou Music" }
            localized_labels { key: "zh-TW" value: "酷狗音樂" }
        }
        choices {
            value: "spotify"
            label: "Spotify"
            localized_labels { key: "zh-TW" value: "Spotify" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Player" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "播放器" section: "設定" }
        }
    }
    fields {
        id: "show_progress"
        label: "显示播放进度"
        type: TOGGLE
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show progress" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示播放進度" section: "設定" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "設定" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4109039615
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4109039615
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "标题、唱臂与图标颜色"
        type: COLOR
        description: "歌曲标题、唱臂和播放控制图标使用此颜色。"
        section: "外观"
        color_default: 2186122751
        localized {
            key: "en"
            value {
                label: "Title, tonearm and icon color"
                description: "Song title, tonearm and playback-control icons."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "歌手与时间颜色"
        type: COLOR
        description: "歌手、专辑、来源、播放时间及唱臂轴心的颜色。"
        section: "外观"
        color_default: 2642454783
        localized {
            key: "en"
            value {
                label: "Artist and time color"
                description: "Artist, album, source, playback times and tonearm pivot."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "播放按钮与唱片标签颜色"
        type: COLOR
        description: "播放按钮底色、播放进度和唱片标签的强调部分。"
        section: "外观"
        color_default: 3650770175
        localized {
            key: "en"
            value {
                label: "Play button and record label color"
                description: "Play-button fill, playback progress and record-label details."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Music controls"
            description: "Select a running player. Unavailable controls are disabled. Settings are per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "音樂控制設定" description: "選擇正在執行的播放器；未開放的操作會自動禁用。每個例項獨立儲存。" }
    }
}
content_padding: 6.0
preview: "preview.png"
tags: "简约"
tags: "音乐"
