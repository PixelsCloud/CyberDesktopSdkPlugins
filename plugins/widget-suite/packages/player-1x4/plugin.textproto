id: "com.cyberdesktop.music.player.1x4"
name: "音乐控制 4×1"
version: "1.0.1"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
capabilities: MEDIA_CONTROL
description: "控制本机音乐播放器，显示旋转唱片封面和歌曲信息；每个实例独立设置，局部刷新。"
settings_page {
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
    }
    title: "音乐控制设置"
    description: "选择正在运行的播放器；未开放的操作会自动禁用。每个实例独立保存。"
    fields {
        id: "player"
        label: "播放器"
        type: CHOICE
        section: "设置"
        choices {
            value: "auto"
            label: "自动选择"
            localized_labels { key: "en" value: "Automatic" }
            localized_labels { key: "zh-TW" value: "自動選擇" }
        }
        choices { value: "cyber_player" label: "CyberPlayer" }
        choices {
            value: "qqmusic"
            label: "QQ 音乐"
            localized_labels { key: "zh-TW" value: "QQ 音樂" }
        }
        choices {
            value: "cloudmusic"
            label: "网易云音乐"
            localized_labels { key: "en" value: "NetEase Music" }
            localized_labels { key: "zh-TW" value: "網易雲音樂" }
        }
        choices {
            value: "kugou"
            label: "酷狗音乐"
            localized_labels { key: "en" value: "Kugou Music" }
            localized_labels { key: "zh-TW" value: "酷狗音樂" }
        }
        choices {
            value: "spotify"
            label: "Spotify"
            localized_labels { key: "zh-TW" value: "Spotify" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value { label: "Player" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "播放器" section: "設定" }
        }
    }
    fields {
        id: "show_progress"
        label: "显示播放进度"
        type: TOGGLE
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show progress" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示播放進度" section: "設定" }
        }
    }
    fields {
        id: "show_background"
        label: "显示卡片背景"
        type: TOGGLE
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show card background" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示卡片背景" section: "設定" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "设置"
        color_default: 388180991
        localized {
            key: "en"
            value { label: "Background color" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景顏色" section: "設定" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "设置"
        color_default: 3992385023
        localized {
            key: "en"
            value { label: "Text color" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "文字顏色" section: "設定" }
        }
    }
    fields {
        id: "accent"
        label: "按钮与进度颜色"
        type: COLOR
        section: "设置"
        color_default: 1273213951
        localized {
            key: "en"
            value { label: "Button and progress color" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "按鈕與進度顏色" section: "設定" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        section: "设置"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value { label: "Background corner radius (px)" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" section: "設定" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "设置"
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "設定" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "設定" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Music controls"
            description: "Select a running player. Unavailable controls are disabled. Settings are per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "音樂控制設定" description: "選擇正在執行的播放器；未開放的操作會自動禁用。每個例項獨立儲存。" }
    }
}
preview: "preview.png"
tags: "简约"
tags: "音乐"
