id: "com.cyberdesktop.calendar.2x4"
name: "日历 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x4"
    name: "4×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
description: "固定 4×2 格（宽×高），适配长方形和正方形格子；独立设置，局部刷新。"
settings_page {
    title: "日历 4×2设置"
    description: "每个实例独立保存。选择字体、语言和显示参数。"
    fields {
        id: "week_start"
        label: "每周起始日"
        type: CHOICE
        description: "只修改当前实例。"
        section: "设置"
        choices {
            value: "monday"
            label: "周一"
            localized_labels { key: "en" value: "Monday" }
            localized_labels { key: "zh-TW" value: "週一" }
        }
        choices {
            value: "sunday"
            label: "周日"
            localized_labels { key: "en" value: "Sunday" }
            localized_labels { key: "zh-TW" value: "週日" }
        }
        text_default: "monday"
        localized {
            key: "en"
            value { label: "Week starts on" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "每週起始日" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "background"
        label: "卡片底色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 4159891967
        localized {
            key: "en"
            value { label: "Card background" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "卡片底色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "accent"
        label: "今日强调色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 4185397759
        localized {
            key: "en"
            value { label: "Today highlight" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "今日強調色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "adjacent_days"
        label: "显示前后月日期"
        type: TOGGLE
        description: "只修改当前实例。"
        section: "设置"
        localized {
            key: "en"
            value { label: "Adjacent month days" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示前後月日期" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        description: "只修改当前实例。"
        section: "设置"
        max_length: 128
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        description: "只修改当前实例。"
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" description: "只修改當前例項。" section: "設定" }
        }
    }
    localized {
        key: "en"
        value { title: "Widget settings" description: "Settings are saved separately for each instance." }
    }
    localized {
        key: "zh-TW"
        value { title: "日曆 2×4設定" description: "每個例項獨立儲存。選擇字型、語言和顯示引數。" }
    }
}
preview: "preview.png"
tags: "简约"
tags: "日历"
