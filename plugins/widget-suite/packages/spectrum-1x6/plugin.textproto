id: "com.cyberdesktop.music.spectrum.1x6"
name: "音乐频谱 6×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x6"
    name: "6×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 6 max_cells: 6 max_columns: 6 max_rows: 1 }
capabilities: AUDIO_FFT
description: "固定 6×1 格（宽×高），适配长方形和正方形格子；独立设置，局部刷新。"
settings_page {
    title: "音乐频谱 6×1设置"
    description: "每个实例独立保存。选择字体、语言和显示参数。"
    fields {
        id: "gain"
        label: "灵敏度"
        type: NUMBER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 0.2
        maximum: 5.0
        step: 0.1
        number_default: 3.5
        localized {
            key: "en"
            value { label: "Sensitivity" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "靈敏度" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "release"
        label: "回落时间（ms）"
        type: INTEGER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 40.0
        maximum: 600.0
        step: 10.0
        integer_default: 160
        localized {
            key: "en"
            value { label: "Release (ms)" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "回落時間（ms）" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "peaks"
        label: "显示峰值"
        type: TOGGLE
        description: "只修改当前实例。"
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Peak indicators" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示峰值" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "color"
        label: "柱条底色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 298508287
        localized {
            key: "en"
            value { label: "Bar base color" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "柱條底色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "color_top"
        label: "柱条顶色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 1189720575
        localized {
            key: "en"
            value { label: "Bar top color" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "柱條頂色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "show_background"
        label: "显示卡片底板"
        type: TOGGLE
        description: "默认透明，露出桌面砖块。"
        section: "设置"
        localized {
            key: "en"
            value {
                label: "Show card background"
                description: "Transparent by default to reveal the desktop brick."
                section: "Settings"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示卡片底板" description: "預設透明，露出桌面磚塊。" section: "設定" }
        }
    }
    fields {
        id: "background"
        label: "卡片底色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 388115677
        localized {
            key: "en"
            value { label: "Card background" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "卡片底色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        description: "只修改当前实例。"
        section: "设置"
        max_length: 128
        text_default: "@siyuan-heavy"
        localized {
            key: "en"
            value { label: "Font" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        description: "只修改当前实例。"
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" description: "只修改當前例項。" section: "設定" }
        }
    }
    localized {
        key: "en"
        value { title: "Widget settings" description: "Settings are saved separately for each instance." }
    }
    localized {
        key: "zh-TW"
        value { title: "音樂頻譜 1×6設定" description: "每個例項獨立儲存。選擇字型、語言和顯示引數。" }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "科技"
tags: "音乐"
tags: "可视化"
tags: "透明"
