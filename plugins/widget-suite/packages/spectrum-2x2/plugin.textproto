id: "com.cyberdesktop.music.radial.2x2"
name: "环形频谱 2×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
capabilities: AUDIO_FFT
description: "固定 2×2 格（宽×高），适配长方形和正方形格子；独立设置，局部刷新。"
settings_page {
    title: "环形频谱 2×2设置"
    description: "每个实例独立保存。选择字体、语言和显示参数。"
    fields {
        id: "gain"
        label: "灵敏度"
        type: NUMBER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 0.2
        maximum: 5.0
        step: 0.1
        number_default: 3.5
        localized {
            key: "en"
            value { label: "Sensitivity" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "靈敏度" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "release"
        label: "回落时间（ms）"
        type: INTEGER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 40.0
        maximum: 600.0
        step: 10.0
        integer_default: 160
        localized {
            key: "en"
            value { label: "Release (ms)" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "回落時間（ms）" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "peaks"
        label: "显示峰值"
        type: TOGGLE
        description: "只修改当前实例。"
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Peak indicators" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示峰值" description: "只修改當前例項。" section: "設定" }
        }
    }

    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        description: "只修改当前实例。"
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" description: "只修改當前例項。" section: "設定" }
        }
    }
    localized {
        key: "en"
        value { title: "Widget settings" description: "Settings are saved separately for each instance." }
    }
    localized {
        key: "zh-TW"
        value { title: "環形頻譜 2×2設定" description: "每個例項獨立儲存。選擇字型、語言和顯示引數。" }
    }

    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "外观"
        color_default: 4042128639
        localized {
            key: "en"
            value { label: "Background color" section: "Appearance" }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        section: "外观"
        text_default: "solid"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        localized {
            key: "en"
            value { label: "Background fill" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        section: "外观"
        color_default: 4042128639
        localized {
            key: "en"
            value { label: "Gradient end color" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        section: "外观"
        integer_default: 90
        minimum: 0
        maximum: 360
        step: 1
        localized {
            key: "en"
            value { label: "Gradient angle (°)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "外观"
        color_default: 1716559615
        localized {
            key: "en"
            value { label: "Text color" section: "Appearance" }
        }
    }
    fields {
        id: "secondary"
        label: "次要文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2323425279
        localized {
            key: "en"
            value { label: "Secondary text color" section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "强调颜色"
        type: COLOR
        section: "外观"
        color_default: 3751377151
        localized {
            key: "en"
            value { label: "Accent color" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        integer_default: 12
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
}
content_padding: 6.0
preview: "preview.png"
tags: "科技"
tags: "音乐"
tags: "可视化"
tags: "透明"
