id: "com.cyberdesktop.mecha.beat.6x2"
name: "机甲 · 白隼音脉翼"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "6x2"
    name: "6×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 12 max_cells: 12 max_columns: 6 max_rows: 2 }
capabilities: AUDIO_FFT
description: "共享系统音频 FFT 驱动的独立装甲聚散、翼甲开合和能量接缝，无声时回归静止。"
settings_page {
    title: "机械频谱设置"
    fields {
        id: "gain"
        label: "灵敏度"
        type: NUMBER
        section: "频谱"
        minimum: 0.2
        maximum: 5.0
        step: 0.1
        number_default: 3.5
        localized {
            key: "en"
            value { label: "Sensitivity" }
        }
    }
    fields {
        id: "release"
        label: "衰减速度（毫秒）"
        type: INTEGER
        section: "频谱"
        minimum: 40.0
        maximum: 600.0
        step: 1.0
        integer_default: 160
        localized {
            key: "en"
            value { label: "Release (milliseconds)" }
        }
    }
    fields {
        id: "peaks"
        label: "峰值保持"
        type: TOGGLE
        section: "频谱"
        bool_default: true
        localized {
            key: "en"
            value { label: "Peak hold" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "频谱"
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "brightness"
        label: "亮度"
        type: NUMBER
        section: "显示"
        minimum: 30.0
        maximum: 100.0
        step: 1.0
        number_default: 100.0
        localized {
            key: "en"
            value { label: "Brightness" }
        }
    }
    fields {
        id: "glow"
        label: "柔和辉光"
        type: NUMBER
        section: "显示"
        maximum: 40.0
        step: 1.0
        number_default: 18.0
        localized {
            key: "en"
            value { label: "Soft glow" }
        }
    }
    fields {
        id: "color"
        label: "低段颜色"
        type: COLOR
        section: "配色"
        color_default: 3287081471
        localized {
            key: "en"
            value { label: "Lower zone" section: "Colors" }
        }
    }
    fields {
        id: "color_middle"
        label: "中段颜色"
        type: COLOR
        section: "配色"
        color_default: 3924749311
        localized {
            key: "en"
            value { label: "Middle zone" section: "Colors" }
        }
    }
    fields {
        id: "color_top"
        label: "高段颜色"
        type: COLOR
        section: "配色"
        color_default: 2446844671
        localized {
            key: "en"
            value { label: "Upper zone" section: "Colors" }
        }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "机甲"
