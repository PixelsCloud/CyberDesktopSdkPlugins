id: "com.cyberdesktop.mecha.lunar.4x4"
name: "机甲 · 农历 4×4"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "4x4"
    name: "4×4（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 16 max_cells: 16 max_columns: 4 max_rows: 4 }
description: "独立机械农历；离线双历、节气与传统节日，保留透明留白。"
settings_page {
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "減少動態" section: "外觀" }
        }
    }
    title: "机械农历设置"
    fields {
        id: "week_start"
        label: "每周开始"
        type: CHOICE
        section: "日历"
        choices {
            value: "monday"
            label: "星期一"
            localized_labels { key: "zh-TW" value: "星期一" }
        }
        choices {
            value: "sunday"
            label: "星期日"
            localized_labels { key: "zh-TW" value: "星期日" }
        }
        text_default: "monday"
        localized {
            key: "en"
            value { label: "Week Starts On" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "每週開始" section: "日曆" }
        }
    }
    fields {
        id: "adjacent_days"
        label: "显示相邻月份"
        type: TOGGLE
        section: "日历"
        bool_default: false
        localized {
            key: "en"
            value { label: "Show Adjacent Months" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示相鄰月份" section: "日曆" }
        }
    }
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Settings language" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "外觀" }
        }
    }
}
preview: "preview.png"

tags: "机甲"
