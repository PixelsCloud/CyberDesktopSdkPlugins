id: "com.cyberdesktop.calendar.lunar.2x2"
name: "农历 2×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
description: "离线农历、节气与传统节日；暖白与石墨双主题，按实例保存设置。"
settings_page {
    title: "农历设置"
    description: "支持 1900—2100 年。点击月份标题返回今天，箭头切月份，双击任意处回到今天；月历可点选日期。"
    fields {
        id: "lighting"
        label: "昼夜模式"
        type: CHOICE
        section: "外观"
        choices {
            value: "theme"
            label: "跟随桌面主题"
            localized_labels { key: "zh-TW" value: "跟隨桌面主題" }
        }
        choices {
            value: "day"
            label: "白天"
            localized_labels { key: "zh-TW" value: "白天" }
        }
        choices {
            value: "night"
            label: "黑夜"
            localized_labels { key: "zh-TW" value: "黑夜" }
        }
        text_default: "theme"
        localized {
            key: "en"
            value { label: "Lighting" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "晝夜模式" section: "外觀" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示背景" section: "外觀" }
        }
    }
    fields {
        id: "week_start"
        label: "每周开始"
        type: CHOICE
        section: "日历"
        choices {
            value: "monday"
            label: "星期一"
            localized_labels { key: "zh-TW" value: "星期一" }
        }
        choices {
            value: "sunday"
            label: "星期日"
            localized_labels { key: "zh-TW" value: "星期日" }
        }
        text_default: "monday"
        localized {
            key: "en"
            value { label: "Week Starts On" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "每週開始" section: "日曆" }
        }
    }
    fields {
        id: "adjacent_days"
        label: "显示相邻月份"
        type: TOGGLE
        section: "日历"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show Adjacent Months" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示相鄰月份" section: "日曆" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角" section: "外觀" }
        }
    }
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Settings language" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "外觀" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Lunar Calendar Settings"
            description: "Supports years 1900—2100. Click the month title to return to today, use arrows to change months, double-click anywhere to return to today; dates on the monthly calendar are selectable."
        }
    }
    localized {
        key: "zh-TW"
        value {
            title: "農曆設定"
            description: "支援 1900—2100 年。點選月份標題返回今天，箭頭切月份，雙擊任意處回到今天；月曆可點選日期。"
        }
    }
}
preview: "preview.png"
tags: "简约"
tags: "日历"
