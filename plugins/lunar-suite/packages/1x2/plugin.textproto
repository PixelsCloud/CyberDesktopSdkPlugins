id: "com.cyberdesktop.calendar.lunar.1x2"
name: "农历 2×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x2"
    name: "2×1（宽×高）"
    cells {}
    cells { a: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 2 max_cells: 2 max_columns: 2 max_rows: 1 }
description: "离线农历、节气与传统节日；暖白与石墨双主题，按实例保存设置。"
settings_page {
    title: "农历设置"
    description: "支持 1900—2100 年。点击月份标题返回今天，箭头切月份，双击任意处回到今天；月历可点选日期。"
    fields {
        id: "lighting"
        label: "昼夜模式"
        type: CHOICE
        section: "外观"
        choices {
            value: "theme"
            label: "跟随桌面主题"
            localized_labels { key: "zh-TW" value: "跟隨桌面主題" }
        }
        choices {
            value: "day"
            label: "白天"
            localized_labels { key: "zh-TW" value: "白天" }
        }
        choices {
            value: "night"
            label: "黑夜"
            localized_labels { key: "zh-TW" value: "黑夜" }
        }
        text_default: "theme"
        localized {
            key: "en"
            value { label: "Lighting" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "晝夜模式" section: "外觀" }
        }
    }
    fields {
        id: "week_start"
        label: "每周开始"
        type: CHOICE
        section: "日历"
        choices {
            value: "monday"
            label: "星期一"
            localized_labels { key: "zh-TW" value: "星期一" }
        }
        choices {
            value: "sunday"
            label: "星期日"
            localized_labels { key: "zh-TW" value: "星期日" }
        }
        text_default: "monday"
        localized {
            key: "en"
            value { label: "Week Starts On" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "每週開始" section: "日曆" }
        }
    }
    fields {
        id: "adjacent_days"
        label: "显示相邻月份"
        type: TOGGLE
        section: "日历"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show Adjacent Months" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示相鄰月份" section: "日曆" }
        }
    }
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Settings language" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "外觀" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4293978623
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4293978623
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "农历日期颜色"
        type: COLOR
        description: "农历日期与主要日历文字。"
        section: "外观"
        color_default: 3025487359
        localized {
            key: "en"
            value {
                label: "Lunar date color"
                description: "Lunar date and primary calendar text."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "宜忌与说明颜色"
        type: COLOR
        description: "宜忌、节气和辅助说明。"
        section: "外观"
        color_default: 2860216575
        localized {
            key: "en"
            value {
                label: "Almanac caption color"
                description: "Almanac details, solar terms and supporting captions."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "节日与日期标记颜色"
        type: COLOR
        description: "节日、重要日期和日历操作标记。"
        section: "外观"
        color_default: 849254143
        localized {
            key: "en"
            value {
                label: "Holiday and date marker color"
                description: "Holidays, significant dates and calendar controls."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Lunar Calendar Settings"
            description: "Supports years 1900—2100. Click the month title to return to today, use arrows to change months, double-click anywhere to return to today; dates on the monthly calendar are selectable."
        }
    }
    localized {
        key: "zh-TW"
        value {
            title: "農曆設定"
            description: "支援 1900—2100 年。點選月份標題返回今天，箭頭切月份，雙擊任意處回到今天；月曆可點選日期。"
        }
    }
}
content_padding: 6.0
preview: "preview.png"
tags: "简约"
tags: "日历"
