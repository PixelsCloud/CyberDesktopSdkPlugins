id: "com.cyberdesktop.hourglass.pixel.1x2"
name: "电子像素沙漏 2×1"
version: "1.2.1"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x2"
    name: "2×1（宽×高）"
    cells {}
    cells { a: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 2 max_cells: 2 max_columns: 2 max_rows: 1 }
capabilities: BACKGROUND_COMPUTE
description: "像素沙粒流动与堆积，电子倒计时，自动翻转循环，支持昼夜主题与透明背景。"
settings_page {
    title: "电子像素沙漏设置"
    description: "点击左侧沙漏重置，点击右侧计时区暂停或继续。拖动卡片不触发点击。"
    fields {
        id: "physics"
        label: "物理沙粒"
        type: TOGGLE
        description: "真实碰撞和堆积，倒计时控制出砂量。切换后重新开始；关闭使用经典像素动画。"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Physical grains"
                description: "Real collisions and piles with timed metering. Switching restarts the timer; disable for classic pixel animation."
            }
        }
        localized {
            key: "zh-TW"
            value { label: "物理沙粒" description: "真實碰撞與堆積，倒數計時控制出砂量。切換後重新開始。" }
        }
    }
    fields {
        id: "duration"
        label: "每轮时长（秒）"
        type: INTEGER
        description: "调整时长会重新开始。默认 30 秒，可设置为 5 秒到 1 小时。"
        section: "沙漏"
        minimum: 5.0
        maximum: 3600.0
        step: 5.0
        integer_default: 30
        localized {
            key: "en"
            value {
                label: "Duration per round (seconds)"
                description: "Adjusting the duration will restart. Default is 30 seconds, can be set from 5 seconds to 1 hour."
                section: "Hourglass"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "每輪時長（秒）"
                description: "調整時長會重新開始。預設 30 秒，可設定為 5 秒到 1 小時。"
                section: "沙漏"
            }
        }
    }
    fields {
        id: "repeat"
        label: "自动翻转循环"
        type: TOGGLE
        description: "关闭后沙粒流完即停止；点击卡片可以重新开始。"
        section: "沙漏"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Auto flip loop"
                description: "When off, the hourglass stops when the sand runs out; click the card to restart."
                section: "Hourglass"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "自動翻轉迴圈" description: "關閉後沙粒流完即停止；點選卡片可以重新開始。" section: "沙漏" }
        }
    }
    fields {
        id: "running"
        label: "启用流动"
        type: TOGGLE
        section: "沙漏"
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable flow" section: "Hourglass" }
        }
        localized {
            key: "zh-TW"
            value { label: "啟用流動" section: "沙漏" }
        }
    }
    fields {
        id: "lighting"
        label: "昼夜模式"
        type: CHOICE
        section: "外观"
        choices {
            value: "theme"
            label: "跟随桌面主题"
            localized_labels { key: "zh-TW" value: "跟隨桌面主題" }
        }
        choices {
            value: "day"
            label: "白天"
            localized_labels { key: "zh-TW" value: "白天" }
        }
        choices {
            value: "night"
            label: "黑夜"
            localized_labels { key: "zh-TW" value: "黑夜" }
        }
        text_default: "theme"
        localized {
            key: "en"
            value { label: "Day/Night Mode" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "晝夜模式" section: "外觀" }
        }
    }
    fields {
        id: "show_timer"
        label: "显示倒计时"
        type: TOGGLE
        description: "关闭后沙漏居中显示；点击左侧重置、右侧暂停或继续。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show countdown"
                description: "When closed, the hourglass is displayed in the center; click left to reset, right to pause or resume."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "顯示倒計時"
                description: "關閉後沙漏居中顯示；點選左側重置、右側暫停或繼續。"
                section: "外觀"
            }
        }
    }
    fields {
        id: "glow"
        label: "像素发光强度"
        type: INTEGER
        section: "外观"
        maximum: 100.0
        step: 5.0
        integer_default: 35
        localized {
            key: "en"
            value { label: "Pixel glow intensity" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "畫素發光強度" section: "外觀" }
        }
    }
    fields {
        id: "frame_rate"
        label: "动画帧率"
        type: CHOICE
        description: "默认 20 帧，只刷新当前桌面控件区域。隐藏或手动暂停时停止定时器。"
        section: "动画"
        choices {
            value: "15"
            label: "15 FPS"
            localized_labels { key: "zh-TW" value: "15 FPS" }
        }
        choices {
            value: "20"
            label: "20 FPS"
            localized_labels { key: "zh-TW" value: "20 FPS" }
        }
        choices {
            value: "30"
            label: "30 FPS"
            localized_labels { key: "zh-TW" value: "30 FPS" }
        }
        text_default: "20"
        localized {
            key: "en"
            value {
                label: "Animation frame rate"
                description: "默认 20 帧，只刷新当前桌面控件区域。隐藏或手动暂停时停止定时器。"
                section: "Animation"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "動畫幀率"
                description: "預設 20 幀，只重新整理當前桌面小工具區域。隱藏或手動暫停時停止定時器。"
                section: "動畫"
            }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4294171135
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4294171135
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "沙粒与倒计时颜色"
        type: COLOR
        description: "主要沙粒和倒计时点阵数字。"
        section: "外观"
        color_default: 2556502015
        localized {
            key: "en"
            value {
                label: "Sand and timer color"
                description: "Primary sand grains and pixel timer digits."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "计时说明颜色"
        type: COLOR
        description: "计时说明和相关操作文字。"
        section: "外观"
        color_default: 2693027839
        localized {
            key: "en"
            value { label: "Timer caption color" description: "Timer captions and action text." section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "沙粒高光与框架颜色"
        type: COLOR
        description: "下落沙粒、高光沙粒与沙漏边框。"
        section: "外观"
        color_default: 849188351
        localized {
            key: "en"
            value {
                label: "Sand highlight and frame color"
                description: "Falling/highlighted grains and the hourglass frame."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Digital Pixel Hourglass Settings"
            description: "Click the hourglass on the left to reset, click the timing area on the right to pause or resume. Dragging the card does not trigger a click."
        }
    }
    localized {
        key: "zh-TW"
        value {
            title: "電子畫素沙漏設定"
            description: "點選左側沙漏重置，點選右側計時區暫停或繼續。拖動卡片不觸發點選。"
        }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "host.background" version: 1 }
tags: "物理"
tags: "计时"
