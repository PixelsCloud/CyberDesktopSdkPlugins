cmake_minimum_required(VERSION 3.21)
foreach(required SOURCE_DIRECTORY ASSET_DIRECTORY BUILD_ROOT LAYOUT KIND)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
cmake_path(ABSOLUTE_PATH ASSET_DIRECTORY NORMALIZE OUTPUT_VARIABLE target)
cmake_path(ABSOLUTE_PATH BUILD_ROOT NORMALIZE OUTPUT_VARIABLE root)
cmake_path(IS_PREFIX root "${target}" NORMALIZE inside_build)
if(NOT inside_build OR NOT target MATCHES "/assets$")
  message(FATAL_ERROR "Physics material staging must remain in a build assets directory")
endif()
set(materials "chassis-${LAYOUT}.png" steel-marble.png)
if(KIND STREQUAL "clock")
  list(APPEND materials precision-gear.png clock-window.png)
elseif(KIND STREQUAL "beat")
  list(APPEND materials piston-base.png piston-cap.png paddle.png bumper.png launcher.png)
else()
  message(FATAL_ERROR "Unknown physics material family")
endif()
file(MAKE_DIRECTORY "${target}")
file(GLOB old_pngs "${target}/*.png")
foreach(old IN LISTS old_pngs)
  cmake_path(GET old FILENAME filename)
  if(NOT filename IN_LIST materials)
    file(REMOVE "${old}")
  endif()
endforeach()
foreach(filename IN LISTS materials)
  file(COPY_FILE "${SOURCE_DIRECTORY}/${filename}" "${target}/${filename}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${SOURCE_DIRECTORY}/provenance-${LAYOUT}.json" "${target}/provenance.json" ONLY_IF_DIFFERENT)
file(COPY_FILE "${SOURCE_DIRECTORY}/NOTICE.txt" "${target}/NOTICE.txt" ONLY_IF_DIFFERENT)
