id: "com.cyberdesktop.physics.windchime.2x2"
name: "悬挂风铃 2×2"
version: "1.2.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
capabilities: BACKGROUND_COMPUTE
description: "拖动挂件，松手自然回摆；双击轻拨。支持昼夜主题、透明背景、暂停和减少动态。"
settings_page {
    title: "悬挂风铃 2×2"
    description: "拖动挂件，松手自然回摆；双击轻拨。支持昼夜主题、透明背景、暂停和减少动态。"
    fields {
        id: "speed"
        label: "运动速度"
        type: NUMBER
        minimum: 0.25
        maximum: 2.0
        step: 0.05
        number_default: 0.75
        localized {
            key: "en"
            value { label: "Motion speed" }
        }
    }
    fields {
        id: "wind"
        label: "微风强度"
        type: NUMBER
        maximum: 1.0
        step: 0.05
        number_default: 0.35
        localized {
            key: "en"
            value { label: "Breeze strength" }
        }
    }
    fields {
        id: "running"
        label: "启用摆动"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4294171135
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4294171135
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "横梁与小挂件颜色"
        type: COLOR
        description: "横梁和较小的摆动挂件。"
        section: "外观"
        color_default: 2556502015
        localized {
            key: "en"
            value {
                label: "Rail and small pendant color"
                description: "Top rail and smaller moving pendants."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "悬线颜色"
        type: COLOR
        description: "连接横梁与挂件的线条。"
        section: "外观"
        color_default: 2693027839
        localized {
            key: "en"
            value { label: "String color" description: "Lines connecting the rail and pendants." section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "大挂件颜色"
        type: COLOR
        description: "较大的摆动挂件，不是文字颜色。"
        section: "外观"
        color_default: 849188351
        localized {
            key: "en"
            value {
                label: "Large pendant color"
                description: "Larger moving pendants, not text."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Wind Chime 2x2"
            description: "Drag and release. Double-click to pluck. Motion pauses while hidden."
        }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "host.background" version: 1 }
tags: "卡通"
tags: "物理"
tags: "互动"
