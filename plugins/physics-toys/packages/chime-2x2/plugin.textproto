id: "com.cyberdesktop.physics.windchime.2x2"
name: "悬挂风铃 2×2"
version: "1.2.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
capabilities: BACKGROUND_COMPUTE
required_services { id: "host.background" version: 1 }
description: "拖动挂件，松手自然回摆；双击轻拨。支持昼夜主题、透明背景、暂停和减少动态。"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
settings_page {
    title: "悬挂风铃 2×2"
    description: "拖动挂件，松手自然回摆；双击轻拨。支持昼夜主题、透明背景、暂停和减少动态。"
    fields {
        id: "speed"
        label: "运动速度"
        type: NUMBER
        minimum: 0.25
        maximum: 2
        step: 0.05
        number_default: 0.75
        localized {
            key: "en"
            value { label: "Motion speed" }
        }
    }
    fields {
        id: "wind"
        label: "微风强度"
        type: NUMBER
        minimum: 0
        maximum: 1
        step: 0.05
        number_default: 0.35
        localized {
            key: "en"
            value { label: "Breeze strength" }
        }
    }

    fields {
        id: "running"
        label: "启用摆动"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }

    localized {
        key: "en"
        value {
            title: "Wind Chime 2x2"
            description: "Drag and release. Double-click to pluck. Motion pauses while hidden."
        }
    }

    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "外观"
        color_default: 4294171135
        localized {
            key: "en"
            value { label: "Background color" section: "Appearance" }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        section: "外观"
        text_default: "solid"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        localized {
            key: "en"
            value { label: "Background fill" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        section: "外观"
        color_default: 4294171135
        localized {
            key: "en"
            value { label: "Gradient end color" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        section: "外观"
        integer_default: 90
        minimum: 0
        maximum: 360
        step: 1
        localized {
            key: "en"
            value { label: "Gradient angle (°)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2556502015
        localized {
            key: "en"
            value { label: "Text color" section: "Appearance" }
        }
    }
    fields {
        id: "secondary"
        label: "次要文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2693027839
        localized {
            key: "en"
            value { label: "Secondary text color" section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "强调颜色"
        type: COLOR
        section: "外观"
        color_default: 849188351
        localized {
            key: "en"
            value { label: "Accent color" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        integer_default: 12
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
}
content_padding: 6
preview: "preview.png"
tags: "卡通"
tags: "物理"
tags: "互动"
