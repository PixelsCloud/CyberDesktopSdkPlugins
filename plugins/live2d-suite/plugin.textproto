id: "com.cyberdesktop.live2d"
name: "Live2D 互动角色"
version: "1.3.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
description: "内置 Mao、Haru、Hiyori、Wanko 和鲸鱼娘，鼠标跟随、点击切换动作、自动轮播待机，支持自定义模型。"
required_services { id: "render.live2d" version: 1 }
footprint_rules { topology: RECT min_cells: 4 max_cells: 42 max_columns: 6 max_rows: 7 }
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    topology: RECT
    allowed_rotations: 0
    is_default: true
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
}
layouts {
    id: "3x3"
    name: "3×3（宽×高）"
    topology: RECT
    allowed_rotations: 0
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 0 b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
}
