    allowed_rotations: 0
}
layouts {
    id: "6x7"
    name: "6×7（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 4 b: 2 }
    cells { a: 5 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
