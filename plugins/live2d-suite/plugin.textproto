    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { b: 4 }
    cells { a: 1 b: 4 }
    cells { a: 2 b: 4 }
    cells { a: 3 b: 4 }
