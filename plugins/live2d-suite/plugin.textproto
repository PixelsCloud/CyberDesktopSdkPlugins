id: "com.cyberdesktop.live2d"
name: "Live2D 互动角色"
version: "1.3.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
layouts {
    id: "3x3"
    name: "3×3（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { b: 1 }
