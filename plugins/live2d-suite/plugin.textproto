    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { a: 4 b: 3 }
    cells { b: 4 }
    cells { a: 1 b: 4 }
    cells { a: 2 b: 4 }
    cells { a: 3 b: 4 }
    cells { a: 4 b: 4 }
    cells { b: 5 }
    cells { a: 1 b: 5 }
    cells { a: 2 b: 5 }
    cells { a: 3 b: 5 }
    cells { a: 4 b: 5 }
    allowed_rotations: 0
}
