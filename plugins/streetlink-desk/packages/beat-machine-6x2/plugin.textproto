id: "com.cyberdesktop.streetlink.beat-machine.6x2"
name: "STREETLINK · 多通道声波工作站"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "6x2"
    name: "6×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 12 max_cells: 12 max_columns: 6 max_rows: 2 }
capabilities: AUDIO_FFT
description: "系统音频驱动双腔粒子碰撞和实时频谱；静音后平滑衰减。"
settings_page {
    title: "多通道声波工作站"
    description: "系统音频驱动双腔粒子碰撞和实时频谱；静音后平滑衰减。"
    fields {
        id: "show_background"
        label: "显示底板"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show backplate" }
        }
    }
    fields {
        id: "gain"
        label: "响应强度"
        type: NUMBER
        minimum: 0.25
        maximum: 5.0
        step: 0.05
        number_default: 3.5
        localized {
            key: "en"
            value { label: "Sensitivity" }
        }
    }
    fields {
        id: "balls"
        label: "钢珠数量"
        type: CHOICE
        choices { value: "24" label: "24" }
        choices { value: "36" label: "36" }
        choices { value: "48" label: "48" }
        text_default: "36"
        localized {
            key: "en"
            value { label: "Marbles" }
        }
    }
    fields {
        id: "running"
        label: "启用滚珠动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable physical motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    localized {
        key: "en"
        value {
            title: "STREETLINK"
            description: "Audio-driven particle chambers and live spectrum. Smooth decay after silence."
        }
    }
}
content_padding: 0.0
preview: "preview.png"
required_services { id: "audio.spectrum" version: 1 }
tags: "赛博朋克"
tags: "金属"
tags: "仪表"
tags: "STREETLINK"
