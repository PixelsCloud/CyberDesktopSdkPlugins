id: "com.cyberdesktop.streetlink.plant.1x1"
name: "STREETLINK · 微型生物电池"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x1"
    name: "1×1（宽×高）"
    cells {}
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 1 max_cells: 1 max_columns: 1 max_rows: 1 }
description: "卡通植物、浇水反馈、观赏与轻养成、昼夜主题。"
settings_page {
    title: "卡通盆栽设置"
    fields {
        id: "lighting"
        label: "昼夜模式"
        type: CHOICE
        section: "外观与行为"
        choices {
            value: "theme"
            label: "跟随桌面主题"
            localized_labels { key: "zh-TW" value: "跟隨桌面主題" }
        }
        choices {
            value: "day"
            label: "白天"
            localized_labels { key: "zh-TW" value: "白天" }
        }
        choices {
            value: "night"
            label: "黑夜"
            localized_labels { key: "zh-TW" value: "黑夜" }
        }
        text_default: "theme"
        localized {
            key: "en"
            value { label: "Day/Night Mode" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "晝夜模式" section: "外觀與行為" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观与行为"
        localized {
            key: "en"
            value { label: "Show Background" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示背景" section: "外觀與行為" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观与行为"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value { label: "Background Corner Radius" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角" section: "外觀與行為" }
        }
    }
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "外观与行为"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Set Language" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "外觀與行為" }
        }
    }
    fields {
        id: "animation"
        label: "启用动画"
        type: TOGGLE
        section: "外观与行为"
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable animation" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "啟用動畫" section: "外觀與行為" }
        }
    }
    fields {
        id: "speed"
        label: "动效速度"
        type: NUMBER
        description: "默认 0.75 倍；调整速度保持动作连续。"
        section: "外观与行为"
        minimum: 0.25
        maximum: 2.0
        step: 0.25
        number_default: 0.75
        localized {
            key: "en"
            value {
                label: "Animation Speed"
                description: "Default 0.75×; adjusting speed keeps actions continuous."
                section: "Appearance and Behavior"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "動效速度" description: "預設 0.75 倍；調整速度保持動作連續。" section: "外觀與行為" }
        }
    }
    fields {
        id: "frame_rate"
        label: "动画帧率"
        type: CHOICE
        section: "外观与行为"
        choices {
            value: "15"
            label: "15 FPS"
            localized_labels { key: "zh-TW" value: "15 FPS" }
        }
        choices {
            value: "20"
            label: "20 FPS"
            localized_labels { key: "zh-TW" value: "20 FPS" }
        }
        choices {
            value: "30"
            label: "30 FPS"
            localized_labels { key: "zh-TW" value: "30 FPS" }
        }
        text_default: "20"
        localized {
            key: "en"
            value { label: "Animation frame rate" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "動畫幀率" section: "外觀與行為" }
        }
    }
    fields {
        id: "species"
        label: "植物品种"
        type: CHOICE
        section: "外观与行为"
        choices {
            value: "pothos"
            label: "绿萝"
            localized_labels { key: "zh-TW" value: "綠蘿" }
        }
        choices {
            value: "succulent"
            label: "多肉"
            localized_labels { key: "zh-TW" value: "多肉" }
        }
        choices {
            value: "daisy"
            label: "小雏菊"
            localized_labels { key: "zh-TW" value: "小雛菊" }
        }
        text_default: "pothos"
        localized {
            key: "en"
            value { label: "Plant Variety" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "植物品種" section: "外觀與行為" }
        }
    }
    fields {
        id: "mode"
        label: "养成方式"
        type: CHOICE
        description: "观赏模式直接显示成株；轻养成约七天长成，浇水可促进成长。"
        section: "外观与行为"
        choices {
            value: "ornamental"
            label: "观赏模式"
            localized_labels { key: "zh-TW" value: "觀賞模式" }
        }
        choices {
            value: "grow"
            label: "轻养成"
            localized_labels { key: "zh-TW" value: "輕養成" }
        }
        text_default: "ornamental"
        localized {
            key: "en"
            value {
                label: "Cultivation Method"
                description: "Viewing mode shows the mature plant directly; light cultivation takes about seven days to grow, watering can promote growth."
                section: "Appearance and Behavior"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "養成方式"
                description: "觀賞模式直接顯示成株；輕養成約七天長成，澆水可促進成長。"
                section: "外觀與行為"
            }
        }
    }
    fields {
        id: "garden"
        label: "显示小花园"
        type: TOGGLE
        description: "2×4 显示三盆植物，浇水同时作用于小花园。"
        section: "外观与行为"
        localized {
            key: "en"
            value {
                label: "Show Small Garden"
                description: "2×4 displays three potted plants, watering affects the small garden at the same time."
                section: "Appearance and Behavior"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示小花園" description: "2×4 顯示三盆植物，澆水同時作用於小花園。" section: "外觀與行為" }
        }
    }
    fields {
        id: "show_info"
        label: "显示名称与状态"
        type: TOGGLE
        section: "外观与行为"
        localized {
            key: "en"
            value { label: "Show Name and Status" section: "Appearance and Behavior" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示名稱與狀態" section: "外觀與行為" }
        }
    }
    localized {
        key: "en"
        value { title: "Cartoon Potted Plant Settings" }
    }
    localized {
        key: "zh-TW"
        value { title: "卡通盆栽設定" }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "赛博朋克"
tags: "STREETLINK"
