id: "com.cyberdesktop.streetlink.clock.spring.4x1"
name: "STREETLINK · 磁浮数字匣"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "显示时、分、秒，变化的数字每秒弹动；拖动数字牌，松手自然回弹。精密金属零件独立运动，支持暂停和减少动态。"
settings_page {
    title: "机械弹簧数字时钟 4×1"
    description: "显示时、分、秒，变化的数字每秒弹动；拖动数字牌，松手自然回弹。精密金属零件独立运动，支持暂停和减少动态。"
    fields {
        id: "speed"
        label: "运动速度"
        type: NUMBER
        minimum: 0.25
        maximum: 2.0
        step: 0.05
        number_default: 0.75
        localized {
            key: "en"
            value { label: "Motion speed" }
        }
    }
    fields {
        id: "running"
        label: "启用摆动"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "twelve_hour"
        label: "12 小时制"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "12-hour time" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Mechanical Spring Clock 4x1"
            description: "HH:MM:SS with a bounce each second. Drag and release a digit card. Motion pauses while hidden."
        }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "赛博朋克"
tags: "STREETLINK"
