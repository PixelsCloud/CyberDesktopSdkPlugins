id: "com.cyberdesktop.streetlink.clock.lcd.4x1"
name: "STREETLINK · 低功耗城市时码条"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "液晶七段显示，柔和电子背光；4×1 格（宽×高），支持正方及竖向长方形格子。"
settings_page {
    title: "时钟设置"
    description: "只调整当前时钟实例。尺寸由桌面网格决定，内容自动适配实际宽高。"
    fields {
        id: "format"
        label: "时间制"
        type: CHOICE
        section: "时间"
        choices {
            value: "24"
            label: "24 小时"
            localized_labels { key: "en" value: "24-hour" }
            localized_labels { key: "zh-TW" value: "24 小時" }
        }
        choices {
            value: "12"
            label: "12 小时"
            localized_labels { key: "en" value: "12-hour" }
            localized_labels { key: "zh-TW" value: "12 小時" }
        }
        text_default: "24"
        localized {
            key: "en"
            value { label: "Time format" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "時間制" section: "時間" }
        }
    }
    fields {
        id: "timezone"
        label: "时区"
        type: CHOICE
        section: "时间"
        choices {
            value: "local"
            label: "跟随系统时区"
            localized_labels { key: "en" value: "System time zone" }
            localized_labels { key: "zh-TW" value: "跟隨系統時區" }
        }
        choices {
            value: "utc"
            label: "UTC"
            localized_labels { key: "en" value: "UTC" }
            localized_labels { key: "zh-TW" value: "UTC" }
        }
        choices {
            value: "offset"
            label: "自定义 UTC 偏移"
            localized_labels { key: "en" value: "Custom UTC offset" }
            localized_labels { key: "zh-TW" value: "自定義 UTC 偏移" }
        }
        text_default: "local"
        localized {
            key: "en"
            value { label: "Time zone" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "時區" section: "時間" }
        }
    }
    fields {
        id: "utc_offset"
        label: "UTC 偏移（分钟）"
        type: INTEGER
        description: "选择自定义 UTC 偏移时生效。例如 UTC+8 为 480，支持半小时和四十五分钟时区。"
        section: "时间"
        minimum: -720.0
        maximum: 840.0
        step: 15.0
        integer_default: 480
        localized {
            key: "en"
            value { label: "UTC offset (minutes)" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value {
                label: "UTC 偏移（分鐘）"
                description: "選擇自定義 UTC 偏移時生效。例如 UTC+8 為 480，支援半小時和四十五分鐘時區。"
                section: "時間"
            }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒数 / 秒针"
        type: TOGGLE
        section: "时间"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds / second hand" description: "Affects only this instance." section: "Time" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示秒數 / 秒針" section: "時間" }
        }
    }
    fields {
        id: "date"
        label: "显示日期"
        type: TOGGLE
        section: "信息"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show date" description: "Affects only this instance." section: "Information" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示日期" section: "資訊" }
        }
    }
    fields {
        id: "weekday"
        label: "显示星期"
        type: TOGGLE
        section: "信息"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show weekday" description: "Affects only this instance." section: "Information" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示星期" section: "資訊" }
        }
    }
    fields {
        id: "theme_colors"
        label: "文字跟随桌面主题"
        type: TOGGLE
        section: "外观"
        localized {
            key: "en"
            value { label: "Use desktop theme colors" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "文字跟隨桌面主題" section: "外觀" }
        }
    }
    fields {
        id: "text_color"
        label: "自定义文字 / 指针"
        type: COLOR
        description: "关闭跟随桌面主题后生效。"
        section: "外观"
        color_default: 658394623
        localized {
            key: "en"
            value { label: "Text and hands" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "自定義文字 / 指標" description: "關閉跟隨桌面主題後生效。" section: "外觀" }
        }
    }
    fields {
        id: "secondary_color"
        label: "自定义日期 / 星期"
        type: COLOR
        description: "关闭跟随桌面主题后生效。"
        section: "外观"
        color_default: 1921421567
        localized {
            key: "en"
            value { label: "Date and weekday color" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "自定義日期 / 星期" description: "關閉跟隨桌面主題後生效。" section: "外觀" }
        }
    }
    fields {
        id: "seconds_color"
        label: "辉光颜色"
        type: COLOR
        section: "外观"
        color_default: 1385934079
        localized {
            key: "en"
            value { label: "Glow color" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "輝光顏色" section: "外觀" }
        }
    }
    fields {
        id: "content_scale"
        label: "内容大小（%）"
        type: NUMBER
        section: "布局"
        minimum: 70.0
        maximum: 100.0
        step: 1.0
        number_default: 100.0
        localized {
            key: "en"
            value { label: "Content size (%)" description: "Affects only this instance." section: "Layout" }
        }
        localized {
            key: "zh-TW"
            value { label: "內容大小（%）" section: "佈局" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    fields {
        id: "font_family"
        label: "字体（日期 / 星期）"
        type: FONT
        section: "外观"
        max_length: 128
        text_default: "Chakra Petch"
        localized {
            key: "en"
            value {
                label: "Font (date / weekday)"
                description: "Digits retain the seven-segment or LED matrix design."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "字型（日期 / 星期）" section: "外觀" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "外觀" }
        }
    }
    fields {
        id: "card_color"
        label: "屏幕底色"
        type: COLOR
        section: "外观"
        color_default: 3621638399
        localized {
            key: "en"
            value { label: "Display background" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "螢幕底色" section: "外觀" }
        }
    }
    fields {
        id: "glow_strength"
        label: "辉光强度（%）"
        type: NUMBER
        section: "外观"
        maximum: 100.0
        step: 5.0
        number_default: 70.0
        localized {
            key: "en"
            value { label: "Glow strength (%)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "輝光強度（%）" section: "外觀" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Clock settings"
            description: "Settings are saved separately for each instance. Select a font and language below."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "時鐘設定" description: "只調整當前時鐘例項。尺寸由桌面網格決定，內容自動適配實際寬高。" }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "赛博朋克"
tags: "STREETLINK"
