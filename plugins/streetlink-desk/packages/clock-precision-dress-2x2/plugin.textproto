id: "com.cyberdesktop.streetlink.clock.precision.dress.2x2"
name: "STREETLINK · 月轨授时仪"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
description: "暖白盘、玫瑰金柳叶指针和实时天文月相，经典正装表风格。"
settings_page {
    title: "玫瑰金月相表"
    description: "只调整当前实例。日期、时区和走时跟随系统；隐藏后停止刷新，恢复时直接校准。"
    fields {
        id: "motion"
        label: "走秒方式"
        type: CHOICE
        choices {
            value: "sweep"
            label: "流畅扫秒"
            localized_labels { key: "en" value: "Smooth sweep" }
        }
        choices {
            value: "beat"
            label: "机械微步（每秒八步）"
            localized_labels { key: "en" value: "Eight beats per second" }
        }
        choices {
            value: "tick"
            label: "每秒跳动"
            localized_labels { key: "en" value: "One tick per second" }
        }
        text_default: "beat"
        localized {
            key: "en"
            value { label: "Seconds motion" }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒针"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds hand" }
        }
    }
    fields {
        id: "background"
        label: "显示方形机壳"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show square case" }
        }
    }
    fields {
        id: "detail"
        label: "显示实时月相"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show moon phase" }
        }
    }
    fields {
        id: "animation"
        label: "启用动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态效果"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Rose Gold Moonphase Clock"
            description: "Settings affect this instance only. Follows system time and time zone; hidden clocks stop callbacks."
        }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "赛博朋克"
tags: "STREETLINK"
