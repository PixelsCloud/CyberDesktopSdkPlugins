id: "com.cyberdesktop.streetlink.clock.brick.4x1"
name: "STREETLINK · 激光蚀刻时序墙"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "扁平砖墙上的凹雕时分秒。只重刻变化的数字，Box2D 砖屑随重力下落、碰撞和堆积。双击重播雕刻。"
settings_page {
    title: "砖刻时钟"
    description: "24 小时时分秒。数字变化时局部凿刻，砖屑落到下沿后淡出。隐藏时暂停，恢复时直接校准当前时间。"
    fields {
        id: "palette"
        label: "砖墙配色"
        type: CHOICE
        choices {
            value: "clay"
            label: "暖陶红"
            localized_labels { key: "en" value: "Warm clay" }
        }
        choices {
            value: "sand"
            label: "浅砂岩"
            localized_labels { key: "en" value: "Sandstone" }
        }
        choices {
            value: "slate"
            label: "深岩灰"
            localized_labels { key: "en" value: "Slate" }
        }
        text_default: "clay"
        localized {
            key: "en"
            value { label: "Wall palette" }
        }
    }
    fields {
        id: "animate"
        label: "雕刻与碎屑动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Carving and debris animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "debris_count"
        label: "每个数字的碎屑数量"
        type: INTEGER
        minimum: 8.0
        maximum: 20.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value { label: "Chips per changed digit" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Brick-carved Clock"
            description: "A 24-hour carved brick clock. Only changed digits are carved. Box2D chips fall and settle on the ledge. Double-click to replay."
        }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "赛博朋克"
tags: "STREETLINK"
