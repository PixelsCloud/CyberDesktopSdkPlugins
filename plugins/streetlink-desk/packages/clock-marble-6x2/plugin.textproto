id: "com.cyberdesktop.streetlink.clock.marble.6x2"
name: "STREETLINK · 城市同步中枢"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "6x2"
    name: "6×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 12 max_cells: 12 max_columns: 6 max_rows: 2 }
capabilities: AUDIO_FFT
description: "每秒增加粒子并显示时间；系统音频驱动粒子和实时频谱，静音后频谱归零。"
settings_page {
    title: "城市同步中枢"
    description: "每秒增加粒子并显示时间；系统音频驱动粒子和实时频谱，静音后频谱归零。"
    fields {
        id: "show_background"
        label: "显示底板"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show backplate" }
        }
    }
    fields {
        id: "running"
        label: "启用滚珠动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable physical motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields { id: "gain" label: "音乐灵敏度" type: NUMBER minimum: 0.25 maximum: 5.0 step: 0.1 number_default: 3.5 }
    localized {
        key: "en"
        value { title: "STREETLINK" description: "One particle per second. Drag particles; double-click to reset." }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "赛博朋克"
tags: "金属"
tags: "仪表"
tags: "STREETLINK"
