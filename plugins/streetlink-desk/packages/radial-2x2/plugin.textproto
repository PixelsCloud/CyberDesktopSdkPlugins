id: "com.cyberdesktop.streetlink.radial.2x2"
name: "STREETLINK · 声场矢量核"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
capabilities: AUDIO_FFT
description: "独立机械环形频谱；黄铜滑杆由实时音频驱动，保留峰值与自然回落。"
settings_page {
    title: "机械频谱设置"
    fields { id: "gain" label: "灵敏度" type: NUMBER minimum: 0.2 maximum: 5.0 step: 0.1 number_default: 3.5 }
    fields {
        id: "release"
        label: "回落时间（ms）"
        type: INTEGER
        minimum: 40.0
        maximum: 600.0
        step: 10.0
        integer_default: 160
    }
    fields { id: "peaks" label: "显示峰值" type: TOGGLE bool_default: true }
}
content_padding: 0.0
preview: "preview.png"
required_services { id: "audio.spectrum" version: 1 }
tags: "赛博朋克"
tags: "STREETLINK"
