id: "com.cyberdesktop.neon.sign"
name: "像素霓虹招牌"
version: "1.2.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
preview: "preview.png"
content_padding: 0
description: "CyberDesktop 像素赛博招牌：青蓝洋红霓虹、破损灯珠、掉漆金属和间歇闪烁。"
footprint_rules { topology: RECT min_cells: 6 max_cells: 12 max_columns: 6 max_rows: 2 }
layouts {
    id: "2x6"
    name: "6×2（宽×高）"
    topology: RECT
    allowed_rotations: 0
    is_default: true
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 4 b: 0 }
    cells { a: 5 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
}
layouts {
    id: "1x6"
    name: "6×1（宽×高）"
    topology: RECT
    allowed_rotations: 0
    is_default: false
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 4 b: 0 }
    cells { a: 5 b: 0 }
}
settings_page {
    fields {
        id: "effect"
        label: "动画效果"
        type: CHOICE
        text_default: "mixed"
        localized {
            key: "en"
            value { label: "Animation effect" }
        }
        localized {
            key: "zh-TW"
            value { label: "動畫效果" }
        }
        choices {
            value: "flicker"
            label: "接触不良"
            localized_labels { key: "en" value: "Faulty contact" }
            localized_labels { key: "zh-TW" value: "接觸不良" }
        }
        choices {
            value: "breathe"
            label: "霓虹呼吸"
            localized_labels { key: "en" value: "Neon breathing" }
            localized_labels { key: "zh-TW" value: "霓虹呼吸" }
        }
        choices {
            value: "scan"
            label: "流光扫过"
            localized_labels { key: "en" value: "Light sweep" }
            localized_labels { key: "zh-TW" value: "流光掃過" }
        }
        choices {
            value: "wave"
            label: "灯光波浪"
            localized_labels { key: "en" value: "Light wave" }
            localized_labels { key: "zh-TW" value: "燈光波浪" }
        }
        choices {
            value: "glitch"
            label: "信号故障"
            localized_labels { key: "en" value: "Signal glitch" }
            localized_labels { key: "zh-TW" value: "訊號故障" }
        }
        choices {
            value: "mixed"
            label: "赛博混合"
            localized_labels { key: "en" value: "Cyber mix" }
            localized_labels { key: "zh-TW" value: "賽博混合" }
        }
    }
    fields {
        id: "speed"
        label: "动画速度"
        type: NUMBER
        minimum: 0.25
        maximum: 2
        step: 0.25
        number_default: 1.25
        localized {
            key: "en"
            value { label: "Animation speed" }
        }
        localized {
            key: "zh-TW"
            value { label: "動畫速度" }
        }
    }
    fields {
        id: "intensity"
        label: "动画强度"
        type: INTEGER
        minimum: 0
        maximum: 100
        step: 1
        integer_default: 65
        localized {
            key: "en"
            value { label: "Animation intensity" }
        }
        localized {
            key: "zh-TW"
            value { label: "動畫強度" }
        }
    }

    title: "像素霓虹招牌设置"
    localized {
        key: "en"
        value { title: "Pixel Neon Sign" }
    }
    localized {
        key: "zh-TW"
        value { title: "像素霓虹招牌設定" }
    }
    fields {
        id: "animation"
        label: "启用动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable animation" }
        }
        localized {
            key: "zh-TW"
            value { label: "啟用動畫" }
        }
    }
    fields {
        id: "damage"
        label: "破损程度"
        type: INTEGER
        minimum: 0
        maximum: 100
        step: 1
        integer_default: 90
        localized {
            key: "en"
            value { label: "Damage" }
        }
        localized {
            key: "zh-TW"
            value { label: "破損程度" }
        }
    }
    fields {
        id: "brightness"
        label: "灯光亮度"
        type: INTEGER
        minimum: 10
        maximum: 100
        step: 1
        integer_default: 85
        localized {
            key: "en"
            value { label: "Brightness" }
        }
        localized {
            key: "zh-TW"
            value { label: "燈光亮度" }
        }
    }
    fields {
        id: "glow"
        label: "发光强度"
        type: INTEGER
        minimum: 0
        maximum: 100
        step: 1
        integer_default: 65
        localized {
            key: "en"
            value { label: "Glow" }
        }
        localized {
            key: "zh-TW"
            value { label: "發光強度" }
        }
    }
    fields {
        id: "plate"
        label: "显示金属底板"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Metal backing plate" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示金屬底板" }
        }
    }
    fields {
        id: "pink"
        label: "Cyber 灯光颜色"
        type: COLOR
        color_default: 0xFF3FADFF
        localized {
            key: "en"
            value { label: "Cyber neon color" }
        }
        localized {
            key: "zh-TW"
            value { label: "Cyber 燈光顏色" }
        }
    }
    fields {
        id: "cyan"
        label: "Desktop 灯光颜色"
        type: COLOR
        color_default: 0x35E8FFFF
        localized {
            key: "en"
            value { label: "Desktop neon color" }
        }
        localized {
            key: "zh-TW"
            value { label: "Desktop 燈光顏色" }
        }
    }
}
tags: "简约"
