id: "com.cyberdesktop.songyun.calendar.4x2"
name: "宋韵 · 月历 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "4x2"
    name: "4×2（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
description: "拉丝钢机框、年月字轮与完整月视图，支持翻月和独立配色。"
settings_page {
    title: "宋韵月历设置"
    description: "左右按钮翻月，双击日历返回本月；拖动不会触发按钮。每个实例独立保存。"
    fields {
        id: "week_start"
        label: "每周起始日"
        type: CHOICE
        section: "日历"
        text_default: "sunday"
        choices { value: "monday" label: "周一" }
        choices { value: "sunday" label: "周日" }
    }
    fields { id: "adjacent_days" label: "显示前后月日期" type: TOGGLE section: "日历" }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "文字"
        text_default: "zh-CN"
        choices { value: "zh-CN" label: "简体中文" }
        choices { value: "zh-TW" label: "繁體中文" }
        choices { value: "en" label: "English" }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "动画"
        description: "关闭翻月时的字轮滚动，直接显示目标月份。"
    }
}
preview: "preview.png"

tags: "宋"
