id: "com.cyberdesktop.clock.brick.1x4"
name: "砖刻时钟 4×1"
version: "1.0.1"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "1x4"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
capabilities: BACKGROUND_COMPUTE
description: "扁平砖墙上的凹雕时分秒。只重刻变化的数字，Box2D 砖屑随重力下落、碰撞和堆积。双击重播雕刻。"
settings_page {
    title: "砖刻时钟"
    description: "24 小时时分秒。数字变化时局部凿刻，砖屑落到下沿后淡出。隐藏时暂停，恢复时直接校准当前时间。"
    fields {
        id: "animate"
        label: "雕刻与碎屑动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Carving and debris animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "debris_count"
        label: "每个数字的碎屑数量"
        type: INTEGER
        minimum: 8.0
        maximum: 20.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value { label: "Chips per changed digit" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "砖墙颜色"
        type: COLOR
        description: "砖墙的主体颜色，渐变模式下作为起点颜色。"
        section: "外观"
        color_default: 4293978623
        localized {
            key: "en"
            value {
                label: "Brick wall color"
                description: "Base brick-wall color, or the start of its gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4293978623
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "数字切口与砖缝颜色"
        type: COLOR
        description: "砖块数字的切口、碎屑与砖缝明暗由此颜色派生。"
        section: "外观"
        color_default: 3025487359
        localized {
            key: "en"
            value {
                label: "Digit cuts and mortar color"
                description: "Digit cuts, chips and mortar shading are derived from this color."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value {
            title: "Brick-carved Clock"
            description: "A 24-hour carved brick clock. Only changed digits are carved. Box2D chips fall and settle on the ledge. Double-click to replay."
        }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "host.background" version: 1 }
tags: "简约"
tags: "时钟"
