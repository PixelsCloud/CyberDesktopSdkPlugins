id: "com.cyberdesktop.vampire.alice.calendar.4x2"
name: "吸血鬼.Alice · 月历 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "4x2"
    name: "4×2（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
description: "吸血鬼.Alice 系列，支持当前实例独立设置。"
settings_page {
    title: "吸血鬼.Alice · 月历 4×2设置"
    description: "左右按钮翻月，双击日历返回本月；拖动不会触发按钮。每个实例独立保存。"
    fields {
        id: "week_start"
        label: "每周起始日"
        type: CHOICE
        section: "日历"
        text_default: "monday"
        choices { value: "monday" label: "周一" }
        choices { value: "sunday" label: "周日" }
    }
    fields { id: "adjacent_days" label: "显示前后月日期" type: TOGGLE section: "日历" }
    fields { id: "accent" label: "今日强调色" type: COLOR section: "配色" color_default: 4039606015 }
    fields { id: "weekday_color" label: "工作日文字" type: COLOR section: "配色" color_default: 4293909503 }
    fields { id: "weekend_color" label: "周末文字" type: COLOR section: "配色" color_default: 3919671039 }
    fields { id: "tile_color" label: "日期格底色" type: COLOR section: "配色" color_default: 606480127 }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "文字"
        max_length: 128
        text_default: "Microsoft YaHei"
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "文字"
        text_default: "zh-CN"
        choices { value: "zh-CN" label: "简体中文" }
        choices { value: "zh-TW" label: "繁體中文" }
        choices { value: "en" label: "English" }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "动画"
        description: "关闭翻月时的字轮滚动，直接显示目标月份。"
    }
}
preview: "preview.png"

tags: "吸血鬼"
tags: "Alice"
