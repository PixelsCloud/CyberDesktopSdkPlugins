id: "com.cyberdesktop.vampire.alice.album.4x2"
name: "吸血鬼.Alice · 相册 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x4"
    name: "4×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
description: "吸血鬼.Alice 系列，支持当前实例独立设置。"
settings_page {
    title: "吸血鬼.Alice · 相册 4×2设置"
    description: "每个实例独立保存。选择字体、语言和显示参数。"
    fields {
        id: "directory"
        label: "图片目录"
        type: TEXT
        description: "留空使用系统 Pictures 目录。JPG、PNG、BMP、GIF、TIFF；其他格式取决于系统 WIC 解码器。"
        section: "设置"
        max_length: 2048
        localized {
            key: "en"
            value {
                label: "Photo directory"
                description: "Empty uses the Windows Pictures folder. Other image formats depend on installed WIC codecs."
                section: "Settings"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "圖片目錄"
                description: "留空使用系統 Pictures 目錄。JPG、PNG、BMP、GIF、TIFF；其他格式取決於系統 WIC 解碼器。"
                section: "設定"
            }
        }
        text_editor: DIRECTORY
    }
    fields {
        id: "recursive"
        label: "包含子目录"
        type: TOGGLE
        description: "只修改当前实例。"
        section: "设置"
        localized {
            key: "en"
            value { label: "Include subfolders" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "包含子目錄" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "interval"
        label: "切换间隔（秒）"
        type: INTEGER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 2.0
        maximum: 300.0
        step: 1.0
        integer_default: 8
        localized {
            key: "en"
            value { label: "Slide interval (seconds)" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "切換間隔（秒）" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "transition"
        label: "淡入时间（秒）"
        type: NUMBER
        description: "只修改当前实例。"
        section: "设置"
        maximum: 2.0
        step: 0.05
        number_default: 0.45
        localized {
            key: "en"
            value { label: "Crossfade (seconds)" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "淡入時間（秒）" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "fit"
        label: "图片缩放"
        type: CHOICE
        description: "只修改当前实例。"
        section: "设置"
        choices {
            value: "cover"
            label: "铺满并居中裁切"
            localized_labels { key: "en" value: "Fill and crop" }
            localized_labels { key: "zh-TW" value: "鋪滿並居中裁切" }
        }
        choices {
            value: "contain"
            label: "完整显示"
            localized_labels { key: "en" value: "Fit entire image" }
            localized_labels { key: "zh-TW" value: "完整顯示" }
        }
        text_default: "cover"
        localized {
            key: "en"
            value { label: "Image fit" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "圖片縮放" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "counter"
        label: "显示图片计数"
        type: TOGGLE
        description: "只修改当前实例。"
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Photo counter" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示圖片計數" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "photo_motion"
        label: "照片缓动"
        type: TOGGLE
        bool_default: true
        section: "设置"
        description: "轻微缩放和平移，仅刷新相册；暂停轮播或隐藏时停止。完整显示模式会保留整张照片。"
        localized {
            key: "en"
            value { label: "Gentle photo motion" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "照片緩動" section: "設定" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态效果"
        type: TOGGLE
        section: "设置"
        description: "停止照片缓动，同时遵循 Windows 的动画设置。"
        localized {
            key: "en"
            value { label: "Reduce motion" section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "減少動態效果" section: "設定" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        description: "只修改当前实例。"
        section: "设置"
        max_length: 128
        text_default: "Microsoft YaHei UI"
        localized {
            key: "en"
            value { label: "Font" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        description: "只修改当前实例。"
        section: "设置"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" description: "只修改當前例項。" section: "設定" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Vampire.Alice · Widget settings"
            description: "Settings are saved separately for each instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "吸血鬼.Alice · 相簿 4×2設定" description: "每個例項獨立儲存。選擇字型、語言和顯示引數。" }
    }
}
preview: "preview.png"

tags: "吸血鬼"
tags: "Alice"

capabilities: MEDIA_LIBRARY
required_services { id: "media.library" version: 1 }
