id: "com.cyberdesktop.vampire.alice.marble.clock.4x2"
name: "吸血鬼.Alice · 滚珠轨道时钟 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
description: "吸血鬼.Alice 系列，支持当前实例独立设置。"
layouts {
    id: "4x2"
    name: "4×2（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
settings_page {
    title: "吸血鬼.Alice · 滚珠轨道时钟 4×2设置"
    description: "点击投珠器补球；点击金色转轴开仓；拖动滚珠并松手。隐藏和校时后直接同步，不补播离线动画。"
    fields {
        id: "theme"
        label: "外观"
        type: CHOICE
        text_default: "dark"
        choices {
            value: "dark"
            label: "深色机械"
            localized_labels { key: "en" value: "Dark" }
        }
        choices {
            value: "light"
            label: "浅色机械"
            localized_labels { key: "en" value: "Light" }
        }
        choices {
            value: "system"
            label: "跟随系统"
            localized_labels { key: "en" value: "System" }
        }
        localized {
            key: "en"
            value { label: "Appearance" }
        }
    }
    fields {
        id: "show_background"
        label: "显示底板"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show backplate" }
        }
    }
    fields {
        id: "running"
        label: "启用滚珠动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable physical motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Vampire.Alice · Rolling Marble Clock"
            description: "Release a marble every second and empty the bin each minute. Click the dispenser or hinge; drag a marble to play."
        }
    }
}
content_padding: 0
preview: "preview.png"

tags: "吸血鬼"
tags: "Alice"
