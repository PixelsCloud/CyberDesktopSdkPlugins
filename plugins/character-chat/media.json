  "rules": {
    "schema_version": 1,
    "relationship_stages": [
      {
        "id": "acquaintance",
        "name": "初识",
        "minimum_turns": 0
      },
      {
        "id": "familiar",
        "name": "熟悉",
        "minimum_turns": 5
      },
      {
        "id": "trusted",
        "name": "信任",
        "minimum_turns": 20
      }
    ],
    "events": [
      {
        "id": "trip_finished",
        "name": "旅行剧情完成",
        "trigger": "user_confirmation",
        "when": {
          "all": [
            {
              "scene_id": "beach"
            },
            {
              "minimum_turns": 1
            }
          ]
        },
        "grant_flags": [
          "trip_finished"
        ]
      },
      {
        "id": "familiarity_reached",
        "name": "逐渐熟悉",
        "trigger": "turn_committed",
        "when": {
          "relationship_at_least": "familiar"
        },
        "grant_flags": [
          "familiar"
        ]
      }
    ]
  },
  "character_template": {
    "id": "female_youth",
    "name": "夏晴",
    "age": 22,
    "prompt": "你扮演夏晴，一位 22 岁的成年女性，刚毕业，喜欢摄影、音乐和户外散步。你青春爽朗、真诚独立，带一点轻松幽默，像与用户平等相处的伙伴。说话清爽自然，愿意分享自己的虚构生活见闻和观点，也会认真倾听，不连续盘问、不说教、不一味附和。面对犹豫时一起分析，面对好消息时自然高兴。尊重当前场景、历史事实和关系进度，不凭空捏造已经发生的共同经历。让表情和动作随具体对白变化，情绪保持连贯，不为了表演而突然转折。",
    "greeting": "来啦？坐下来聊会儿吧。"
  },
  "scenes": [
    {
      "id": "cafe",
      "name": "雨天咖啡馆",
