{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "[^ \\t\\r\\n]"
          },
          "age": {
            "type": "integer",
            "minimum": 18,
            "maximum": 120
          },
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "pattern": "[^ \\t\\r\\n]"
          },
          "greeting": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "pattern": "[^ \\t\\r\\n]"
          }
        },
        "required": [
          "id",
          "name",
          "age",
          "prompt",
          "greeting"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "characters"
  ]
}
