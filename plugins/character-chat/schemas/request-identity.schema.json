{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character chat request identity v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "instance_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "branch_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "character_version": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "state_version": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
  },
  "required": ["schema_version", "instance_id", "session_id", "branch_id", "candidate_id", "request_id", "generation", "character_version", "state_version"]
}
