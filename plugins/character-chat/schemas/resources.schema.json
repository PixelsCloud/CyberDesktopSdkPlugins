{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "character_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "portrait_layers": {
      "type": "object", "additionalProperties": false,
      "required": ["base_asset", "faces"],
      "properties": {
        "base_asset": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "faces": {
          "type": "object", "minProperties": 1, "maxProperties": 8,
          "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,64}$"},
          "additionalProperties": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "usages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "expression",
                "pose",
                "background",
                "media"
              ]
            }
          },
          "type": {
            "enum": [
              "image",
              "video"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          },
          "emotion": {
            "enum": [
              "neutral",
              "happy",
              "sad",
              "angry",
              "shy",
              "surprised",
              "worried",
              "thoughtful"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "id",
          "file",
          "usages",
          "type",
          "sha256",
          "width",
          "height",
          "bytes"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "character_id",
    "assets"
  ]
}
