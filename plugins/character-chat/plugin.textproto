id: "com.cyberdesktop.character-chat"
name: "虚拟人物聊天"
version: "0.1.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 6
preview: "preview.png"
description: "虚拟人物情景聊天，支持用户自己的 DeepSeek API 和离线演示。"
layouts {
    id: "6x4"
    name: "6×4（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 4 b: 0 }
    cells { a: 5 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    cells { a: 0 b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 4 b: 2 }
    cells { a: 5 b: 2 }
    cells { a: 0 b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { a: 4 b: 3 }
    cells { a: 5 b: 3 }
    allowed_rotations: 0
    is_default: true
}
layouts {
    id: "4x5"
    name: "4×5（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 0 b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 0 b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { a: 0 b: 4 }
    cells { a: 1 b: 4 }
    cells { a: 2 b: 4 }
    cells { a: 3 b: 4 }
    allowed_rotations: 0
}
layouts {
    id: "6x6"
    name: "6×6（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 4 b: 0 }
    cells { a: 5 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    cells { a: 0 b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 4 b: 2 }
    cells { a: 5 b: 2 }
    cells { a: 0 b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { a: 4 b: 3 }
    cells { a: 5 b: 3 }
    cells { a: 0 b: 4 }
    cells { a: 1 b: 4 }
    cells { a: 2 b: 4 }
    cells { a: 3 b: 4 }
    cells { a: 4 b: 4 }
    cells { a: 5 b: 4 }
    cells { a: 0 b: 5 }
    cells { a: 1 b: 5 }
    cells { a: 2 b: 5 }
    cells { a: 3 b: 5 }
    cells { a: 4 b: 5 }
    cells { a: 5 b: 5 }
    allowed_rotations: 0
}
footprint_rules { min_cells: 20 max_cells: 36 max_columns: 6 max_rows: 6 }
required_services { id: "ai.character_chat" version: 1 }
required_services { id: "ui.text_input" version: 1 }
required_services { id: "render.character_images" version: 1 }
required_services { id: "render.character_images.versioned" version: 1 }
settings_page {
    title: "虚拟人物聊天"
    description: "表情和动作读取当前角色资源或 Live2D 模型；各角色分别保存人物演出设置。"
    fields { id: "offline" label: "离线演示" type: TOGGLE bool_default: true }
    fields { id: "story" label: "剧情节奏" type: TOGGLE bool_default: true }
    fields {
        id: "expression"
        label: "当前立绘的表情（跟随对话或手动预览）"
        type: CHOICE
        text_default: "auto"
        choices { value: "auto" label: "跟随对话" }
    }
    fields {
        id: "pose"
        label: "当前立绘的动作（跟随对话或手动预览）"
        type: CHOICE
        text_default: "auto"
        choices { value: "auto" label: "跟随对话" }
    }
    fields {
        id: "renderer"
        label: "人物演出"
        type: CHOICE
        text_default: "image"
        choices { value: "image" label: "图片立绘" }
        choices { value: "mao" label: "Mao · Live2D 示例" }
        choices { value: "haru" label: "Haru · Live2D 示例" }
    }
    fields {
        id: "model_directory"
        label: "自选 Live2D 模型目录（留空使用示例）"
        type: TEXT
        text_editor: DIRECTORY
        max_length: 4096
    }
    fields {
        id: "fps"
        label: "Live2D 帧率"
        type: CHOICE
        text_default: "30"
        choices { value: "30" label: "30 FPS（省资源）" }
        choices { value: "60" label: "60 FPS（更流畅）" }
    }

    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show background" section: "Appearance" }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        section: "外观"
        color_default: 4243386879
        localized {
            key: "en"
            value { label: "Background color" section: "Appearance" }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        section: "外观"
        text_default: "solid"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        localized {
            key: "en"
            value { label: "Background fill" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        section: "外观"
        color_default: 4243386879
        localized {
            key: "en"
            value { label: "Gradient end color" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        section: "外观"
        integer_default: 90
        minimum: 0
        maximum: 360
        step: 1
        localized {
            key: "en"
            value { label: "Gradient angle (°)" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2739894271
        localized {
            key: "en"
            value { label: "Text color" section: "Appearance" }
        }
    }
    fields {
        id: "secondary"
        label: "次要文字颜色"
        type: COLOR
        section: "外观"
        color_default: 2810221567
        localized {
            key: "en"
            value { label: "Secondary text color" section: "Appearance" }
        }
    }
    fields {
        id: "accent"
        label: "强调颜色"
        type: COLOR
        section: "外观"
        color_default: 3382328831
        localized {
            key: "en"
            value { label: "Accent color" section: "Appearance" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        section: "外观"
        integer_default: 12
        minimum: 0
        maximum: 32
        step: 1
        localized {
            key: "en"
            value { label: "Corner radius" section: "Appearance" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value { label: "Font" section: "Appearance" }
        }
    }
}
tags: "二次元"
tags: "互动"
