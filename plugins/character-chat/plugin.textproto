id: "com.cyberdesktop.character-chat"
name: "虚拟人物聊天"
version: "0.1.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "6x4"
    name: "6×4（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 4 b: 2 }
    cells { a: 5 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { a: 4 b: 3 }
    cells { a: 5 b: 3 }
    allowed_rotations: 0
    is_default: true
}
layouts {
    id: "4x5"
    name: "4×5（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { b: 4 }
    cells { a: 1 b: 4 }
    cells { a: 2 b: 4 }
    cells { a: 3 b: 4 }
    allowed_rotations: 0
}
layouts {
    id: "6x6"
    name: "6×6（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { a: 4 b: 1 }
    cells { a: 5 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { a: 4 b: 2 }
    cells { a: 5 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    cells { a: 4 b: 3 }
    cells { a: 5 b: 3 }
    cells { b: 4 }
    cells { a: 1 b: 4 }
    cells { a: 2 b: 4 }
    cells { a: 3 b: 4 }
    cells { a: 4 b: 4 }
    cells { a: 5 b: 4 }
    cells { b: 5 }
    cells { a: 1 b: 5 }
    cells { a: 2 b: 5 }
    cells { a: 3 b: 5 }
    cells { a: 4 b: 5 }
    cells { a: 5 b: 5 }
    allowed_rotations: 0
}
footprint_rules { min_cells: 20 max_cells: 36 max_columns: 6 max_rows: 6 }
description: "虚拟人物情景聊天，支持用户自己的 DeepSeek API 和离线演示。"
settings_page {
    title: "虚拟人物聊天"
    description: "表情和动作读取当前角色资源或 Live2D 模型；各角色分别保存人物演出设置。"
    fields { id: "offline" label: "离线演示" type: TOGGLE bool_default: true }
    fields { id: "story" label: "剧情节奏" type: TOGGLE bool_default: true }
    fields {
        id: "expression"
        label: "当前立绘的表情（跟随对话或手动预览）"
        type: CHOICE
        choices { value: "auto" label: "跟随对话" }
        text_default: "auto"
    }
    fields {
        id: "pose"
        label: "当前立绘的动作（跟随对话或手动预览）"
        type: CHOICE
        choices { value: "auto" label: "跟随对话" }
        text_default: "auto"
    }
    fields {
        id: "renderer"
        label: "人物演出"
        type: CHOICE
        choices { value: "image" label: "图片立绘" }
        choices { value: "mao" label: "Mao · Live2D 示例" }
        choices { value: "haru" label: "Haru · Live2D 示例" }
        text_default: "image"
    }
    fields {
        id: "model_directory"
        label: "自选 Live2D 模型目录（留空使用示例）"
        type: TEXT
        max_length: 4096
        text_editor: DIRECTORY
    }
    fields {
        id: "fps"
        label: "Live2D 帧率"
        type: CHOICE
        choices { value: "30" label: "30 FPS（省资源）" }
        choices { value: "60" label: "60 FPS（更流畅）" }
        text_default: "30"
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 4243386879
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 4243386879
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "对话与输入文字颜色"
        type: COLOR
        description: "对话内容、输入框、状态说明及相关操作图标。"
        section: "外观"
        color_default: 2739894271
        localized {
            key: "en"
            value {
                label: "Chat and input text color"
                description: "Conversation, text editor, status messages and related action icons."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "角色名称颜色"
        type: COLOR
        description: "对话区域顶部的角色名称，不改变角色图片。"
        section: "外观"
        color_default: 3382328831
        localized {
            key: "en"
            value {
                label: "Character name color"
                description: "Character name above the conversation; does not recolor character images."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "ai.character_chat" version: 1 }
required_services { id: "ui.text_input" version: 1 }
required_services { id: "render.character_images" version: 1 }
required_services { id: "render.character_images.versioned" version: 1 }
tags: "二次元"
tags: "互动"
