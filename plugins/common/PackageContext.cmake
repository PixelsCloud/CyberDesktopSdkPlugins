include_guard(DIRECTORY)
include("${CMAKE_CURRENT_LIST_DIR}/SdkTool.cmake")
get_filename_component(CD_PLUGIN_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT TARGET cd_plugin_package_tool)
    cd_plugin_sdk_tool(cd_plugin_package_tool CD_PLUGIN_SDK_LICENSE)
else()
    get_property(CD_PLUGIN_SDK_LICENSE GLOBAL PROPERTY CD_PLUGIN_SDK_NOTICE)
endif()
set_property(GLOBAL PROPERTY CD_PLUGIN_SDK_NOTICE "${CD_PLUGIN_SDK_LICENSE}")
foreach(component tweeny yoga box2d fastnoiselite)
    string(TOUPPER "${component}" upper)
    cd_plugin_canvas_license(${component} CD_PLUGIN_${upper}_LICENSE)
endforeach()
