include("${CMAKE_CURRENT_LIST_DIR}/Families.cmake")
set(requested ${CD_PLUGIN_FAMILIES})
if(CD_PLUGIN_IDS)
    if(NOT CD_PLUGIN_FAMILIES STREQUAL "ALL")
        message(FATAL_ERROR "Select either CD_PLUGIN_IDS or CD_PLUGIN_FAMILIES, not both")
    endif()
    set(requested)
    foreach(id IN LISTS CD_PLUGIN_IDS)
        set(found FALSE)
        foreach(family IN LISTS CD_PUBLIC_PLUGIN_FAMILIES)
            file(GLOB descriptors CONFIGURE_DEPENDS
                "${CMAKE_CURRENT_SOURCE_DIR}/${family}/plugin.textproto"
                "${CMAKE_CURRENT_SOURCE_DIR}/${family}/*/plugin.textproto"
                "${CMAKE_CURRENT_SOURCE_DIR}/${family}/packages/*/plugin.textproto")
            foreach(descriptor IN LISTS descriptors)
                file(STRINGS "${descriptor}" identity REGEX "^id: ")
                if(identity STREQUAL "id: \"${id}\"")
                    list(APPEND requested "${family}")
                    set(found TRUE)
                endif()
            endforeach()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Unknown plugin ID: ${id}")
        endif()
    endforeach()
elseif(CD_PLUGIN_FAMILIES STREQUAL "ALL")
    set(requested ${CD_PUBLIC_PLUGIN_FAMILIES})
endif()
list(REMOVE_DUPLICATES requested)

function(cd_add_public_family family)
    if(NOT family IN_LIST CD_PUBLIC_PLUGIN_FAMILIES)
        message(FATAL_ERROR "Unknown plugin family: ${family}")
    endif()
    get_property(selected GLOBAL PROPERTY CD_PUBLIC_SELECTED_FAMILIES)
    if(family IN_LIST selected)
        return()
    endif()
    get_property(visiting GLOBAL PROPERTY CD_PUBLIC_VISITING_FAMILIES)
    if(family IN_LIST visiting)
        message(FATAL_ERROR "Plugin dependency cycle at ${family}")
    endif()
    set_property(GLOBAL APPEND PROPERTY CD_PUBLIC_VISITING_FAMILIES "${family}")
    foreach(dependency IN LISTS CD_PLUGIN_DEPENDENCIES_${family})
        cd_add_public_family("${dependency}")
    endforeach()
    if(family STREQUAL "character-chat" AND NOT TARGET cd_character_protocol)
        add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../libraries/character-protocol" character-protocol EXCLUDE_FROM_ALL)
    endif()
    add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/${family}" "${CMAKE_BINARY_DIR}/${family}" EXCLUDE_FROM_ALL)
    set_property(GLOBAL APPEND PROPERTY CD_PUBLIC_SELECTED_FAMILIES "${family}")
    get_property(visiting GLOBAL PROPERTY CD_PUBLIC_VISITING_FAMILIES)
    list(REMOVE_ITEM visiting "${family}")
    set_property(GLOBAL PROPERTY CD_PUBLIC_VISITING_FAMILIES "${visiting}")
endfunction()

foreach(family IN LISTS requested)
    cd_add_public_family("${family}")
endforeach()
get_property(selected GLOBAL PROPERTY CD_PUBLIC_SELECTED_FAMILIES)
set(plugin_ids)
set(plugin_targets)
foreach(family IN LISTS requested)
    get_property(family_targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${family}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS family_targets)
        get_target_property(type ${target} TYPE)
        if(type STREQUAL "MODULE_LIBRARY")
            get_target_property(output ${target} RUNTIME_OUTPUT_DIRECTORY)
            get_filename_component(id "${output}" NAME)
            if(NOT CD_PLUGIN_IDS OR id IN_LIST CD_PLUGIN_IDS)
                list(APPEND plugin_ids "${id}")
                list(APPEND plugin_targets "${target}")
            endif()
        endif()
    endforeach()
endforeach()
foreach(id IN LISTS CD_PLUGIN_IDS)
    if(NOT id IN_LIST plugin_ids)
        message(FATAL_ERROR "Plugin ID is described but has no enabled implementation: ${id}")
    endif()
endforeach()

get_property(all_packages GLOBAL PROPERTY CD_PACKAGE_TARGETS)
set(packages)
set(packaged_ids)
foreach(target IN LISTS all_packages)
    get_target_property(outputs ${target} CD_ASSET_PRODUCTS)
    foreach(output IN LISTS outputs)
        if(output MATCHES "\\.cdpkg$")
            get_filename_component(id "${output}" NAME_WLE)
            if(id IN_LIST plugin_ids)
                list(APPEND packages "${target}")
                list(APPEND packaged_ids "${id}")
            endif()
        endif()
    endforeach()
endforeach()
foreach(id IN LISTS plugin_ids)
    if(NOT id IN_LIST packaged_ids)
        message(FATAL_ERROR "No archive recipe for enabled plugin ${id}; rebuild/install the current SDK")
    endif()
endforeach()
list(REMOVE_DUPLICATES packages)
add_custom_target(cd_public_plugin_packages ALL DEPENDS ${packages})
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/public-selection.txt"
    CONTENT "requested=${requested}\nselected=${selected}\npackages=${packages}\n")
list(SORT plugin_ids)
list(JOIN plugin_ids "\n" id_manifest)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/public-plugin-ids.txt" CONTENT "${id_manifest}\n")
include("${CMAKE_CURRENT_LIST_DIR}/Distribution.cmake")
cd_install_public_distribution(${plugin_targets})
