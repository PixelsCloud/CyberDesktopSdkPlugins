include_guard(GLOBAL)

# Resolve tools and notices from the same SDK as the linked public targets.
function(cd_plugin_sdk_tool alias license_variable)
    if(TARGET CyberDesktopSDK::Tool)
        add_executable(${alias} ALIAS CyberDesktopSDK::Tool)
        set(license "${CyberDesktopSDK_ROOT}/share/cyberdesktop-sdk/LICENSE")
    elseif(TARGET cd_sdk_cli)
        add_executable(${alias} ALIAS cd_sdk_cli)
        get_target_property(sdk_source cd_sdk_cli SOURCE_DIR)
        set(license "${sdk_source}/LICENSE")
    else()
        message(FATAL_ERROR "Build the SDK tools or select an installed SDK containing cd-sdk")
    endif()
    if(NOT EXISTS "${license}")
        message(FATAL_ERROR "The selected SDK is missing its license: ${license}")
    endif()
    set(${license_variable} "${license}" PARENT_SCOPE)
endfunction()

# Resolve notices from the Canvas that actually supplies the linked targets.
function(cd_plugin_canvas_license component output)
    get_target_property(imported CyberCanvas::CyberCanvas IMPORTED)
    if(imported)
        get_filename_component(prefix "${CyberCanvas_DIR}/../../.." ABSOLUTE)
        set(license "${prefix}/share/cybercanvas/third_party/${component}/LICENSE")
    elseif(component STREQUAL "tweeny")
        get_target_property(source CyberCanvas::CyberCanvas SOURCE_DIR)
        set(license "${source}/third_party/tweeny/LICENSE")
    elseif(component STREQUAL "yoga" OR component STREQUAL "box2d")
        find_package(${component} CONFIG REQUIRED)
        set(license "${${component}_DIR}/copyright")
    elseif(component STREQUAL "fastnoiselite")
        find_path(FASTNOISELITE_INCLUDE_DIR FastNoiseLite.h REQUIRED)
        find_file(FASTNOISELITE_LICENSE copyright
            HINTS "${FASTNOISELITE_INCLUDE_DIR}/../share/fastnoiselite" REQUIRED NO_DEFAULT_PATH)
        set(license "${FASTNOISELITE_LICENSE}")
    else()
        message(FATAL_ERROR "Unsupported Canvas notice: ${component}")
    endif()
    if(NOT EXISTS "${license}")
        message(FATAL_ERROR "The selected Canvas is missing its ${component} notice: ${license}")
    endif()
    set(${output} "${license}" PARENT_SCOPE)
endfunction()
