include_guard(GLOBAL)

# Resolve runtime DLLs and shared assets from actual target dependencies, including
# DLLs loaded explicitly by the thin plugin entrypoints. Never scan a build folder
# for arbitrary leftovers from a previously selected family.
function(cd_collect_distribution target)
    if(NOT TARGET "${target}")
        return()
    endif()
    get_property(visited GLOBAL PROPERTY CD_DISTRIBUTION_VISITED)
    if(target IN_LIST visited)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY CD_DISTRIBUTION_VISITED "${target}")
    get_target_property(imported "${target}" IMPORTED)
    get_target_property(type "${target}" TYPE)
    if(type STREQUAL "SHARED_LIBRARY" AND NOT imported)
        set_property(GLOBAL APPEND PROPERTY CD_DISTRIBUTION_RUNTIMES "${target}")
    endif()
    get_target_property(assets "${target}" CD_DISTRIBUTION_ASSETS)
    if(assets)
        set_property(GLOBAL APPEND PROPERTY CD_DISTRIBUTION_ASSET_PATHS ${assets})
    endif()
    foreach(property MANUALLY_ADDED_DEPENDENCIES LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(dependencies "${target}" "${property}")
        foreach(dependency IN LISTS dependencies)
            if(dependency MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
                set(dependency "${CMAKE_MATCH_1}")
            endif()
            cd_collect_distribution("${dependency}")
        endforeach()
    endforeach()
endfunction()

function(cd_install_public_distribution)
    set(default_fonts assets/fonts/SiYuanZhenHei-Heavy assets/fonts/ZQKFreeFont)
    foreach(asset IN LISTS default_fonts)
        if(NOT IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/../${asset}")
            message(FATAL_ERROR "Missing default plugin font: ${asset}")
        endif()
        file(GLOB font_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../${asset}/*")
        foreach(font IN LISTS font_files)
            get_filename_component(name "${font}" NAME)
            configure_file("${font}" "${CMAKE_BINARY_DIR}/${asset}/${name}" COPYONLY)
        endforeach()
    endforeach()
    set(manifest "{\"format\":1,\"layout\":\"plugins/<id> with shared files at distribution root\",\"plugins\":[")
    set(separator "")
    set(all_runtimes)
    set(all_assets)
    foreach(target IN LISTS ARGN)
        get_target_property(output "${target}" RUNTIME_OUTPUT_DIRECTORY)
        get_filename_component(id "${output}" NAME)
        set_property(GLOBAL PROPERTY CD_DISTRIBUTION_VISITED "")
        set_property(GLOBAL PROPERTY CD_DISTRIBUTION_RUNTIMES "")
        set_property(GLOBAL PROPERTY CD_DISTRIBUTION_ASSET_PATHS "")
        cd_collect_distribution("${target}")
        get_property(runtimes GLOBAL PROPERTY CD_DISTRIBUTION_RUNTIMES)
        get_property(assets GLOBAL PROPERTY CD_DISTRIBUTION_ASSET_PATHS)
        list(APPEND assets ${default_fonts})
        list(REMOVE_DUPLICATES runtimes)
        list(REMOVE_DUPLICATES assets)
        list(APPEND all_runtimes ${runtimes})
        list(APPEND all_assets ${assets})
        string(APPEND manifest "${separator}{\"id\":\"${id}\",\"runtimes\":[")
        set(comma "")
        foreach(runtime IN LISTS runtimes)
            string(APPEND manifest "${comma}\"$<TARGET_FILE_NAME:${runtime}>\"")
            set(comma ",")
        endforeach()
        string(APPEND manifest "],\"assets\":[")
        set(comma "")
        foreach(asset IN LISTS assets)
            if(IS_ABSOLUTE "${asset}" OR asset MATCHES "(^|/)\\.\\.(/|$)")
                message(FATAL_ERROR "Distribution asset must remain relative: ${asset}")
            endif()
            string(APPEND manifest "${comma}\"${asset}\"")
            set(comma ",")
        endforeach()
        string(APPEND manifest "]}")
        set(separator ",")
        install(DIRECTORY "${output}" DESTINATION plugins COMPONENT PublicPlugins
            PATTERN "*.pdb" EXCLUDE PATTERN "*.lib" EXCLUDE PATTERN "*.exp" EXCLUDE)
    endforeach()
    string(APPEND manifest "]}\n")
    list(REMOVE_DUPLICATES all_runtimes)
    list(REMOVE_DUPLICATES all_assets)
    foreach(runtime IN LISTS all_runtimes)
        install(FILES "$<TARGET_FILE:${runtime}>" DESTINATION . COMPONENT PublicPlugins)
    endforeach()
    foreach(asset IN LISTS all_assets)
        get_filename_component(parent "${asset}" DIRECTORY)
        install(DIRECTORY "${CMAKE_BINARY_DIR}/${asset}" DESTINATION "${parent}" COMPONENT PublicPlugins)
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/public-distribution.json" CONTENT "${manifest}")
    install(FILES "${CMAKE_BINARY_DIR}/public-distribution.json" DESTINATION . COMPONENT PublicPlugins)
endfunction()
