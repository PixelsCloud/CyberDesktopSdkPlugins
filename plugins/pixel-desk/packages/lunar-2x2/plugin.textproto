id: "com.cyberdesktop.pixeldesk.lunar.2x2"
name: "像素农历 2×2"
version: "1.1.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    cells {}
    cells { a: 1 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
description: "独立像素风外观，奶油白与薄荷绿机框；设置仅影响当前组件。"
settings_page {
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "減少動態" section: "外觀" }
        }
    }
    title: "像素农历设置"
    fields {
        id: "week_start"
        label: "每周开始"
        type: CHOICE
        section: "日历"
        choices {
            value: "monday"
            label: "星期一"
            localized_labels { key: "zh-TW" value: "星期一" }
        }
        choices {
            value: "sunday"
            label: "星期日"
            localized_labels { key: "zh-TW" value: "星期日" }
        }
        text_default: "monday"
        localized {
            key: "en"
            value { label: "Week Starts On" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "每週開始" section: "日曆" }
        }
    }
    fields {
        id: "adjacent_days"
        label: "显示相邻月份"
        type: TOGGLE
        section: "日历"
        bool_default: false
        localized {
            key: "en"
            value { label: "Show Adjacent Months" section: "Calendar" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示相鄰月份" section: "日曆" }
        }
    }
    fields {
        id: "language"
        label: "设置语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Settings language" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "設定語言" section: "外觀" }
        }
    }

    fields { id: "text_color" label: "文字颜色" type: COLOR section: "配色" color_default: 337915647 }
    fields { id: "accent_color" label: "节日强调色" type: COLOR section: "配色" color_default: 3346882815 }
}
preview: "preview.png"
tags: "像素"
tags: "农历"
tags: "日历"

capabilities: IMAGE_SKINS
