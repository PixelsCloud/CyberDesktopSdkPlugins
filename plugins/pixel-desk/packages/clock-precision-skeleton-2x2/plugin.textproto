id: "com.cyberdesktop.pixeldesk.clock.precision.skeleton.2x2"
name: "像素镂空钟 2×2"
version: "1.1.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
description: "独立像素风外观，奶油白与薄荷绿机框；设置仅影响当前组件。"
layouts {
    id: "2x2"
    name: "2×2（宽×高）"
    is_default: true
    allowed_rotations: 0
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 2 max_rows: 2 }
content_padding: 0
preview: "preview.png"
settings_page {
    title: "像素镂空钟"
    description: "只调整当前实例。日期、时区和走时跟随系统；隐藏后停止刷新，恢复时直接校准。"
    fields {
        id: "motion"
        label: "走秒方式"
        type: CHOICE
        text_default: "beat"
        choices {
            value: "sweep"
            label: "流畅扫秒"
            localized_labels { key: "en" value: "Smooth sweep" }
        }
        choices {
            value: "beat"
            label: "每秒八步"
            localized_labels { key: "en" value: "Eight beats per second" }
        }
        choices {
            value: "tick"
            label: "每秒跳动"
            localized_labels { key: "en" value: "One tick per second" }
        }
        localized {
            key: "en"
            value { label: "Seconds motion" }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒针"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds hand" }
        }
    }
    fields {
        id: "background"
        label: "显示表壳"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show case" }
        }
    }
    fields {
        id: "detail"
        label: "显示机械轮系"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show movement" }
        }
    }
    fields {
        id: "animation"
        label: "启用动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态效果"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Pixel Skeleton Clock"
            description: "Settings affect this instance only. Follows system time and time zone; hidden clocks stop callbacks."
        }
    }

    fields { id: "hand_color" label: "时分针颜色" type: COLOR section: "配色" color_default: 4125609471 }
    fields { id: "seconds_color" label: "秒针颜色" type: COLOR section: "配色" color_default: 3346882815 }
}
tags: "像素"
tags: "时钟"

capabilities: IMAGE_SKINS
