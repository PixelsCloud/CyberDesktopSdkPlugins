id: "com.cyberdesktop.pixeldesk.sign.4x1"
name: "像素翻牌招牌 4×1"
version: "1.1.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
description: "十二格独立翻牌，支持自定义文字、完整字符分页和点击切换。"
layouts {
    id: "4x1"
    name: "4×1（宽×高）"
    is_default: true
    allowed_rotations: 0
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
content_padding: 0
preview: "preview.png"
settings_page {
    title: "像素翻牌招牌"
    description: "点击可翻牌。长文字每十二个完整字符分页；每行也可单独成页。静置期间不连续刷新。"
    fields {
        id: "text"
        label: "招牌文字"
        type: TEXT
        text_editor: MULTILINE
        max_length: 512
        text_default: "CyberDesktop"
        localized {
            key: "en"
            value { label: "Sign text" }
        }
    }
    fields {
        id: "interval"
        label: "静置秒数（0 为仅点击翻牌）"
        type: INTEGER
        minimum: 0
        maximum: 60
        step: 1
        integer_default: 5
        localized {
            key: "en"
            value { label: "Rest seconds (0 for manual only)" }
        }
    }
    fields {
        id: "speed"
        label: "翻牌速度"
        type: NUMBER
        minimum: 0.35
        maximum: 2
        step: 0.05
        number_default: 1
        localized {
            key: "en"
            value { label: "Flip speed" }
        }
    }
    fields {
        id: "animation"
        label: "启用机械动画"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable mechanical animation" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态效果"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "background"
        label: "显示金属机框"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Show metal casing" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Mechanical Split-flap Sign"
            description: "Click to flip. Text pages use twelve complete characters; line breaks start another page."
        }
    }
}
tags: "像素"
tags: "文字"
tags: "招牌"

capabilities: IMAGE_SKINS
