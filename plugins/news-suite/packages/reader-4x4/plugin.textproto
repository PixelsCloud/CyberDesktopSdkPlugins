id: "com.cyberdesktop.news.reader.4x4"
name: "资讯阅读 / Daily reader 4×4"
version: "1.0.6"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "4x4"
    name: "4×4（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    cells { b: 2 }
    cells { a: 1 b: 2 }
    cells { a: 2 b: 2 }
    cells { a: 3 b: 2 }
    cells { b: 3 }
    cells { a: 1 b: 3 }
    cells { a: 2 b: 3 }
    cells { a: 3 b: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 16 max_cells: 16 max_columns: 4 max_rows: 4 }
capabilities: CONTENT
description: "全球及中文 RSS / Atom，Hacker News，无需 API Key，收藏与离线缓存。"
settings_page {
    title: "资讯阅读 / Daily reader"
    fields {
        id: "list_mode"
        label: "浏览方式"
        type: CHOICE
        section: "显示"
        choices {
            value: "scroll"
            label: "平滑滚动"
            localized_labels { key: "en" value: "Smooth scrolling" }
            localized_labels { key: "zh-TW" value: "平滑捲動" }
        }
        choices {
            value: "pages"
            label: "分页"
            localized_labels { key: "en" value: "Pages" }
            localized_labels { key: "zh-TW" value: "分頁" }
        }
        text_default: "scroll"
        localized {
            key: "en"
            value { label: "Browse mode" section: "Display" }
        }
        localized {
            key: "zh-TW"
            value { label: "瀏覽方式" section: "顯示" }
        }
    }
    fields {
        id: "source"
        label: "资讯来源"
        type: CHOICE
        section: "数据源"
        choices {
            value: "bbc"
            label: "BBC World"
            localized_labels { key: "zh-TW" value: "BBC World" }
        }
        choices {
            value: "guardian"
            label: "The Guardian"
            localized_labels { key: "zh-TW" value: "The Guardian" }
        }
        choices {
            value: "verge"
            label: "The Verge"
            localized_labels { key: "zh-TW" value: "The Verge" }
        }
        choices {
            value: "ars"
            label: "Ars Technica"
            localized_labels { key: "zh-TW" value: "Ars Technica" }
        }
        choices {
            value: "dw"
            label: "Deutsche Welle · Deutsch"
            localized_labels { key: "zh-TW" value: "Deutsche Welle · Deutsch" }
        }
        choices {
            value: "nhk"
            label: "NHK · 日本語"
            localized_labels { key: "zh-TW" value: "NHK · 日本語" }
        }
        choices {
            value: "ithome"
            label: "IT之家"
            localized_labels { key: "zh-TW" value: "IT之家" }
        }
        choices {
            value: "solidot"
            label: "Solidot"
            localized_labels { key: "zh-TW" value: "Solidot" }
        }
        choices {
            value: "sspai"
            label: "少数派"
            localized_labels { key: "zh-TW" value: "少數派" }
        }
        choices {
            value: "chinanews"
            label: "中国新闻网"
            localized_labels { key: "zh-TW" value: "中國新聞網" }
        }
        choices {
            value: "ruanyifeng"
            label: "阮一峰的网络日志"
            localized_labels { key: "zh-TW" value: "阮一峰的網路日誌" }
        }
        choices {
            value: "hn"
            label: "Hacker News"
            localized_labels { key: "zh-TW" value: "Hacker News" }
        }
        choices {
            value: "custom"
            label: "自定义 RSS / Atom"
            localized_labels { key: "en" value: "Custom" }
            localized_labels { key: "zh-TW" value: "自定義 RSS / Atom" }
        }
        text_default: "bbc"
        localized {
            key: "en"
            value { label: "Source" section: "Sources" }
        }
        localized {
            key: "zh-TW"
            value { label: "資訊來源" section: "資料來源" }
        }
    }
    fields {
        id: "feeds"
        label: "自定义订阅"
        type: TEXT
        description: "每行一个 HTTP(S) 地址，最多 6 个；选择自定义来源后生效。"
        section: "数据源"
        max_length: 4096
        localized {
            key: "en"
            value {
                label: "Feed URLs"
                description: "One HTTP(S) RSS/Atom URL per line, up to six. Select Custom to use these feeds."
                section: "Sources"
            }
        }
        localized {
            key: "zh-TW"
            value {
                label: "自定義訂閱"
                description: "每行一個 HTTP(S) 地址，最多 6 個；選擇自定義來源後生效。"
                section: "資料來源"
            }
        }
        text_editor: MULTILINE
    }
    fields {
        id: "hn_order"
        label: "HN 排序"
        type: CHOICE
        section: "数据源"
        choices {
            value: "top"
            label: "热门"
            localized_labels { key: "en" value: "Top" }
            localized_labels { key: "zh-TW" value: "熱門" }
        }
        choices {
            value: "new"
            label: "最新"
            localized_labels { key: "en" value: "New" }
            localized_labels { key: "zh-TW" value: "最新" }
        }
        choices {
            value: "best"
            label: "精选"
            localized_labels { key: "en" value: "Best" }
            localized_labels { key: "zh-TW" value: "精選" }
        }
        text_default: "top"
        localized {
            key: "en"
            value { label: "HN order" section: "Sources" }
        }
        localized {
            key: "zh-TW"
            value { label: "HN 排序" section: "資料來源" }
        }
    }
    fields {
        id: "refresh_minutes"
        label: "更新间隔"
        type: INTEGER
        section: "数据源"
        minimum: 5.0
        maximum: 180.0
        step: 5.0
        integer_default: 20
        localized {
            key: "en"
            value { label: "Refresh minutes" section: "Sources" }
        }
        localized {
            key: "zh-TW"
            value { label: "更新間隔" section: "資料來源" }
        }
    }
    fields {
        id: "lighting"
        label: "昼夜模式"
        type: CHOICE
        section: "外观"
        choices {
            value: "theme"
            label: "跟随主题"
            localized_labels { key: "en" value: "Follow theme" }
            localized_labels { key: "zh-TW" value: "跟隨主題" }
        }
        choices {
            value: "day"
            label: "白天"
            localized_labels { key: "en" value: "Light" }
            localized_labels { key: "zh-TW" value: "白天" }
        }
        choices {
            value: "night"
            label: "黑夜"
            localized_labels { key: "en" value: "Dark" }
            localized_labels { key: "zh-TW" value: "黑夜" }
        }
        text_default: "theme"
        localized {
            key: "en"
            value { label: "Appearance" section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "晝夜模式" section: "外觀" }
        }
    }
    fields {
        id: "language"
        label: "界面语言"
        type: CHOICE
        description: "新闻保留来源原文，不自动翻译。"
        section: "外观"
        choices {
            value: "auto"
            label: "跟随系统"
            localized_labels { key: "en" value: "System" }
            localized_labels { key: "zh-TW" value: "跟隨系統" }
        }
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "auto"
        localized {
            key: "en"
            value {
                label: "Interface language"
                description: "Stories retain their original language; no automatic translation."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "介面語言" description: "新聞保留來源原文，不自動翻譯。" section: "外觀" }
        }
    }
    fields {
        id: "show_background"
        label: "显示背景"
        type: TOGGLE
        description: "显示本插件绘制的背景，不改变桌面材质。"
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show background"
                description: "Show the background drawn by this plugin; desktop materials are unaffected."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background"
        label: "背景颜色"
        type: COLOR
        description: "纯色背景颜色；线性渐变时作为起点颜色。"
        section: "外观"
        color_default: 3941924863
        localized {
            key: "en"
            value {
                label: "Background color"
                description: "Solid background color, or the start color of a linear gradient."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_fill"
        label: "背景填充"
        type: CHOICE
        description: "选择纯色或线性渐变背景。"
        section: "外观"
        choices {
            value: "solid"
            label: "纯色"
            localized_labels { key: "en" value: "Solid" }
            localized_labels { key: "zh-TW" value: "純色" }
        }
        choices {
            value: "linear"
            label: "线性渐变"
            localized_labels { key: "en" value: "Linear gradient" }
            localized_labels { key: "zh-TW" value: "線性漸層" }
        }
        text_default: "solid"
        localized {
            key: "en"
            value {
                label: "Background fill"
                description: "Choose a solid fill or a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景填滿" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_end"
        label: "渐变终点颜色"
        type: COLOR
        description: "仅在线性渐变背景下生效。"
        section: "外观"
        color_default: 3941924863
        localized {
            key: "en"
            value {
                label: "Gradient end color"
                description: "Used only when the background fill is a linear gradient."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層終點顏色" section: "外觀" }
        }
    }
    fields {
        id: "background_gradient_angle"
        label: "渐变角度（°）"
        type: INTEGER
        description: "仅控制线性渐变方向，不旋转插件内容。"
        section: "外观"
        maximum: 360.0
        step: 1.0
        integer_default: 90
        localized {
            key: "en"
            value {
                label: "Gradient angle (°)"
                description: "Direction of the linear gradient; does not rotate the content."
                section: "Appearance"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "漸層角度（°）" section: "外觀" }
        }
    }
    fields {
        id: "foreground"
        label: "新闻标题颜色"
        type: COLOR
        description: "新闻标题和正文主要文字。"
        section: "外观"
        color_default: 542869759
        localized {
            key: "en"
            value {
                label: "News headline color"
                description: "Headlines and primary article text."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "secondary"
        label: "来源与时间颜色"
        type: COLOR
        description: "新闻来源、时间和辅助信息。"
        section: "外观"
        color_default: 1652529663
        localized {
            key: "en"
            value {
                label: "Source and time color"
                description: "News source, timestamp and supporting information."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "accent"
        label: "选中频道与标签颜色"
        type: COLOR
        description: "频道选中状态、标签和操作控件。"
        section: "外观"
        color_default: 3868870143
        localized {
            key: "en"
            value {
                label: "Selected channel and tag color"
                description: "Selected channels, tags and action controls."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角"
        type: INTEGER
        description: "插件背景的圆角，不改变内容或桌面砖块轮廓。"
        section: "外观"
        maximum: 32.0
        step: 1.0
        integer_default: 12
        localized {
            key: "en"
            value {
                label: "Background corner radius"
                description: "Corner radius of the plugin background, not its content or desktop tile."
                section: "Appearance"
            }
        }
    }
    fields {
        id: "font_family"
        label: "文字字体"
        type: FONT
        description: "用于本插件绘制的文字，不改变图标、图片及点阵结构。"
        section: "外观"
        text_default: "Segoe UI"
        localized {
            key: "en"
            value {
                label: "Text font"
                description: "Font for text drawn by this plugin; icons, images and pixel structures are unchanged."
                section: "Appearance"
            }
        }
    }
    localized {
        key: "en"
        value { title: "Daily reader settings" }
    }
    localized {
        key: "zh-TW"
        value { title: "資訊閱讀 / Daily reader" }
    }
}
content_padding: 6.0
preview: "preview.png"
required_services { id: "content.feeds" version: 1 }
tags: "简约"
tags: "资讯"
