id: "com.cyberdesktop.deepwhale.spectrum.8x1"
name: "Deep鲸 · 柱状频谱"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "8x1"
    name: "8×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    cells { a: 4 }
    cells { a: 5 }
    cells { a: 6 }
    cells { a: 7 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 8 max_rows: 1 }
capabilities: AUDIO_FFT
description: "固定 8×1 格（宽×高），适配长方形和正方形格子；独立设置，局部刷新。"
settings_page {
    title: "音乐频谱 8×1设置"
    description: "每个实例独立保存。选择字体、语言和显示参数。"
    fields { id: "reduced_motion" label: "减少动态" type: TOGGLE }
    fields { id: "color_middle" label: "杆身颜色" type: COLOR color_default: 3572365055 }
    fields { id: "brightness" label: "亮度" type: NUMBER minimum: 30.0 maximum: 100.0 step: 1.0 number_default: 100.0 }
    fields { id: "glow" label: "柔和辉光" type: NUMBER maximum: 40.0 step: 1.0 }
    fields {
        id: "gain"
        label: "灵敏度"
        type: NUMBER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 0.2
        maximum: 5.0
        step: 0.1
        number_default: 3.5
        localized {
            key: "en"
            value { label: "Sensitivity" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "靈敏度" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "release"
        label: "回落时间（ms）"
        type: INTEGER
        description: "只修改当前实例。"
        section: "设置"
        minimum: 40.0
        maximum: 600.0
        step: 10.0
        integer_default: 160
        localized {
            key: "en"
            value { label: "Release (ms)" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "回落時間（ms）" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "peaks"
        label: "显示峰值"
        type: TOGGLE
        description: "只修改当前实例。"
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value { label: "Peak indicators" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示峰值" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "color"
        label: "柱条底色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 1991167999
        localized {
            key: "en"
            value { label: "Bar base color" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "柱條底色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "color_top"
        label: "柱条顶色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 3585640959
        localized {
            key: "en"
            value { label: "Bar top color" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "柱條頂色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "show_background"
        label: "显示主题外壳"
        type: TOGGLE
        description: "显示人物、装饰边框和频谱底色。"
        section: "设置"
        bool_default: true
        localized {
            key: "en"
            value {
                label: "Show themed artwork"
                description: "Show the character, decorative frame and spectrum background."
                section: "Settings"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "顯示主題外殼" description: "顯示人物、裝飾邊框和頻譜底色。" section: "設定" }
        }
    }
    fields {
        id: "background"
        label: "卡片底色"
        type: COLOR
        description: "只修改当前实例。"
        section: "设置"
        color_default: 153777151
        localized {
            key: "en"
            value { label: "Card background" description: "Affects only this instance." section: "Settings" }
        }
        localized {
            key: "zh-TW"
            value { label: "卡片底色" description: "只修改當前例項。" section: "設定" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    localized {
        key: "en"
        value { title: "Widget settings" description: "Settings are saved separately for each instance." }
    }
    localized {
        key: "zh-TW"
        value { title: "音樂頻譜 1×8設定" description: "每個例項獨立儲存。選擇字型、語言和顯示引數。" }
    }
}
content_padding: 0.0
preview: "preview.png"
tags: "Deep鲸"
