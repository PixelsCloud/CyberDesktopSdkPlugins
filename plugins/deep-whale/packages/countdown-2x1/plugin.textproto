id: "com.cyberdesktop.deepwhale.countdown.2x1"
name: "Deep鲸 · 倒数日"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
description: "Countdown; independent settings and partial content updates."
icon: "preview.png"
settings_page {
    title: "倒数日设置"
    description: "单击控件操作；拖动移位不触发点击。每块砖独立保存配置。"
    fields {
        id: "title"
        label: "事件名称"
        type: TEXT
        section: "内容"
        max_length: 128
        text_default: "下个假期"
        localized {
            key: "en"
            value { label: "Event title" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "事件名稱" section: "內容" }
        }
    }
    fields {
        id: "date"
        label: "目标日期（YYYY-MM-DD）"
        type: TEXT
        section: "内容"
        max_length: 10
        text_default: "2027-01-01"
        localized {
            key: "en"
            value { label: "Target date (YYYY-MM-DD)" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "目標日期（YYYY-MM-DD）" section: "內容" }
        }
    }
    fields {
        id: "annual"
        label: "每年重复"
        type: TOGGLE
        section: "内容"
        localized {
            key: "en"
            value { label: "Repeat annually" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "每年重複" section: "內容" }
        }
    }
    fields {
        id: "background_corner_radius"
        label: "背景圆角（px）"
        type: INTEGER
        description: "桌面控件背景的圆角，0 为直角。"
        section: "背景"
        maximum: 32.0
        step: 1.0
        integer_default: 5
        localized {
            key: "en"
            value {
                label: "Background corner radius (px)"
                description: "Corner radius of the desktop widget background; 0 gives square corners."
                section: "Background"
            }
        }
        localized {
            key: "zh-TW"
            value { label: "背景圓角（px）" description: "桌面小工具背景的圓角，0 為直角。" section: "背景" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "内容"
        max_length: 128
        text_default: "Bree Serif"
        localized {
            key: "en"
            value { label: "Font" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "內容" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "内容"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" section: "Content" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "內容" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Countdown settings"
            description: "Click controls to interact. Dragging does not activate a click. Settings are saved per instance."
        }
    }
    localized {
        key: "zh-TW"
        value { title: "倒數日設定" description: "單擊控制元件操作；拖動移位不觸發點選。每塊磚獨立儲存配置。" }
    }
}
preview: "preview.png"

tags: "Deep鲸"
layouts {
    id: "2x1"
    name: "2×1（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 2 max_cells: 2 max_columns: 2 max_rows: 1 }
