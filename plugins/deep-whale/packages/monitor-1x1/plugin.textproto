id: "com.cyberdesktop.deepwhale.monitor.1x1"
name: "Deep鲸 · 系统监控 1×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
capabilities: SYSTEM_INFO
description: "独立的机械系统监控 1×1插件；固定机械样式，无法切换为其他外观。尺寸按列×行计算。"
settings_page {
    fields {
        id: "animate"
        label: "指针过渡"
        type: TOGGLE
        section: "外观"
        bool_default: true
        localized {
            key: "en"
            value { label: "Animate needles" section: "Appearance" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        section: "外观"
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduced motion" section: "Appearance" }
        }
    }
    title: "系统监控设置"
    description: "独立机械插件；设置按实例保存，缺少可靠数据时显示 —。"
    fields {
        id: "interval"
        label: "刷新间隔（ms）"
        type: INTEGER
        section: "采样"
        minimum: 500.0
        maximum: 5000.0
        step: 100.0
        integer_default: 1000
        localized {
            key: "en"
            value { label: "Refresh interval (ms)" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "重新整理間隔（ms）" section: "取樣" }
        }
    }
    fields {
        id: "primary"
        label: "主指标"
        type: CHOICE
        section: "显示"
        choices {
            value: "cpu"
            label: "CPU 占用"
            localized_labels { key: "en" value: "CPU" }
            localized_labels { key: "zh-TW" value: "CPU 佔用" }
        }
        choices {
            value: "ram"
            label: "内存占用"
            localized_labels { key: "en" value: "Memory" }
            localized_labels { key: "zh-TW" value: "記憶體佔用" }
        }
        choices {
            value: "gpu"
            label: "GPU 占用"
            localized_labels { key: "en" value: "GPU" }
            localized_labels { key: "zh-TW" value: "GPU 佔用" }
        }
        choices {
            value: "temperature"
            label: "CPU 温度"
            localized_labels { key: "en" value: "CPU temperature" }
            localized_labels { key: "zh-TW" value: "CPU 溫度" }
        }
        text_default: "cpu"
        localized {
            key: "en"
            value { label: "Primary metric" description: "Affects only this instance." section: "Display" }
        }
        localized {
            key: "zh-TW"
            value { label: "主指標" section: "顯示" }
        }
    }
    fields {
        id: "font_family"
        label: "字体"
        type: FONT
        section: "外观"
        max_length: 128
        text_default: "Bree Serif"
        localized {
            key: "en"
            value { label: "Font" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "字型" section: "外觀" }
        }
    }
    fields {
        id: "language"
        label: "语言"
        type: CHOICE
        section: "外观"
        choices {
            value: "zh-CN"
            label: "简体中文"
            localized_labels { key: "en" value: "简体中文" }
            localized_labels { key: "zh-TW" value: "簡體中文" }
        }
        choices {
            value: "en"
            label: "English"
            localized_labels { key: "en" value: "English" }
            localized_labels { key: "zh-TW" value: "English" }
        }
        choices {
            value: "zh-TW"
            label: "繁體中文"
            localized_labels { key: "en" value: "Traditional Chinese" }
            localized_labels { key: "zh-TW" value: "繁體中文" }
        }
        text_default: "zh-CN"
        localized {
            key: "en"
            value { label: "Language" description: "Affects only this instance." section: "Appearance" }
        }
        localized {
            key: "zh-TW"
            value { label: "語言" section: "外觀" }
        }
    }
    localized {
        key: "en"
        value {
            title: "System monitor settings"
            description: "Settings are saved separately for each instance. Select a font and language below."
        }
    }
    localized {
        key: "zh-TW"
        value {
            title: "系統監控設定"
            description: "只修改當前例項。CPU 溫度缺少可靠資料時顯示 0°C 佔位，其他指標暫無資料時顯示 —。"
        }
    }
}
preview: "preview.png"

tags: "Deep鲸"
layouts {
    id: "1x1"
    name: "1×1（宽×高）"
    cells { a: 0 b: 0 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 1 max_cells: 1 max_columns: 1 max_rows: 1 }
