id: "com.cyberdesktop.deepwhale.spectrum.4x1"
name: "Deep鲸 · 柱状频谱 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
layouts {
    id: "4x1"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
capabilities: AUDIO_FFT
description: "独立机械柱状频谱；连续黄铜升降杆与弹起回落的峰值钢珠，使用系统共享音频。"
settings_page {
    title: "机械频谱设置"
    fields { id: "reduced_motion" label: "减少动态" type: TOGGLE }
    fields { id: "color" label: "侧边颜色" type: COLOR color_default: 1991167999 }
    fields { id: "color_middle" label: "杆身颜色" type: COLOR color_default: 3572365055 }
    fields { id: "color_top" label: "峰值颜色" type: COLOR color_default: 3585640959 }
    fields { id: "brightness" label: "亮度" type: NUMBER minimum: 30.0 maximum: 100.0 step: 1.0 number_default: 100.0 }
    fields { id: "glow" label: "柔和辉光" type: NUMBER maximum: 40.0 step: 1.0 }
    fields { id: "gain" label: "灵敏度" type: NUMBER minimum: 0.2 maximum: 5.0 step: 0.1 number_default: 3.5 }
    fields {
        id: "release"
        label: "回落时间（ms）"
        type: INTEGER
        minimum: 40.0
        maximum: 600.0
        step: 10.0
        integer_default: 160
    }
    fields { id: "peaks" label: "显示峰值" type: TOGGLE bool_default: true }
}
content_padding: 0.0
preview: "preview.png"
required_services { id: "audio.spectrum" version: 1 }
tags: "Deep鲸"
