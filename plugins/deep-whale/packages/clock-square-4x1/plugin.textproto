id: "com.cyberdesktop.deepwhale.clock.square.4x1"
name: "Deep鲸方点阵时钟 4×1"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
content_padding: 0
layouts {
    id: "4x1"
    name: "4×1（宽×高）"
    cells {}
    cells { a: 1 }
    cells { a: 2 }
    cells { a: 3 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 4 max_cells: 4 max_columns: 4 max_rows: 1 }
description: "奶油白与薄荷绿Deep鲸机框，实时方点阵时间；支持独立时区与配色。"
settings_page {
    title: "Deep鲸时钟设置"
    fields {
        id: "format"
        label: "时间制"
        type: CHOICE
        section: "时间"
        choices {
            value: "24"
            label: "24 小时"
            localized_labels { key: "en" value: "24-hour" }
        }
        choices {
            value: "12"
            label: "12 小时"
            localized_labels { key: "en" value: "12-hour" }
        }
        text_default: "24"
        localized {
            key: "en"
            value { label: "Time format" }
        }
    }
    fields {
        id: "timezone"
        label: "时区"
        type: CHOICE
        section: "时间"
        choices {
            value: "local"
            label: "跟随系统"
            localized_labels { key: "en" value: "System" }
        }
        choices {
            value: "utc"
            label: "UTC"
            localized_labels { key: "en" value: "UTC" }
        }
        choices {
            value: "offset"
            label: "自定义偏移"
            localized_labels { key: "en" value: "Custom offset" }
        }
        text_default: "local"
        localized {
            key: "en"
            value { label: "Time zone" }
        }
    }
    fields {
        id: "utc_offset"
        label: "UTC 偏移（分钟）"
        type: INTEGER
        step: 1
        section: "时间"
        minimum: -720
        maximum: 840
        integer_default: 480
        localized {
            key: "en"
            value { label: "UTC offset (minutes)" }
        }
    }
    fields {
        id: "seconds"
        label: "显示秒"
        type: TOGGLE
        section: "时间"
        bool_default: true
        localized {
            key: "en"
            value { label: "Show seconds" }
        }
    }
    fields {
        id: "blink_colon"
        label: "冒号闪烁"
        type: TOGGLE
        section: "时间"
        bool_default: false
        localized {
            key: "en"
            value { label: "Blink colon" }
        }
    }
    fields {
        id: "brightness"
        label: "亮度"
        type: NUMBER
        step: 1
        section: "显示"
        minimum: 30
        maximum: 100
        number_default: 100.0
        localized {
            key: "en"
            value { label: "Brightness" }
        }
    }
    fields {
        id: "glow"
        label: "柔和辉光"
        type: NUMBER
        step: 1
        section: "显示"
        minimum: 0
        maximum: 40
        number_default: 0
        localized {
            key: "en"
            value { label: "Soft glow" }
        }
    }
    fields {
        id: "text_color"
        label: "Deep鲸颜色"
        type: COLOR
        section: "配色"
        color_default: 3605528063
        localized {
            key: "en"
            value { label: "Deep Whale color" section: "Colors" }
        }
    }
    fields {
        id: "seconds_color"
        label: "秒颜色"
        type: COLOR
        section: "配色"
        color_default: 3201758463
        localized {
            key: "en"
            value { label: "Seconds color" section: "Colors" }
        }
    }
}
preview: "preview.png"
tags: "Deep鲸"
tags: "时钟"
