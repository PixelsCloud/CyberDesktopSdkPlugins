id: "com.cyberdesktop.deepwhale.clock.spring.4x2"
name: "Deep鲸弹簧数字时钟 4×2"
version: "1.0.0"
author: "CyberDesktop"
abi_version: 1
entry: "plugin.dll"
description: "独立Deep鲸风外观，瓷白、海蓝玻璃与暖金外观；设置仅影响当前组件。"
layouts {
    id: "2x4"
    name: "4×2（宽×高）"
    cells { a: 0 b: 0 }
    cells { a: 1 b: 0 }
    cells { a: 2 b: 0 }
    cells { a: 3 b: 0 }
    cells { a: 0 b: 1 }
    cells { a: 1 b: 1 }
    cells { a: 2 b: 1 }
    cells { a: 3 b: 1 }
    allowed_rotations: 0
    is_default: true
}
footprint_rules { min_cells: 8 max_cells: 8 max_columns: 4 max_rows: 2 }
settings_page {
    title: "Deep鲸弹簧数字时钟 4×2"
    description: "显示时、分、秒，变化的数字每秒弹动；拖动数字牌，松手自然回弹。Deep鲸零件独立运动，支持暂停和减少动态。"
    fields {
        id: "speed"
        label: "运动速度"
        type: NUMBER
        minimum: 0.25
        maximum: 2
        step: 0.05
        number_default: 0.75
        localized {
            key: "en"
            value { label: "Motion speed" }
        }
    }
    fields {
        id: "running"
        label: "启用摆动"
        type: TOGGLE
        bool_default: true
        localized {
            key: "en"
            value { label: "Enable motion" }
        }
    }
    fields {
        id: "reduced_motion"
        label: "减少动态"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "Reduce motion" }
        }
    }
    fields {
        id: "twelve_hour"
        label: "12 小时制"
        type: TOGGLE
        bool_default: false
        localized {
            key: "en"
            value { label: "12-hour time" }
        }
    }
    localized {
        key: "en"
        value {
            title: "Deep Whale Spring Clock 4x2"
            description: "HH:MM:SS with a bounce each second. Drag and release a digit card. Motion pauses while hidden."
        }
    }

    fields { id: "text_color" label: "数字颜色" type: COLOR section: "配色" color_default: 1062963711 }
    fields { id: "accent_color" label: "弹簧颜色" type: COLOR section: "配色" color_default: 3215293951 }
}
content_padding: 0
preview: "preview.png"
tags: "Deep鲸"
tags: "时钟"
tags: "互动"
